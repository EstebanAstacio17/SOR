@{
    Layout = null;
}

<!doctype html>
<html lang="es" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Registro de voluntarios y líderes - Sistema de Operaciones y Recursos (SOR) OCC República Dominicana." />
    
    <title>Registro | SOR OCC República Dominicana</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/favicon.ico" />

    <!-- Bootstrap 5 (local) -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS propio -->
    <link href="~/Content/css/Login.css" rel="stylesheet" />
</head>

<body class="d-flex align-items-center py-4 bg-body-tertiary">

    <main class="form-signin w-100 m-auto">

        <form action="@Url.Action("Registrar", "Acceso")" method="post" onsubmit="sessionStorage.setItem('user_tab_session', 'active');">
            @Html.AntiForgeryToken()

            <!-- CAMPO TRAMPA ANTI-BOT (HONEYPOT) - Invisible para humanos -->
            <div style="position: absolute; left: -9999px; top: -9999px; width: 0; height: 0; opacity: 0; pointer-events: none;" aria-hidden="true">
                <label for="website_trap">Leave this field blank</label>
                <input type="text" id="website_trap" name="website_trap" tabindex="-1" autocomplete="off" value="" />
                <input type="hidden" name="form_time_token" value="@(ViewBag.FormTimeToken ?? DateTime.UtcNow.Ticks.ToString())" />
            </div>

            <!-- LOGO -->
            <div class="text-center mb-2">
                <img src="~/Content/css/Imgs/OCC-logo.png"
                     class="logo-login"
                     alt="Logo Oficial Operation Christmas Child República Dominicana">
            </div>

            <!-- TITULO -->
            <h1 class="h3 mb-1 fw-bold text-center">
                Registrarme
            </h1>
            <p class="text-secondary small text-center mb-3">
                Creación de cuenta para nuevos miembros y coordinadores
            </p>

            <!-- CORREO -->
            <div class="form-floating mb-2">
                <input type="email"
                       name="Correo"
                       class="form-control"
                       id="floatingInput"
                       placeholder="correo@ejemplo.com"
                       required
                       autocomplete="email">
                <label for="floatingInput">
                    Correo electrónico
                </label>
            </div>

            <!-- CONTRASEÑA -->
            <div class="form-floating mb-2">
                <input type="password"
                       name="Clave"
                       class="form-control"
                       id="floatingPassword"
                       placeholder="Contraseña"
                       required
                       autocomplete="new-password">
                <label for="floatingPassword">
                    Contraseña (mínimo 6 caracteres)
                </label>
            </div>

            <!-- CONFIRMAR CONTRASEÑA -->
            <div class="form-floating mb-2">
                <input type="password"
                       name="ConfirmarClave"
                       class="form-control"
                       id="floatingPasswordConfirm"
                       placeholder="Confirmar Contraseña"
                       required
                       autocomplete="new-password">
                <label for="floatingPasswordConfirm">
                    Confirmar Contraseña
                </label>
            </div>

            <!-- MENSAJE DEL CONTROLADOR -->
            @if (ViewData["Mensaje"] != null)
            {
                var alertClass = ViewData["TipoAlert"] != null ? ViewData["TipoAlert"].ToString() : "alert-danger";
                <div class="alert @alertClass mt-3 py-2 small">
                    <i class="bi bi-info-circle me-1"></i> @ViewData["Mensaje"]
                </div>
            }

            <!-- BOTON -->
            <button class="btn btn-primary w-100 py-2 mt-3 fw-semibold"
                    type="submit">
                <i class="bi bi-person-plus me-1"></i> Registrarse
            </button>

            <!-- INICIO DE SESION -->
            <div class="text-center mt-3">
                <span class="text-body-secondary small">
                    ¿Ya estás registrado?
                </span>
                <a href="@Url.Action("Login","Acceso")" class="small fw-semibold text-decoration-none ms-1">
                    Iniciar Sesión
                </a>
            </div>

            <hr class="my-4 opacity-25" />

            <!-- ENLACES LEGALES Y TRANSPARENCIA INSTITUCIONAL -->
            <div class="text-center small text-muted mb-2">
                <a href="@Url.Action("Privacidad", "Home")" class="text-secondary text-decoration-none me-2">Privacidad</a>
                &bull;
                <a href="@Url.Action("Terminos", "Home")" class="text-secondary text-decoration-none mx-2">Términos</a>
                &bull;
                <a href="@Url.Action("Contact", "Home")" class="text-secondary text-decoration-none ms-2">Contacto</a>
            </div>

            <p class="mb-0 text-body-secondary text-center small">
                &copy; @DateTime.Now.Year - Operation Christmas Child Rep. Dom.
            </p>
        </form>

    </main>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</body>

</html>