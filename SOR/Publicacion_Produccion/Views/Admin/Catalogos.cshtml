@{
    ViewBag.Title = "Mantenedor de Catálogos del Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var denominaciones = (List<SOR.Controllers.CatalogoItemViewModel>)ViewBag.Denominaciones ?? new List<SOR.Controllers.CatalogoItemViewModel>();
    var tiposOrg = (List<SOR.Controllers.CatalogoItemViewModel>)ViewBag.TiposOrg ?? new List<SOR.Controllers.CatalogoItemViewModel>();
    var rolesEvento = (List<SOR.Controllers.CatalogoItemViewModel>)ViewBag.RolesEvento ?? new List<SOR.Controllers.CatalogoItemViewModel>();
    var materiales = (List<SOR.Controllers.CatalogoItemViewModel>)ViewBag.Materiales ?? new List<SOR.Controllers.CatalogoItemViewModel>();
    var tiposEmpaque = (List<SOR.Controllers.CatalogoItemViewModel>)ViewBag.TiposEmpaque ?? new List<SOR.Controllers.CatalogoItemViewModel>();
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h3 font-bold text-slate-800 mb-1"><i class="bi bi-tags-fill text-primary me-2"></i>Mantenedor de Catálogos</h2>
        <p class="text-muted mb-0">Administra las opciones de Denominaciones, Tipos de Organización, Roles de Eventos, Materiales y Tipos de Empaque del sistema.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- PANEL 1: DENOMINACIONES -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                <h5 class="card-title font-bold mb-0"><i class="bi bi-building me-2 text-info"></i>Denominaciones</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearDenominacion">
                    <i class="bi bi-plus-circle me-1"></i>Agregar
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Denominación</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!denominaciones.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No hay denominaciones registradas.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in denominaciones)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-slate-800">@item.Nombre</td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success-soft text-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <form action="@Url.Action("ToggleDenominacion", "Admin")" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                    @(item.Activo ? "Inhabilitar" : "Habilitar")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL 2: TIPOS DE ORGANIZACIÓN -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between">
                <h5 class="card-title font-bold mb-0"><i class="bi bi-diagram-3 me-2 text-warning"></i>Tipos de Organización</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearTipoOrg">
                    <i class="bi bi-plus-circle me-1"></i>Agregar
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tipo</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!tiposOrg.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No hay tipos registrados.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in tiposOrg)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-slate-800">@item.Nombre</td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success-soft text-success">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger">Inactivo</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <form action="@Url.Action("ToggleTipoOrg", "Admin")" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                    @(item.Activo ? "Inhabilitar" : "Habilitar")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PANEL 3: ROLES Y FUNCIONES EN EVENTOS -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="card-title font-bold mb-0">
                        <i class="bi bi-person-workspace me-2 text-primary"></i>Roles y Funciones en Eventos
                    </h5>
                    <small class="text-slate-300">Opciones desplegables asignables a coordinadores y voluntarios en el registro de eventos.</small>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearRolEvento">
                    <i class="bi bi-plus-circle me-1"></i>Agregar Rol / Función
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Rol / Función</th>
                                <th>Descripción / Alcance</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!rolesEvento.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay roles de eventos configurados.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in rolesEvento)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-slate-800">
                                            <i class="bi bi-person-badge text-primary me-1"></i>@item.Nombre
                                        </td>
                                        <td>
                                            <span class="text-slate-600 small">@(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)</span>
                                        </td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill">Activo / Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill">Inhabilitado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="abrirModalEditarRolEvento(@item.Id, '@Html.Raw(item.Nombre.Replace("'", "\\'"))', '@Html.Raw((item.Descripcion ?? "").Replace("'", "\\'"))')" title="Editar Rol">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="@Url.Action("ToggleRolEvento", "Admin")" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                        @(item.Activo ? "Inhabilitar" : "Habilitar")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PANEL 4: CATÁLOGO DE MATERIALES Y SUMINISTROS -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="card-title font-bold mb-0">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Catálogo de Materiales y Suministros
                    </h5>
                    <small class="text-slate-300">Define los materiales base disponibles para recepción de contenedores, transferencias y presentaciones de empaque.</small>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearMaterial">
                    <i class="bi bi-plus-circle me-1"></i>Agregar Material
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Código</th>
                                <th>Nombre del Material</th>
                                <th>Unidad de Entrega</th>
                                <th>Momento de Entrega</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!materiales.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No hay materiales registrados en el catálogo.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in materiales)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-light text-slate-700 border font-monospace px-2 py-1">@item.Codigo</span>
                                        </td>
                                        <td class="fw-bold text-slate-800">
                                            @item.Nombre
                                        </td>
                                        <td>
                                            <span class="badge bg-info-soft text-info">@item.UnidadEntrega</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-soft text-secondary">@item.MomentoEntrega</span>
                                        </td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill">Activo / Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill">Inhabilitado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="abrirModalEditarMaterial(@item.Id, '@Html.Raw(item.Codigo.Replace("'", "\\'"))', '@Html.Raw(item.Nombre.Replace("'", "\\'"))', '@Html.Raw(item.UnidadEntrega.Replace("'", "\\'"))', '@Html.Raw(item.MomentoEntrega.Replace("'", "\\'"))')" title="Editar Material">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="@Url.Action("ToggleMaterial", "Admin")" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                        @(item.Activo ? "Inhabilitar" : "Habilitar")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CREAR DENOMINACION -->
<div class="modal fade text-start" id="modalCrearDenominacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CrearDenominacion", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-plus-circle me-2 text-primary"></i>Nueva Denominación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="form-label fw-semibold">Nombre de la Denominación <span class="text-danger">*</span></label>
                    <input type="text" name="nombre" class="form-control" placeholder="Ej: Bautista Fundamental" required />
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Guardar Denominación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CREAR TIPO ORG -->
<div class="modal fade text-start" id="modalCrearTipoOrg" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CrearTipoOrg", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuevo Tipo de Organización</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="form-label fw-semibold">Nombre del Tipo <span class="text-danger">*</span></label>
                    <input type="text" name="nombre" class="form-control" placeholder="Ej: Fundación Comunitaria" required />
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Guardar Tipo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CREAR ROL EVENTO -->
<div class="modal fade text-start" id="modalCrearRolEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CrearRolEvento", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuevo Rol / Función en Evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del Rol / Función <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Registro y Asistencia" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción / Responsabilidad (Opcional)</label>
                        <textarea name="descripcion" class="form-control" rows="2" placeholder="Ej: Atención de mesa, validación de cédulas y entrega de gafetes"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Guardar Rol</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR ROL EVENTO -->
<div class="modal fade text-start" id="modalEditarRolEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("EditarRolEvento", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editarRolEventoId" value="0" />
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Rol / Función en Evento</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del Rol / Función <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" id="editarRolEventoNombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción / Responsabilidad</label>
                        <textarea name="descripcion" id="editarRolEventoDescripcion" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Actualizar Rol</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CREAR MATERIAL -->
<div class="modal fade text-start" id="modalCrearMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CrearMaterial", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-box-seam me-2 text-primary"></i>Nuevo Material / Suministro</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold">Código <span class="text-danger">*</span></label>
                            <input type="text" name="codigo" class="form-control text-uppercase" placeholder="Ej: MAT-CJA" required />
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label fw-semibold">Nombre del Material <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Cajas de Regalo (Shoeboxes)" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Unidad de Entrega <span class="text-danger">*</span></label>
                            <input type="text" name="unidadEntrega" class="form-control" placeholder="Ej: Caja, Folleto, Guía" value="Unidad" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Momento de Entrega <span class="text-danger">*</span></label>
                            <select name="momentoEntrega" class="form-select" required>
                                <option value="Taller">Taller (Capacitación)</option>
                                <option value="Despacho">Despacho (Distribución)</option>
                                <option value="Ambos">Ambos (Taller y Despacho)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Guardar Material</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR MATERIAL -->
<div class="modal fade text-start" id="modalEditarMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("EditarMaterial", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editarMaterialId" value="0" />
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Material / Suministro</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-sm-4">
                            <label class="form-label fw-semibold">Código <span class="text-danger">*</span></label>
                            <input type="text" name="codigo" id="editarMaterialCodigo" class="form-control text-uppercase" required />
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label fw-semibold">Nombre del Material <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" id="editarMaterialNombre" class="form-control" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Unidad de Entrega <span class="text-danger">*</span></label>
                            <input type="text" name="unidadEntrega" id="editarMaterialUnidad" class="form-control" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label fw-semibold">Momento de Entrega <span class="text-danger">*</span></label>
                            <select name="momentoEntrega" id="editarMaterialMomento" class="form-select" required>
                                <option value="Taller">Taller (Capacitación)</option>
                                <option value="Despacho">Despacho (Distribución)</option>
                                <option value="Ambos">Ambos (Taller y Despacho)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Actualizar Material</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- PANEL 5: CATÁLOGO DE TIPOS DE EMPAQUE -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white p-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h5 class="card-title font-bold mb-0">
                        <i class="bi bi-box me-2 text-warning"></i>Catálogo de Tipos de Empaque y Embalaje
                    </h5>
                    <small class="text-slate-300">Configura las opciones de embalaje (Caja, Paquete, Bolsa, Rollo, etc.) disponibles al registrar presentaciones de materiales.</small>
                </div>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearTipoEmpaque">
                    <i class="bi bi-plus-circle me-1"></i>Agregar Tipo de Empaque
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Tipo de Empaque</th>
                                <th>Descripción / Uso Sugerido</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!tiposEmpaque.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay tipos de empaque configurados.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in tiposEmpaque)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-slate-800">
                                            <i class="bi bi-box-seam text-primary me-2"></i>@item.Nombre
                                        </td>
                                        <td>
                                            <span class="text-slate-600 small">@(string.IsNullOrEmpty(item.Descripcion) ? "Sin descripción" : item.Descripcion)</span>
                                        </td>
                                        <td>
                                            @if (item.Activo)
                                            {
                                                <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill">Activo / Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill">Inhabilitado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex align-items-center justify-content-end gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="abrirModalEditarTipoEmpaque(@item.Id, '@Html.Raw(item.Nombre.Replace("'", "\\'"))', '@Html.Raw((item.Descripcion ?? "").Replace("'", "\\'"))')" title="Editar Tipo de Empaque">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="@Url.Action("ToggleTipoEmpaque", "Admin")" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="activo" value="@(item.Activo ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                        @(item.Activo ? "Inhabilitar" : "Habilitar")
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CREAR TIPO EMPAQUE -->
<div class="modal fade text-start" id="modalCrearTipoEmpaque" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CrearTipoEmpaque", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-box me-2 text-primary"></i>Nuevo Tipo de Empaque</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del Tipo de Empaque <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Caja Master, Fardo, Tarima, Paquete 50" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción / Uso (Opcional)</label>
                        <textarea name="descripcion" class="form-control" rows="2" placeholder="Ej: Contenedor corrugado de alta resistencia para transporte pesado"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Guardar Tipo de Empaque</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDITAR TIPO EMPAQUE -->
<div class="modal fade text-start" id="modalEditarTipoEmpaque" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("EditarTipoEmpaque", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editarTipoEmpaqueId" value="0" />
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar Tipo de Empaque</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del Tipo de Empaque <span class="text-danger">*</span></label>
                        <input type="text" name="nombre" id="editarTipoEmpaqueNombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción / Uso</label>
                        <textarea name="descripcion" id="editarTipoEmpaqueDescripcion" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary font-semibold">Actualizar Tipo de Empaque</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function abrirModalEditarRolEvento(id, nombre, descripcion) {
        document.getElementById('editarRolEventoId').value = id;
        document.getElementById('editarRolEventoNombre').value = nombre;
        document.getElementById('editarRolEventoDescripcion').value = descripcion;
        new bootstrap.Modal(document.getElementById('modalEditarRolEvento')).show();
    }

    function abrirModalEditarMaterial(id, codigo, nombre, unidad, momento) {
        document.getElementById('editarMaterialId').value = id;
        document.getElementById('editarMaterialCodigo').value = codigo;
        document.getElementById('editarMaterialNombre').value = nombre;
        document.getElementById('editarMaterialUnidad').value = unidad;
        document.getElementById('editarMaterialMomento').value = momento;
        new bootstrap.Modal(document.getElementById('modalEditarMaterial')).show();
    }

    function abrirModalEditarTipoEmpaque(id, nombre, descripcion) {
        document.getElementById('editarTipoEmpaqueId').value = id;
        document.getElementById('editarTipoEmpaqueNombre').value = nombre;
        document.getElementById('editarTipoEmpaqueDescripcion').value = descripcion;
        new bootstrap.Modal(document.getElementById('modalEditarTipoEmpaque')).show();
    }
</script>

