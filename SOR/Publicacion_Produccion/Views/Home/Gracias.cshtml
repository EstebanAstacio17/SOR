@{
    ViewBag.Title = "¡Muchas Gracias! | SOR OCC";
    string tipo = ViewBag.Tipo as string ?? "General";
}

<div class="container py-5 my-md-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 24px; background: #ffffff;">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle mb-3" style="width: 85px; height: 85px; font-size: 2.5rem;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <h1 class="h2 fw-bold text-dark mb-2">¡Solicitud Procesada con Éxito!</h1>
                    <p class="text-secondary lead" style="font-size: 1.05rem;">
                        @if (tipo == "Voluntario")
                        {
                            <span>Tu solicitud de voluntariado ha sido recibida correctamente por el equipo de OCC República Dominicana. Nos pondremos en contacto contigo a la brevedad.</span>
                        }
                        else if (tipo == "Contacto")
                        {
                            <span>Hemos recibido tu mensaje. Un miembro de nuestro equipo técnico o administrativo se comunicará contigo pronto.</span>
                        }
                        else
                        {
                            <span>La información ha sido registrada de forma segura en el sistema. Agradecemos tu compromiso y dedicación con el ministerio.</span>
                        }
                    </p>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-3">
                    @if (Session["usuario"] != null)
                    {
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-speedometer2 me-2"></i>Ir al Panel
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Landing", "Home")" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-house me-2"></i>Volver al Inicio
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
