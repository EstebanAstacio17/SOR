@{
    ViewBag.Title = "404 - Página No Encontrada | SOR";
}

<div class="container py-5 my-md-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 24px; background: #ffffff;">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light text-primary rounded-circle mb-3" style="width: 90px; height: 90px; font-size: 2.75rem;">
                        <i class="bi bi-compass"></i>
                    </div>
                    <h1 class="display-4 fw-bold text-dark mb-2 tracking-tight">404</h1>
                    <h2 class="h4 fw-semibold text-secondary mb-3">Página no encontrada</h2>
                    <p class="text-muted mb-4 lead" style="font-size: 1rem;">
                        El recurso o la página que buscas no existe, ha sido movida o la ruta especificada es incorrecta.
                    </p>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                    @if (Session["usuario"] != null)
                    {
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-house-door me-2"></i>Ir al Panel Principal
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Landing", "Home")" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                            <i class="bi bi-house me-2"></i>Ir al Inicio
                        </a>
                        <a href="@Url.Action("Login", "Acceso")" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
                        </a>
                    }
                </div>

                <hr class="my-4 text-muted opacity-25" />
                <div class="small text-muted">
                    ¿Crees que se trata de un error del sistema? <a href="@Url.Action("Contact", "Home")" class="text-primary text-decoration-none fw-medium">Contactar a Soporte</a>
                </div>
            </div>
        </div>
    </div>
</div>
