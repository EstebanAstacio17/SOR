                        <!-- Confirmación de Datos del Pastor -->
                        <div class="card border border-slate-200 rounded-3 mb-3 bg-light">
                            <div class="card-header bg-secondary text-white py-2 font-bold small"><i class="bi bi-person-badge me-1"></i>Confirmar Datos del Pastor</div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Nombres <span class="text-danger">*</span></label>
                                        <input type="text" name="pastor.Nombres" class="form-control form-control-sm" value="@(Model.Pastor != null ? Model.Pastor.Nombres : "")" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                        <input type="text" name="pastor.Apellidos" class="form-control form-control-sm" value="@(Model.Pastor != null ? Model.Pastor.Apellidos : "")" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Cédula <span class="text-danger">*</span></label>
