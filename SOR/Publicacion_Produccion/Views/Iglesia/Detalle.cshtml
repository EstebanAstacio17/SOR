    .bg-primary-soft {
        background-color: rgba(13, 110, 253, 0.1) !important;
        color: #0d6efd !important;
    }
    .badge.bg-warning-soft {
        background-color: rgba(255, 193, 7, 0.15) !important;
        color: #b45309 !important;
    }
    .badge.bg-danger-soft {
        background-color: rgba(220, 53, 69, 0.15) !important;
        color: #dc3545 !important;
    }
</style>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function() {
        // Restaurar pestaña activa anterior
        var iglesiaId = '@Model.IdIglesia';
        var storedTabId = localStorage.getItem('activeIglesiaTab_' + iglesiaId);
        if (storedTabId) {
            var tabBtn = document.getElementById(storedTabId);
            if (tabBtn) {
                var tab = new bootstrap.Tab(tabBtn);
                tab.show();
            }
        }

        // Guardar pestaña seleccionada
        var tabElements = document.querySelectorAll('#tabExpediente button[data-bs-toggle="tab"]');
        tabElements.forEach(function(el) {
            el.addEventListener('shown.bs.tab', function(e) {
                localStorage.setItem('activeIglesiaTab_' + iglesiaId, e.target.id);
            });
        });

        // Manejador AJAX para registro de maestro
        $('#formRegistrarMaestroAjax').on('submit', function(e) {
            e.preventDefault();
            var $btn = $(this).find('button[type="submit"]');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Registrando...');
            
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        var modalEl = document.getElementById('modalRegistrarMaestroFicha');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        location.reload();
                    } else {
                        alert(response.message);
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function() {
                    alert('Ocurrió un error al procesar el registro del maestro.');
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // AJAX verification for Pastor, Líder, and Maestro uniqueness in Detalle.cshtml
        $(document).on('change', 'input[name="pastor.DocumentoIdentidad"], input[name="lider.DocumentoIdentidad"], #formRegistrarMaestroAjax input[name="documentoIdentidad"]', function() {
            var val = $(this).val();
            if (!val) return;
            var $input = $(this);
            $.getJSON('@Url.Action("VerificarUnicidadPersona", "Iglesia")', { cedula: val }, function(response) {
                if (response.existe) {
                    alert('ADVERTENCIA: El ' + (response.rol === 'Lider' ? 'Líder discipulado' : 'Maestro') + ' con la identificación ' + val + ' ya está registrado en la iglesia "' + response.iglesia + '", zona/equipo "' + response.equipo + '" (' + response.nivel + ').');
                }
            });
        });
    });

    // Función para abrir el modal de edición de contactos LGA
    function abrirModalEditarContacto(num, fase, agenda, pregunta, lbl1, val1, lbl2, val2, lbl3, val3, decision, comentario, estado) {
        document.getElementById('modalContactoLgaNumero').value = num;
        document.getElementById('modalContactoLgaNombreFase').value = fase;
        document.getElementById('modalContactoLgaPregunta').value = pregunta;
        document.getElementById('modalContactoLgaTitulo').textContent = 'Contacto #' + num + ': ' + fase + ' (' + agenda + ')';
        document.getElementById('modalContactoLgaPreguntaTexto').textContent = pregunta;

        // Dato 1
        var g1 = document.getElementById('grupoDatoMinimo1');
        var l1 = document.getElementById('lblDatoMinimo1');
        var i1 = document.getElementById('inputDatoMinimo1');
        if (lbl1 && lbl1.trim().length > 0) {
            g1.style.display = 'block';
            l1.textContent = lbl1;
            i1.value = val1 || '';
        } else {
            g1.style.display = 'none';
        }

        // Dato 2
        var g2 = document.getElementById('grupoDatoMinimo2');
        var l2 = document.getElementById('lblDatoMinimo2');
        var i2 = document.getElementById('inputDatoMinimo2');
        if (lbl2 && lbl2.trim().length > 0) {
            g2.style.display = 'block';
            l2.textContent = lbl2;
            i2.value = val2 || '';
        } else {
            g2.style.display = 'none';
        }

        // Dato 3
        var g3 = document.getElementById('grupoDatoMinimo3');
        var l3 = document.getElementById('lblDatoMinimo3');
        var i3 = document.getElementById('inputDatoMinimo3');
        if (lbl3 && lbl3.trim().length > 0) {
            g3.style.display = 'block';
            l3.textContent = lbl3;
            i3.value = val3 || '';
        } else {
            g3.style.display = 'none';
        }

        document.getElementById('inputDecisionTomada').value = decision || '';
        document.getElementById('textareaComentarioAccion').value = comentario || '';
        document.getElementById('selectEstadoContacto').value = estado || 'COMPLETADO';

        var modalEl = document.getElementById('modalEditarContactoLGA');
        if (modalEl) {
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }
</script>
