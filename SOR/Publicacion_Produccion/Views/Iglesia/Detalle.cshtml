                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios Adicionales</label>
                            <textarea name="comentario" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger font-semibold">Confirmar Rechazo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 3: REGISTRAR PRESENTACIÓN DE LA VISIÓN -->
    <!-- MODAL 3: ASIGNAR PRESENTACIÓN DE LA VISIÓN -->
    <div class="modal fade" id="modalAsignarVision" tabindex="-1" aria-hidden="true">
