                        <!-- Confirmación de Datos del Líder Ministerial -->
                        <div class="card border border-slate-200 rounded-3 bg-light">
                            <div class="card-header bg-dark text-white py-2 font-bold small"><i class="bi bi-person-workspace me-1"></i>Confirmar Datos del Líder Ministerial</div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Nombres <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Nombres" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Nombres : "")" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Apellidos" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Apellidos : "")" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Cédula <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.DocumentoIdentidad" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.DocumentoIdentidad : "")" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Celular <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Celular" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Celular : "")" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Correo <span class="text-danger">*</span></label>
                                        <input type="email" name="lider.Correo" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Correo : "")" required placeholder="lider@ejemplo.com" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Confirmar Datos y Asignar Evento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            var selResultado = document.querySelector('select[name="resultado"]');
            var divTaller = document.getElementById('divEventoTaller');
            var ddlTaller = document.getElementById('ddlEventoTaller');
            var chkAsistio = document.getElementById('chkAsistio');

            function toggleTaller() {
                if (selResultado && selResultado.value === "Continua") {
                    if (divTaller) divTaller.style.display = "block";
                    if (ddlTaller) ddlTaller.required = true;
                    if (chkAsistio) {
                        chkAsistio.checked = true;
                    }
                } else {
                    if (divTaller) divTaller.style.display = "none";
                    if (ddlTaller) {
                        ddlTaller.required = false;
                        ddlTaller.value = "";
                    }
                }
            }

            if (selResultado) {
                selResultado.addEventListener("change", toggleTaller);
            }
        });

        function generarFilasMaestrosElegibilidad(cantidad) {
            var cont = document.getElementById('contenedorMaestrosElegibilidad');
            if (!cont) return;
            var cant = parseInt(cantidad) || 1;
            if (cant < 1) cant = 1;
            if (cant > 20) cant = 20;

            var html = '';
            for (var i = 0; i < cant; i++) {
                html += `
                    <div class="card bg-light border p-2 rounded-3 item-maestro-eleg">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Nombres Maestro ${i + 1} <span class="text-danger">*</span></label>
                                <input type="text" name="maestrosNuevos[${i}].Nombres" class="form-control form-control-sm" required placeholder="Ej: Maestro ${i + 1}" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                <input type="text" name="maestrosNuevos[${i}].Apellidos" class="form-control form-control-sm" required placeholder="Ej: Apellido" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Cédula / Identidad</label>
                                <input type="text" name="maestrosNuevos[${i}].DocumentoIdentidad" class="form-control form-control-sm" placeholder="001-0000000-0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Celular</label>
                                <input type="text" name="maestrosNuevos[${i}].Celular" class="form-control form-control-sm" placeholder="809-555-1234" />
                            </div>
                        </div>
                    </div>
                `;
            }
            cont.innerHTML = html;
        }
    </script>

    <!-- MODAL 4.A: APROBAR ELEGIBILIDAD TALLER OCC -->
    <div class="modal fade" id="modalAprobarElegibilidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("EvaluarTallerOCC", "Iglesia")" method="post">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    <input type="hidden" name="estado" value="Aprobada para Taller OCC" />

                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-check-circle me-2 text-success"></i>Aprobar Elegibilidad para Taller OCC</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Evento de Taller OCC al que se asignará <span class="text-danger">*</span></label>
                            <select name="idEventoTaller" class="form-select" required>
                                <option value="">-- Seleccione un Taller OCC --</option>
                                @foreach (var ev in (List<SelectListItem>)ViewBag.EventosTaller)
                                {
                                    <option value="@ev.Value">@ev.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cantidad de Maestros Asistentes Previstos <span class="text-danger">*</span></label>
                            <input type="number" name="cantidadAsistentes" id="cantMaestrosElegibilidad" class="form-control" min="1" value="@(Model.Maestros.Any() ? Model.Maestros.Count.ToString() : "1")" required placeholder="Ej: 3" onchange="generarFilasMaestrosElegibilidad(this.value)" />
                        </div>

                        @if (!Model.Maestros.Any())
                        {
                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Esta iglesia no tiene maestros registrados. Ingresa a continuación los datos de los maestros para crearlos y asignarlos al taller:
                            </div>
                            <div id="contenedorMaestrosElegibilidad" class="d-flex flex-column gap-2 mb-3">
                                <div class="card bg-light border p-2 rounded-3 item-maestro-eleg">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Nombres Maestro 1 <span class="text-danger">*</span></label>
                                            <input type="text" name="maestrosNuevos[0].Nombres" class="form-control form-control-sm" required placeholder="Ej: Juan" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                            <input type="text" name="maestrosNuevos[0].Apellidos" class="form-control form-control-sm" required placeholder="Ej: Pérez" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Cédula / Identidad</label>
                                            <input type="text" name="maestrosNuevos[0].DocumentoIdentidad" class="form-control form-control-sm" placeholder="001-0000000-0" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Celular</label>
                                            <input type="text" name="maestrosNuevos[0].Celular" class="form-control form-control-sm" placeholder="809-555-1234" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios / Observaciones de Elegibilidad</label>
                            <textarea name="comentario" class="form-control" rows="2" placeholder="Ingresa notas o comentarios de la evaluación..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success font-semibold">Aprobar y Habilitar Taller</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 4.B: RECHAZAR ELEGIBILIDAD TALLER OCC -->
    <div class="modal fade" id="modalRechazarElegibilidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("EvaluarTallerOCC", "Iglesia")" method="post">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    <input type="hidden" name="estado" value="No Aprobada" />

                    <div class="modal-header bg-danger text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-x-octagon me-2"></i>No Aprobar Elegibilidad para Taller</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Motivo de Rechazo de Elegibilidad (Obligatorio)</label>
                            <input type="text" name="motivo" class="form-control" placeholder="Ej: Falta de compromiso con el discipulado" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios Adicionales</label>
                            <textarea name="comentario" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger font-semibold">Confirmar Rechazo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 5: REGISTRAR TALLER Y ASIGNAR MATERIALES PARA DESPACHO -->
    <div class="modal fade" id="modalCompletarTaller" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("CompletarTallerOCC", "Iglesia")" method="post" id="formAsignacionMateriales">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />

                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-boxes me-2 text-primary"></i>Asignación de Materiales para Despacho</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info py-2 px-3 small mb-3 rounded-3">
                            <i class="bi bi-info-circle-fill me-1"></i>Defina las cantidades oficiales de materiales que retirará la iglesia y, opcionalmente, programe su retiro en un Evento de Despacho existente.
                        </div>

                        <!-- SECCIÓN 2 — MATERIALES -->
                        <div class="card bg-slate-50 border p-3 rounded-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="font-bold text-slate-800 mb-0"><i class="bi bi-gift me-2 text-success"></i>Materiales Asignados para Despacho</h6>
                                <span class="badge bg-success-soft text-success text-xxs uppercase font-semibold">Catálogo OCC</span>
                            </div>
                            <p class="text-muted text-xs mb-3">Estas cantidades quedarán asignadas a la iglesia y se descontarán del inventario del equipo al momento de la entrega presencial.</p>
                            
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">Oportunidades Evangelísticas <span class="text-danger">*</span></label>
                                    <input type="number" name="oportunidadesEvangelisticas" id="inpMatOportunidades" class="form-control form-control-sm text-center fw-bold" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.OportunidadesEvangelisticas > 0 ? Model.RecursosActuales.OportunidadesEvangelisticas : (p.TallerCantNinos > 0 ? p.TallerCantNinos : 50))" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">El Mejor Regalo <span class="text-danger">*</span></label>
                                    <input type="number" name="librosMejorRegalo" id="inpMatRegalo" class="form-control form-control-sm text-center fw-bold text-primary" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.LibrosMejorRegalo > 0 ? Model.RecursosActuales.LibrosMejorRegalo : (p.TallerCantNinos > 0 ? p.TallerCantNinos : 50))" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">Guías del Alumno <span class="text-danger">*</span></label>
                                    <input type="number" name="librosAlumno" id="inpMatAlumno" class="form-control form-control-sm text-center fw-bold text-success" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.LibrosAlumno > 0 ? Model.RecursosActuales.LibrosAlumno : (p.TallerCantNinos > 0 ? p.TallerCantNinos : 50))" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">Guía del Maestro</label>
                                    <input type="number" name="librosMaestros" id="inpMatMaestros" class="form-control form-control-sm text-center fw-bold" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.LibrosMaestros > 0 ? Model.RecursosActuales.LibrosMaestros : (Model.Maestros.Any() ? Model.Maestros.Count : 5))" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">Nuevos Testamentos</label>
                                    <input type="number" name="nuevosTestamentos" id="inpMatTestamentos" class="form-control form-control-sm text-center fw-bold" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.NuevosTestamentos > 0 ? Model.RecursosActuales.NuevosTestamentos : (p.TallerCantNinos > 0 ? p.TallerCantNinos : 50))" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-xs fw-semibold mb-1">Poster</label>
                                    <input type="number" name="posters" id="inpMatPosters" class="form-control form-control-sm text-center fw-bold" min="0" value="@(Model.RecursosActuales != null && Model.RecursosActuales.Posters > 0 ? Model.RecursosActuales.Posters : 10)" />
                                </div>
                            </div>
                        </div>

                        <!-- PROGRAMAR DE INMEDIATO EN EVENTO DE DESPACHO (OPCIONAL) -->
                        <div class="card bg-light border p-3 rounded-3 mb-2">
                            <label class="form-label small fw-bold text-slate-800 mb-1">
                                <i class="bi bi-truck-front me-1 text-primary"></i>Programar de inmediato en Evento de Despacho (Opcional)
                            </label>
                            <p class="text-muted text-xs mb-2">Seleccione un evento si desea programar esta asignación inmediatamente. Puede hacerlo posteriormente desde el módulo de Eventos.</p>
                            
                            @{
                                var evsDespacho = ViewBag.EventosDespacho as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
                            }
                            @if (evsDespacho != null && evsDespacho.Any())
                            {
                                <select name="idEventoDespacho" id="cboIdEventoDespacho" class="form-select form-select-sm">
                                    <option value="">— Ninguno / No programar (Programar más adelante) —</option>
                                    @foreach (var ed in evsDespacho)
                                    {
                                        <option value="@ed.Value">@ed.Text</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-secondary py-2 px-3 small mb-0 rounded-2 text-muted">
                                    <i class="bi bi-info-circle me-1"></i>No existen Eventos de Despacho disponibles para programación inmediata en su equipo. Puede asignarse y programarse posteriormente.
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success font-semibold px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>Guardar Asignación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

    <!-- MODAL REGISTRAR MAESTRO DESDE FICHA -->
    <div class="modal fade" id="modalRegistrarMaestroFicha" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form id="formRegistrarMaestroAjax" action="@Url.Action("RegistrarMaestroAjax", "Maestros")" method="post">
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />

                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-person-plus me-2 text-primary"></i>Registrar Nuevo Maestro</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Nombres <span class="text-danger">*</span></label>
                                <input type="text" name="nombres" class="form-control" required placeholder="Ej: María" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Apellidos <span class="text-danger">*</span></label>
                                <input type="text" name="apellidos" class="form-control" required placeholder="Ej: Rodríguez" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cédula <span class="text-danger">*</span></label>
                                <input type="text" name="documentoIdentidad" class="form-control" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Celular <span class="text-danger">*</span></label>
                                <input type="text" name="celular" class="form-control" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Correo Electrónico <span class="text-danger">*</span></label>
                                <input type="email" name="correo" class="form-control" required placeholder="maestro@ejemplo.com" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Registrar Maestro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL REMOVER MAESTRO -->
    <div class="modal fade" id="modalRemoverMaestro" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("RemoverMaestro", "Maestros")" method="post">
                    <input type="hidden" name="idMaestro" id="modalRemoverIdMaestro" value="" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />

                    <div class="modal-header bg-danger text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-exclamation-triangle me-2"></i>Remover o Inhabilitar Maestro</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p>Estás a punto de eliminar o inhabilitar al maestro <strong id="modalRemoverNombreMaestro"></strong> de esta iglesia.</p>
                        <p class="small text-muted mb-3">
                            <em>Nota: Si el maestro ya está registrado como participante en algún taller OCC de la temporada, no se eliminará físicamente sino que se inhabilitará.</em>
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Razón o Comentario <span class="text-danger">*</span></label>
                            <textarea name="comentario" class="form-control" rows="3" required placeholder="Explica la razón por la que se remueve o inhabilita a este maestro..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger font-semibold"><i class="bi bi-trash me-1"></i>Confirmar Acción</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function abrirModalRemoverMaestro(idMaestro, nombreMaestro) {
            document.getElementById('modalRemoverIdMaestro').value = idMaestro;
            document.getElementById('modalRemoverNombreMaestro').textContent = nombreMaestro;
            var modal = new bootstrap.Modal(document.getElementById('modalRemoverMaestro'));
            modal.show();
        }
    </script>

