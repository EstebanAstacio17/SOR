@model SOR.Models.Iglesia
@{
    ViewBag.Title = "Expediente de la Iglesia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var u = (SOR.Models.Usuario)ViewBag.UsuarioActual;
    var puedeEditar = (bool)ViewBag.PuedeEditar;
}

<div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <a href="@Url.Action("Index", "Iglesia")" class="btn btn-sm btn-outline-secondary font-semibold">
        <i class="bi bi-arrow-left me-1"></i>Volver a la Lista
    </a>
    <div class="d-flex align-items-center gap-2">
        <h3 class="h4 font-bold text-slate-800 m-0">Expediente de la Iglesia</h3>
        @if (puedeEditar)
        {
            <a href="@Url.Action("Editar", "Iglesia", new { id = Model.IdIglesia })" class="btn btn-sm btn-warning font-semibold shadow-sm">
                <i class="bi bi-pencil-square me-1"></i>Editar Expediente
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- PANEL IZQUIERDO: FICHA FÍSICA E IDENTIDAD -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-header text-white rounded-top-4 py-3 border-0" style="background-color: #0f172a !important;">
                <h5 class="card-title mb-0 font-bold"><i class="bi bi-building me-2 text-warning"></i>Ficha de Identidad</h5>
            </div>
            <div class="card-body p-4">
                <h4 class="font-bold text-primary mb-1">@Model.NombreIglesia</h4>
                <span style="background-color: #f1f5f9 !important; color: #334155 !important; padding: 4px 12px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; display: inline-block; margin-bottom: 12px; border: 1px solid #cbd5e1;"><i class="bi bi-diagram-3 me-1 text-primary"></i>@Model.NombreEquipo</span>
                
                <div class="d-flex flex-column gap-3 text-sm mt-2">
                    <div>
                        <small class="text-muted d-block text-xxs font-semibold uppercase">Denominación</small>
                        <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.Denominacion) ? "No especificado" : Model.Denominacion)</span>
                    </div>
                    <div>
                        <small class="text-muted d-block text-xxs font-semibold uppercase">Tipo de Organización</small>
                        <span class="fw-bold text-slate-800">@(string.IsNullOrEmpty(Model.TipoOrganizacion) ? "No especificado" : Model.TipoOrganizacion)</span>
                    </div>
                    <div>
                        <small class="text-muted d-block text-xxs font-semibold uppercase">RNC / Cédula</small>
                        <span class="font-monospace text-slate-700">@(string.IsNullOrEmpty(Model.RNC_Cedula) ? "N/D" : Model.RNC_Cedula)</span>
                    </div>
                    <div>
                        <small class="text-muted d-block text-xxs font-semibold uppercase">Teléfono Fijo</small>
                        <span>@(string.IsNullOrEmpty(Model.Telefono) ? "N/D" : Model.Telefono)</span>
                    </div>
                    <div>
                        <small class="text-muted d-block text-xxs font-semibold uppercase">Dirección Física</small>
                        <span class="text-slate-700">@Model.Calle #@Model.Numero, @Model.Sector, @Model.Ciudad, @Model.Provincia</span>
                        @if (!string.IsNullOrEmpty(Model.Referencia))
                        {
                            <div class="small text-muted mt-1"><i class="bi bi-pin-map me-1"></i>Ref: @Model.Referencia</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- PASTORES Y LÍDERES -->
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-header text-white rounded-top-4 py-3 border-0" style="background-color: #0f172a !important;">
                <h5 class="card-title mb-0 font-bold"><i class="bi bi-people me-2"></i>Contactos Clave</h5>
            </div>
            <div class="card-body p-4 d-flex flex-column gap-4">
                <!-- Pastor -->
                <div>
                    <span style="background-color: #e0f2fe !important; color: #0369a1 !important; padding: 4px 12px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; display: inline-block; margin-bottom: 8px;">Pastor General</span>
                    @if (Model.Pastor != null && !string.IsNullOrEmpty(Model.Pastor.Nombres))
                    {
                        <h6 class="font-bold mb-1" style="color: #1e293b !important;">@Model.Pastor.Nombres @Model.Pastor.Apellidos</h6>
                        <div class="text-xs" style="color: #475569 !important;"><i class="bi bi-telephone me-1"></i>@Model.Pastor.Celular</div>
                        <div class="text-xs" style="color: #475569 !important;"><i class="bi bi-envelope me-1"></i>@Model.Pastor.Correo</div>
                    }
                    else
                    {
                        <p class="small mb-0" style="color: #64748b !important;">No se registraron datos del Pastor.</p>
                    }
                </div>

                <!-- Líder Ministerial -->
                <div>
                    <span style="background-color: #ccfbf1 !important; color: #0f766e !important; padding: 4px 12px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; display: inline-block; margin-bottom: 8px;">Líder de Discipulado / Ministerial</span>
                    @if (Model.LiderMinisterial != null && !string.IsNullOrEmpty(Model.LiderMinisterial.Nombres))
                    {
                        <h6 class="font-bold mb-1" style="color: #1e293b !important;">@Model.LiderMinisterial.Nombres @Model.LiderMinisterial.Apellidos</h6>
                        <div class="text-xs" style="color: #475569 !important;"><i class="bi bi-telephone me-1"></i>@Model.LiderMinisterial.Celular</div>
                        <div class="text-xs" style="color: #475569 !important;"><i class="bi bi-envelope me-1"></i>@Model.LiderMinisterial.Correo</div>
                    }
                    else
                    {
                        <p class="small mb-0" style="color: #64748b !important;">No se registraron datos del Líder.</p>
                    }
                </div>
            </div>
        </div>

        <!-- RECURSOS ASIGNADOS -->
        @if (Model.RecursosActuales != null)
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="h6 font-bold text-slate-800 mb-0"><i class="bi bi-box-seam me-2 text-warning"></i>Asignación de Recursos</h5>
                    @if (!string.IsNullOrEmpty(Model.RecursosActuales.EstadoAsignacion))
                    {
                        string badgeClass = Model.RecursosActuales.EstadoAsignacion == "DESPACHADA" ? "bg-success" :
                                            Model.RecursosActuales.EstadoAsignacion == "PROGRAMADA_DESPACHO" ? "bg-primary" :
                                            Model.RecursosActuales.EstadoAsignacion == "DISPONIBLE_PARA_DESPACHO" ? "bg-info text-dark" : "bg-secondary";
                        <span class="badge @badgeClass text-xxs px-2 py-1">@Model.RecursosActuales.EstadoAsignacion.Replace("_", " ")</span>
                    }
                </div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6">
                        <div class="p-2 border rounded bg-slate-50">
                            <span class="d-block h4 mb-0 text-slate-800">@Model.RecursosActuales.OportunidadesEvangelisticas</span>
                            <small class="text-slate-500 text-xxs font-semibold uppercase">Oportunidades</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded bg-slate-50">
                            <span class="d-block h4 mb-0 text-slate-800">@Model.RecursosActuales.LibrosMejorRegalo</span>
                            <small class="text-slate-500 text-xxs font-semibold uppercase">Mejor Regalo</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded bg-slate-50">
                            <span class="d-block h4 mb-0 text-slate-800">@Model.RecursosActuales.LibrosMaestros</span>
                            <small class="text-slate-500 text-xxs font-semibold uppercase">Libros Maestros</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 border rounded bg-slate-50">
                            <span class="d-block h4 mb-0 text-slate-800">@Model.RecursosActuales.LibrosAlumno</span>
                            <small class="text-slate-500 text-xxs font-semibold uppercase">Libros Alumno</small>
                        </div>
                    </div>
                </div>
                <div class="d-grid">
                    <a href="@Url.Action("Index", "Eventos")" class="btn btn-outline-primary btn-sm font-semibold">
                        <i class="bi bi-send-check me-1"></i>Gestionar Despacho en Eventos
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- PANEL DERECHO: CICLO DE PROCESO Y ETAPAS GESTIÓN TEMP -->
    <div class="col-lg-8">
        <!-- 1. LÍNEA DE TIEMPO INTERACTIVA DE LAS 5 ETAPAS -->
        @if (Model.ParticipacionActual != null)
        {
            var part = Model.ParticipacionActual;
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-4 flex-wrap gap-2">
                    <h5 class="h6 font-bold text-slate-800 mb-0">
                        <i class="bi bi-signpost-split me-2 text-primary"></i>
                        @(part.TemporadaActiva ? "Etapas de la Temporada Activa: " : "Etapas de la Temporada: ") @part.NombreTemporada
                        @if (!part.TemporadaActiva)
                        {
                            <span class="badge bg-secondary ms-2 text-xxs">Inactiva / Cerrada</span>
                        }
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="small fw-semibold text-slate-600">Estatus Reportes:</span>
                        @if (part.EstatusEvaluacionReporte == "Reportó")
                        {
                            <span class="badge bg-success px-2 py-1">Reportó</span>
                        }
                        else if (part.EstatusEvaluacionReporte == "No Reportó")
                        {
                            <span class="badge bg-danger px-2 py-1">No Reportó</span>
                        }
                        else if (part.EstatusEvaluacionReporte == "Castigada")
                        {
                            <span class="badge bg-dark px-2 py-1">Castigada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-2 py-1">Pendiente</span>
                        }
                        
                        @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2 || u.IdPosicion == 3)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-bs-toggle="modal" data-bs-target="#modalCambiarEstatusReporte" title="Cambiar Estatus">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        }
                    </div>
                </div>

                @if (!part.TemporadaActiva)
                {
                    <div class="alert alert-secondary py-2 px-3 mb-3 d-flex align-items-center gap-2 rounded-3">
                        <i class="bi bi-lock-fill text-muted flex-shrink-0"></i>
                        <span class="small">Esta temporada se encuentra <strong>cerrada o inactiva</strong>. Los datos se muestran en modo histórico de consulta y las transiciones operativas están deshabilitadas.</span>
                    </div>
                }
                
                <!-- CONTROL DE REGLA DE 3 AÑOS Y EXCEPCIÓN CE + CMI -->
                @if (Model.RequiereExcepcion3Anios)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 @(Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "APROBADA" ? "bg-success-soft border border-success" : (Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "RECHAZADA" ? "bg-danger-soft border border-danger" : "bg-warning-soft border border-warning"))">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-shield-exclamation fs-5 @(Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "APROBADA" ? "text-success" : (Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "RECHAZADA" ? "text-danger" : "text-warning"))"></i>
                                        <h6 class="font-bold text-dark mb-0">Requisito de Antigüedad: Mínimo 3 Años</h6>
                                    </div>
                                    <p class="text-xs text-muted mb-0 mt-1">
                                        Esta iglesia participó en la temporada <strong>@Model.NombreTemporadaPrevia</strong> (@Model.DiferenciaAniosAntiguedad temporada(s) de diferencia). Requiere un mínimo de 3 temporadas o una excepción formal de buen desempeño aprobada por CE y CMI.
                                    </p>
                                </div>
                                <div>
                                    @if (Model.ExcepcionActiva == null)
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2 rounded-pill font-semibold">
                                            <i class="bi bi-slash-circle me-1"></i>No cumple requisito (Sin Excepción)
                                        </span>
                                    }
                                    else if (Model.ExcepcionActiva.Estado == "PENDIENTE")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill font-semibold border border-warning">
                                            <i class="bi bi-hourglass-split me-1"></i>Excepción en Proceso de Aprobación
                                        </span>
                                    }
                                    else if (Model.ExcepcionActiva.Estado == "APROBADA")
                                    {
                                        <span class="badge bg-success text-white px-3 py-2 rounded-pill font-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Excepción Aprobada (CE ✓ | CMI ✓)
                                        </span>
                                    }
                                    else if (Model.ExcepcionActiva.Estado == "RECHAZADA")
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2 rounded-pill font-semibold">
                                            <i class="bi bi-x-circle-fill me-1"></i>Excepción Rechazada
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Panel de Desempeño y Firmas -->
                            <div class="bg-white rounded-3 p-3 border mb-3">
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-7 border-end-md">
                                        <div class="text-xs font-semibold text-muted text-uppercase mb-1">
                                            <i class="bi bi-graph-up-arrow text-primary me-1"></i>Desempeño Histórico (@Model.NombreTemporadaPrevia)
                                        </div>
                                        <div class="text-xs text-slate-700 lh-sm">
                                            @(Model.DesempenoHistorico != null ? Model.DesempenoHistorico.ResumenTexto : "Registros de desempeño histórico cargados.")
                                        </div>
                                        @if (Model.ExcepcionActiva != null && !string.IsNullOrEmpty(Model.ExcepcionActiva.Motivo))
                                        {
                                            <div class="mt-2 pt-2 border-top text-xs">
                                                <strong>Motivo:</strong> @Model.ExcepcionActiva.Motivo<br />
                                                <strong>Justificación:</strong> @Model.ExcepcionActiva.Justificacion
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-5">
                                        <div class="text-xs font-semibold text-muted text-uppercase mb-2 text-center text-md-start">
                                            <i class="bi bi-pen me-1"></i>Firmas de Autorización Obligatorias
                                        </div>
                                        <div class="d-flex flex-column gap-2">
                                            <!-- Firma CE -->
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-person-badge text-primary"></i>
                                                    <span class="text-xs font-semibold">Coordinador de Equipo (CE)</span>
                                                </div>
                                                @if (Model.ExcepcionActiva != null && Model.ExcepcionActiva.AprobadoCE)
                                                {
                                                    <span class="badge bg-success-soft text-success"><i class="bi bi-check-circle me-1"></i>Aprobado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-soft text-muted"><i class="bi bi-clock me-1"></i>Pendiente</span>
                                                }
                                            </div>
                                            <!-- Firma CMI -->
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-person-gear text-info"></i>
                                                    <span class="text-xs font-semibold">Coordinador Movilización (CMI)</span>
                                                </div>
                                                @if (Model.ExcepcionActiva != null && Model.ExcepcionActiva.AprobadoCMI)
                                                {
                                                    <span class="badge bg-success-soft text-success"><i class="bi bi-check-circle me-1"></i>Aprobado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-soft text-muted"><i class="bi bi-clock me-1"></i>Pendiente</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Botones de Acción -->
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div>
                                    @if (Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "RECHAZADA")
                                    {
                                        <div class="text-xs text-danger font-semibold">
                                            <i class="bi bi-info-circle me-1"></i>Motivo del rechazo: @Model.ExcepcionActiva.MotivoRechazo (por @Model.ExcepcionActiva.NombreUsuarioRechazo el @(Model.ExcepcionActiva.FechaRechazo.HasValue ? Model.ExcepcionActiva.FechaRechazo.Value.ToString("dd/MM/yyyy") : ""))
                                        </div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (Model.ExcepcionActiva == null && ViewBag.PuedeSolicitarExcepcion == true && part.TemporadaActiva)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSolicitarExcepcion">
                                            <i class="bi bi-shield-plus me-1"></i>Solicitar Excepción por Buen Desempeño
                                        </button>
                                    }
                                    @if (Model.ExcepcionActiva != null && Model.ExcepcionActiva.Estado == "PENDIENTE" && part.TemporadaActiva)
                                    {
                                        if (ViewBag.PuedeAprobarCE == true && !Model.ExcepcionActiva.AprobadoCE)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprobarCE">
                                                <i class="bi bi-check2-circle me-1"></i>Aprobar como CE
                                            </button>
                                        }
                                        if (ViewBag.PuedeAprobarCMI == true && !Model.ExcepcionActiva.AprobadoCMI)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprobarCMI">
                                                <i class="bi bi-check2-circle me-1"></i>Aprobar como CMI
                                            </button>
                                        }
                                        if (ViewBag.PuedeAprobarCE == true || ViewBag.PuedeAprobarCMI == true)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRechazarExcepcion">
                                                <i class="bi bi-x-octagon me-1"></i>Rechazar Excepción
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Timeline Steps Container -->
                <div class="py-2 px-1 overflow-hidden">
                    @{
                        // 7 pasos = 6 tramos intermedios
                        double progresoPct = 0;
                        if (part.EtapaActual >= 7) { progresoPct = 100.0; }
                        else if (part.EtapaActual > 1) { progresoPct = (part.EtapaActual - 1) * (100.0 / 6.0); }
                    }
                    <div class="row g-2 justify-content-between position-relative">
                        <!-- Connecting track behind the steps: de centro de paso 1 a centro de paso 7 -->
                        <div class="position-absolute d-none d-md-block" style="top: 18px; left: calc(100% / 14); right: calc(100% / 14); height: 3px; background-color: #e2e8f0; z-index: 1;">
                            <div class="h-100 bg-success" style="width: @(progresoPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; transition: width 0.4s ease;"></div>
                        </div>

                        <!-- Step 1: Inscrita -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 1 ? "bg-success text-white" : (part.EtapaActual == 1 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 1 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("1"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 1 ? "text-primary fw-bold" : (part.EtapaActual > 1 ? "text-success" : "text-muted"))">Inscrita</div>
                            <div class="text-xxs text-muted">@(Model.FechaCreacion.HasValue ? Model.FechaCreacion.Value.ToString("dd/MM/yyyy") : "Completada")</div>
                        </div>

                        <!-- Step 2: Evaluada -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 2 ? "bg-success text-white" : (part.EtapaActual == 2 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 2 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("2"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 2 ? "text-primary fw-bold" : (part.EtapaActual > 2 ? "text-success" : "text-muted"))">Evaluada</div>
                            <div class="text-xxs text-muted">@(part.EvalInicialFecha.HasValue ? part.EvalInicialFecha.Value.ToString("dd/MM/yyyy") : (part.EtapaActual > 2 ? "Completada" : (part.EtapaActual == 2 ? "En curso" : "Pendiente")))</div>
                        </div>

                        <!-- Step 3: Visión -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 3 ? "bg-success text-white" : (part.EtapaActual == 3 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 3 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("3"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 3 ? "text-primary fw-bold" : (part.EtapaActual > 3 ? "text-success" : "text-muted"))">Visión</div>
                            <div class="text-xxs text-muted">@(part.VisionFecha.HasValue ? part.VisionFecha.Value.ToString("dd/MM/yyyy") : (part.EtapaActual > 3 ? "Completada" : (part.EtapaActual == 3 ? "En curso" : "Pendiente")))</div>
                        </div>

                        <!-- Step 4: Elegibilidad -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 4 ? "bg-success text-white" : (part.EtapaActual == 4 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 4 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("4"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 4 ? "text-primary fw-bold" : (part.EtapaActual > 4 ? "text-success" : "text-muted"))">Elegible Taller</div>
                            <div class="text-xxs text-muted">@(part.EvalTallerFecha.HasValue ? part.EvalTallerFecha.Value.ToString("dd/MM/yyyy") : (part.EtapaActual > 4 ? "Completada" : (part.EtapaActual == 4 ? "En curso" : "Pendiente")))</div>
                        </div>

                        <!-- Step 5: Taller OCC -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 5 ? "bg-success text-white" : (part.EtapaActual == 5 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 5 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("5"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 5 ? "text-primary fw-bold" : (part.EtapaActual > 5 ? "text-success" : "text-muted"))">Taller OCC</div>
                            <div class="text-xxs text-muted">@(part.TallerFecha.HasValue ? part.TallerFecha.Value.ToString("dd/MM/yyyy") : (part.EtapaActual > 5 ? "Completada" : (part.EtapaActual == 5 ? "En curso" : "Pendiente")))</div>
                        </div>

                        <!-- Step 6: Asignación -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual > 6 ? "bg-success text-white" : (part.EtapaActual == 6 ? "bg-primary text-white" : "bg-white text-muted border"))" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual > 6 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("6"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual == 6 ? "text-primary fw-bold" : (part.EtapaActual > 6 ? "text-success" : "text-muted"))">Asignación</div>
                            <div class="text-xxs text-muted">@(part.EtapaActual > 6 ? "Completada" : (part.EtapaActual == 6 ? "En curso" : "Pendiente"))</div>
                        </div>

                        <!-- Step 7: Aprobación Final -->
                        <div class="col text-center position-relative" style="z-index: 2;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold shadow-sm @(part.EtapaActual >= 7 ? "bg-success text-white" : "bg-white text-muted border")" style="width: 38px; height: 38px; font-size: 0.875rem;">
                                @(part.EtapaActual >= 7 ? Html.Raw("<i class=\"bi bi-check-lg text-white\"></i>") : Html.Raw("7"))
                            </div>
                            <div class="mt-2 font-semibold text-xs @(part.EtapaActual >= 7 ? "text-success fw-bold" : "text-muted")">Aprobación Final</div>
                            <div class="text-xxs text-muted">@(part.FechaEvaluacion.HasValue ? part.FechaEvaluacion.Value.ToString("dd/MM/yyyy") : (part.EtapaActual >= 7 ? "Completada" : "Pendiente"))</div>
                        </div>
                    </div>
                </div>

                <!-- ACCIONES Y PANELES DE TRANSICIÓN SEGÚN ETAPA ACTUAL -->
                <div class="bg-light p-4 rounded-4 mt-4 border border-slate-200">
                    <h6 class="font-bold text-slate-800 mb-3"><i class="bi bi-sliders me-2 text-slate-600"></i>Panel de Control de la Etapa @part.EtapaActual</h6>

                    @if (part.EstadoEvaluacion == "Rechazado" || part.EstadoEvaluacion == "Detenido")
                    {
                        <div class="alert @(part.EstadoEvaluacion == "Detenido" ? "alert-warning" : "alert-danger") mb-3 py-3 shadow-sm rounded-3">
                            <h6 class="font-bold mb-1"><i class="bi @(part.EstadoEvaluacion == "Detenido" ? "bi-pause-circle-fill" : "bi-x-octagon-fill") me-2"></i>El proceso de participación ha sido @(part.EstadoEvaluacion == "Detenido" ? "DETENIDO" : "RECHAZADO / CANCELADO")</h6>
                            <p class="small mb-0 mt-1">
                                <strong>Razón o Justificación:</strong> @(string.IsNullOrEmpty(part.EvalInicialMotivo) ? (string.IsNullOrEmpty(part.EvalTallerMotivo) ? "No especificado" : part.EvalTallerMotivo) : part.EvalInicialMotivo)
                            </p>
                        </div>
                        if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2 || u.IdPosicion == 3)
                        {
                            <button class="btn btn-outline-warning btn-sm font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalReabrirProcesoGlobal">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reabrir Proceso / Cambiar Decisión
                            </button>
                        }
                    }
                    else if (!part.TemporadaActiva)
                    {
                        <div class="p-3 bg-white rounded-3 border">
                            <p class="small text-muted mb-0"><i class="bi bi-lock me-1"></i>Las operaciones de avance de etapa no están disponibles para esta participación debido a que la temporada se encuentra cerrada o inactiva.</p>
                        </div>
                    }
                    else
                    {
                        if (part.EtapaActual == 1) // INSCRITA - Requiere Evaluación Inicial
                        {
                            <p class="small text-slate-600 mb-3">La iglesia está inscrita. Requiere que un Coordinador de Movilización (CMI) o Coordinador de Equipo (CE) realice la **Evaluación Inicial**.</p>
                            if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprobarEvalInicial">Aprobar Evaluación</button>
                                    <button class="btn btn-warning font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetenerProcesoGlobal">Detener Proceso</button>
                                    <button class="btn btn-danger font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRechazarEvalInicial">Rechazar Iglesia</button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-lock me-1"></i>Requiere rol de CMI o CE para evaluar</span>
                            }
                        }
                        else if (part.EtapaActual == 2) // EVALUADA - Avanzar a Visión
                        {
                            <p class="small text-slate-600 mb-3">La evaluación inicial ha sido aprobada. El siguiente paso es invitar a la iglesia y registrar los detalles y la asistencia al evento **Presentación de la Visión**.</p>
                            if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAsignarVision"><i class="bi bi-eye me-2"></i>Asignar Presentación de la Visión</button>
                                    <button class="btn btn-warning font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetenerProcesoGlobal">Detener Proceso</button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-lock me-1"></i>Requiere rol de CMI o CE para registrar Visión</span>
                            }
                        }
                        else if (part.EtapaActual == 3) // VISIÓN
                        {
                            @* Verificar si la asistencia al evento de Visión está confirmada *@
                            bool visionAsistioConfirmada = part.VisionAsistio;

                            <p class="small text-slate-600 mb-3">La iglesia está invitada a la Presentación de la Visión. Una vez confirmada su asistencia en el evento, el CMI o CE debe aprobarla para que sea elegible para el Taller OCC.</p>

                            @* Estado de asistencia *@
                            <div class="mb-3">
                                @if (visionAsistioConfirmada)
                                {
                                    <span class="badge bg-success px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i>Asistencia a Presentación de la Visión confirmada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-clock-history me-1"></i>Asistencia aún no confirmada en el evento</span>
                                }
                            </div>

                            if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2)
                            {
                                if (visionAsistioConfirmada)
                                {
                                    <div class="d-flex gap-2">
                                        <form action="@Url.Action("AprobarElegibilidadBasica", "Iglesia")" method="post" class="m-0">
                                            <input type="hidden" name="idParticipacion" value="@part.IdParticipacion" />
                                            <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                                            <button type="submit" class="btn btn-success font-semibold px-4 shadow-sm" onclick="return confirm('¿Aprobar la elegibilidad de esta iglesia para pasar al Taller OCC?');"><i class="bi bi-check-circle me-1"></i>Aprobar para Taller OCC</button>
                                        </form>
                                        <button class="btn btn-warning font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetenerProcesoGlobal">Detener Proceso</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning py-2 px-3 mb-0 d-flex align-items-start gap-2">
                                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                                        <div class="small">
                                            <strong>Asistencia pendiente de confirmar.</strong> Para poder aprobar esta iglesia, primero debe confirmar su asistencia en la ficha del evento de Presentación de la Visión. Vaya al módulo de Eventos, ingrese al evento y marque la asistencia de la iglesia.
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-lock me-1"></i>Requiere rol de CMI o CE para aprobar elegibilidad</span>
                            }
                        }
                        else if (part.EtapaActual == 4) // ELEGIBLE TALLER
                        {
                            <p class="small text-slate-600 mb-3">La iglesia es Elegible para el Taller OCC. El Coordinador de Discipulado (CD) o CE debe asignarle el taller correspondiente y confirmar los líderes/maestros.</p>
                            if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-primary font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprobarElegibilidad"><i class="bi bi-calendar-event me-1"></i>Asignar Taller OCC</button>
                                    <button class="btn btn-warning font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetenerProcesoGlobal">Detener Proceso</button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-lock me-1"></i>Requiere rol de CD o CE para asignar Taller</span>
                            }
                        }
                        else if (part.EtapaActual == 5) // TALLER OCC ASIGNADO
                        {
                            <p class="small text-slate-600 mb-0"><i class="bi bi-clock me-1 text-warning"></i> La iglesia tiene asignado el Taller OCC. Esperando registro de asistencia de sus líderes y maestros en la ficha del taller correspondiente para avanzar a la etapa de asignación final.</p>
                        }
                        else if (part.EtapaActual == 6) // EVALUACIÓN ASIGNACIÓN
                        {
                            <div class="alert alert-success mb-3 py-3 shadow-sm rounded-3">
                                <h6 class="font-bold mb-1"><i class="bi bi-check-circle-fill me-2"></i>¡Taller OCC Completado y Evaluado!</h6>
                                <p class="small mb-0 mt-1">La iglesia ha completado satisfactoriamente el taller y está lista para la asignación de recursos finales. Presiona el botón a continuación para despachar o registrar la asignación final.</p>
                            </div>
                            if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                            {
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCompletarTaller"><i class="bi bi-gift me-2"></i>Finalizar Asignación de Recursos</button>
                                    <button class="btn btn-warning font-semibold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetenerProcesoGlobal">Detener Proceso</button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning-soft px-3 py-2"><i class="bi bi-lock me-1"></i>Requiere rol de CD, CE o Admin para finalizar recursos</span>
                            }
                        }
                        else if (part.EtapaActual >= 7) // APROBACIÓN FINAL & LOGÍSTICA
                        {
                            <div class="alert alert-success mb-3 py-3 shadow-sm rounded-3">
                                <h6 class="font-bold mb-1"><i class="bi bi-patch-check-fill me-2 text-success"></i>¡Proceso Completado y Aprobado!</h6>
                                <p class="small mb-0 mt-1">Esta iglesia ha completado satisfactoriamente todas las etapas de la temporada. Se han asignado los recursos y está habilitada para el retiro de materiales en el Evento de Despacho.</p>
                            </div>
                            
                            <div class="card border-0 bg-white shadow-sm rounded-3 p-3 mb-0 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                    <div>
                                        <h6 class="font-bold text-dark mb-1"><i class="bi bi-truck-front text-primary me-2"></i>Estado de Despacho Presencial</h6>
                                        <div class="small text-muted">
                                            @if (Model.RecursosActuales != null && Model.RecursosActuales.EstadoAsignacion == "DESPACHADA")
                                            {
                                                <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Materiales Despachados</span>
                                                <span> (Retirados por el Pastor o Líder Ministerial)</span>
                                            }
                                            else if (Model.RecursosActuales != null && Model.RecursosActuales.EstadoAsignacion == "PROGRAMADA_DESPACHO")
                                            {
                                                <span class="text-primary fw-bold"><i class="bi bi-calendar-check me-1"></i>Programada en Evento de Despacho</span>
                                                <span> — Pendiente de entrega presencial con cédula en mano.</span>
                                            }
                                            else
                                            {
                                                <span class="text-info fw-bold"><i class="bi bi-box-seam me-1"></i>Disponible para Despacho</span>
                                                <span> — Lista para ser agregada a un Evento de Despacho de su equipo.</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary font-semibold" data-bs-toggle="modal" data-bs-target="#modalCompletarTaller">
                                                <i class="bi bi-pencil-square me-1"></i>Editar Asignación
                                            </button>
                                        }
                                        <a href="@Url.Action("Index", "Eventos")" class="btn btn-sm btn-primary font-semibold shadow-sm">
                                            <i class="bi bi-send-check me-1"></i>Ir a Eventos de Despacho
                                        </a>
                                        <a href="@Url.Action("Index", "Logistica")" class="btn btn-sm btn-outline-secondary font-semibold">
                                            <i class="bi bi-boxes me-1"></i>Logística OCC
                                        </a>
                                    </div>
                                </div>

                                @if (Model.RecursosActuales != null)
                                {
                                    <div class="border-top pt-2">
                                        <span class="text-xs fw-semibold text-slate-500 text-uppercase d-block mb-2"><i class="bi bi-box-seam me-1"></i>Materiales Asignados:</span>
                                        <div class="d-flex flex-wrap gap-2">
                                            <span class="badge bg-light text-dark border"><i class="bi bi-box me-1 text-primary"></i><strong>@Model.RecursosActuales.OportunidadesEvangelisticas</strong> Cajas (GM)</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-book me-1 text-primary"></i><strong>@Model.RecursosActuales.LibrosMejorRegalo</strong> El Mejor Regalo</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-journal-text me-1 text-success"></i><strong>@Model.RecursosActuales.LibrosAlumno</strong> GA Alumno</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-journal-bookmark me-1 text-success"></i><strong>@Model.RecursosActuales.LibrosMaestros</strong> GA Guía Docente</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-book-half me-1 text-info"></i><strong>@Model.RecursosActuales.NuevosTestamentos</strong> Nuevos Testamentos</span>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-file-earmark-richtext me-1 text-warning"></i><strong>@Model.RecursosActuales.Posters</strong> Posters / Plantillas</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-4">
                <i class="bi bi-exclamation-triangle me-1"></i> Esta iglesia no tiene una participación registrada en la temporada activa actual.
            </div>
        }

        <!-- PESTAÑAS SECUNDARIAS DE GESTIÓN (MAESTROS, ORACIÓN, HISTORIAL, COMENTARIOS) -->
        <ul class="nav nav-tabs border-bottom-0 mb-3" id="tabExpediente" role="tablist">
            <li class="nav-item">
                <button class="nav-link active font-semibold border-0 rounded-top-4 shadow-sm px-4" id="maestros-tab" data-bs-toggle="tab" data-bs-target="#panel-maestros" type="button" role="tab"><i class="bi bi-people me-1"></i>Maestros (@Model.Maestros.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link font-semibold border-0 rounded-top-4 shadow-sm px-4 ms-2" id="oracion-tab" data-bs-toggle="tab" data-bs-target="#panel-oracion" type="button" role="tab"><i class="bi bi-heart me-1"></i>Intercesores (@Model.CompanerosOracion.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link font-semibold border-0 rounded-top-4 shadow-sm px-4 ms-2" id="historial-tab" data-bs-toggle="tab" data-bs-target="#panel-historial" type="button" role="tab"><i class="bi bi-clock-history me-1"></i>Línea de Tiempo / Historial</button>
            </li>
            <li class="nav-item">
                <button class="nav-link font-semibold border-0 rounded-top-4 shadow-sm px-4 ms-2" id="comentarios-tab" data-bs-toggle="tab" data-bs-target="#panel-comentarios" type="button" role="tab"><i class="bi bi-chat-text me-1"></i>Observaciones (@Model.Comentarios.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link font-semibold border-0 rounded-top-4 shadow-sm px-4 ms-2" id="excepciones-tab" data-bs-toggle="tab" data-bs-target="#panel-excepciones" type="button" role="tab"><i class="bi bi-shield-check me-1"></i>Excepciones 3 Años (@Model.HistorialExcepciones.Count)</button>
            </li>
            <li class="nav-item">
                <button class="nav-link font-semibold border-0 rounded-top-4 shadow-sm px-4 ms-2 position-relative" id="discipulado-tab" data-bs-toggle="tab" data-bs-target="#panel-discipulado" type="button" role="tab">
                    <i class="bi bi-book me-1 text-primary"></i>Discipulado LGA (5 Contactos)
                    @if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.SemaforoVigente == "ROJO")
                    {
                        <span class="badge bg-danger rounded-pill ms-1 text-xxs px-1.5 py-0.5">Riesgo</span>
                    }
                    else if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.SemaforoVigente == "AMARILLO")
                    {
                        <span class="badge bg-warning text-dark rounded-pill ms-1 text-xxs px-1.5 py-0.5">Atención</span>
                    }
                </button>
            </li>
        </ul>

        <div class="tab-content" id="tabExpedienteContent">
            <!-- Panel Maestros -->
            <div class="tab-pane fade show active" id="panel-maestros" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="font-bold text-slate-800 m-0">Maestros de Discipulado Asociados</h6>
                        <div class="d-flex gap-2">
                            @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                            {
                                <button type="button" class="btn btn-sm btn-primary shadow-sm font-semibold" data-bs-toggle="modal" data-bs-target="#modalRegistrarMaestroFicha">
                                    <i class="bi bi-plus-circle me-1"></i>Registrar Maestro
                                </button>
                            }
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre del Maestro</th>
                                    <th>Contacto</th>
                                    <th>Cédula / Identidad</th>
                                    @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                                    {
                                        <th class="text-end">Acciones</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Maestros.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No hay maestros registrados para esta iglesia.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var m in Model.Maestros)
                                    {
                                        <tr class="@(m.Activo ? "" : "opacity-75")">
                                            <td>
                                                <strong>@m.Nombres @m.Apellidos</strong>
                                                @if (!m.Activo)
                                                {
                                                    <span class="badge bg-danger ms-1" style="font-size: 0.65em;"><i class="bi bi-x-circle me-1"></i>Inhabilitado</span>
                                                }
                                            </td>
                                            <td>
                                                <div><i class="bi bi-telephone text-muted me-1"></i>@m.Celular</div>
                                                <div class="text-xs text-muted"><i class="bi bi-envelope text-muted me-1"></i>@m.Correo</div>
                                            </td>
                                            <td><span class="font-monospace">@m.DocumentoIdentidad</span></td>
                                            @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 3)
                                            {
                                                <td class="text-end">
                                                    @if (m.Activo)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Quitar Maestro" onclick="abrirModalRemoverMaestro(@m.IdMaestro, '@m.Nombres @m.Apellidos')"><i class="bi bi-trash"></i></button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Panel Oración -->
            <div class="tab-pane fade" id="panel-oracion" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="font-bold text-slate-800 m-0">Compañeros de Oración (Intercesores)</h6>
                        <a href="@Url.Action("Index", "CompanerosOracion")" class="btn btn-sm btn-outline-danger"><i class="bi bi-heart me-1"></i>Gestionar Intercesores</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre Completo</th>
                                    <th>WhatsApp</th>
                                    <th>Rango Edad</th>
                                    <th>Registrado por</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.CompanerosOracion.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No hay compañeros de oración registrados en esta temporada.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var co in Model.CompanerosOracion)
                                    {
                                        <tr>
                                            <td><strong>@co.NombreCompleto</strong></td>
                                            <td><i class="bi bi-whatsapp text-success me-1"></i>@co.ContactoWhatsApp</td>
                                            <td>@(co.EsMayorEdad ? "Mayor de edad" : "Menor de edad")</td>
                                            <td>@co.CorreoRegistrador</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Panel Historial / Línea de Tiempo -->
            <div class="tab-pane fade" id="panel-historial" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="font-bold text-slate-800 mb-3 border-bottom pb-2">Línea de Tiempo del Proceso de la Iglesia</h6>
                    @if (!Model.Historial.Any())
                    {
                        <p class="text-muted small text-center py-4">No hay eventos ni transiciones de estado registradas aún.</p>
                    }
                    else
                    {
                        <div class="timeline-track mt-3 ms-1">
                            @foreach (var h in Model.Historial)
                            {
                                <div class="timeline-item">
                                    <!-- Timeline circle -->
                                    <div class="timeline-dot"></div>
                                    
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                                        <div class="text-xs text-muted">
                                            <i class="bi bi-clock me-1"></i>@h.FechaHora.ToString("dd/MM/yyyy hh:mm tt")
                                        </div>
                                        @if (!string.IsNullOrEmpty(h.NombreTemporada))
                                        {
                                            <span class="badge bg-dark text-white text-xxs font-monospace"><i class="bi bi-calendar3 me-1"></i>@h.NombreTemporada</span>
                                        }
                                    </div>
                                    <div class="small mb-1 text-dark">
                                        <i class="bi bi-person-badge text-primary me-1"></i><strong>@h.NombreCoordinador</strong> 
                                        <span class="badge bg-info text-dark text-xxs ms-1">@h.PosicionCoordinador</span>
                                        <span class="badge bg-secondary text-white text-xxs ms-1">@h.EquipoCoordinador</span>
                                    </div>
                                    <h6 class="font-bold text-slate-800 mb-1">@h.AccionRealizada</h6>
                                    @if (!string.IsNullOrEmpty(h.EstadoAnterior) || !string.IsNullOrEmpty(h.EstadoNuevo))
                                    {
                                        <div class="text-xs mb-2">
                                            <span class="badge bg-light text-dark border">@h.EstadoAnterior</span>
                                            <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                            <span class="badge bg-success text-white">@h.EstadoNuevo</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(h.Razon))
                                    {
                                        <div class="small text-danger mb-1"><i class="bi bi-exclamation-octagon me-1"></i><strong>Razón:</strong> @h.Razon</div>
                                    }
                                    @if (!string.IsNullOrEmpty(h.Comentario))
                                    {
                                        <p class="small text-slate-600 mb-0 italic bg-light p-2 rounded">"@h.Comentario"</p>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Panel Comentarios -->
            <div class="tab-pane fade" id="panel-comentarios" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h6 class="font-bold text-slate-800 mb-3 border-bottom pb-2">Observaciones y Comentarios</h6>
                    
                    <!-- Write Comment form -->
                    <form action="@Url.Action("AgregarComentario", "Iglesia")" method="post" class="mb-4">
                        <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                        <div class="mb-3">
                            <textarea name="comentario" class="form-control" rows="3" placeholder="Escribe una observación importante..." required></textarea>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary btn-sm font-semibold px-3 shadow-sm"><i class="bi bi-chat-left-text me-1"></i>Guardar Observación</button>
                        </div>
                    </form>

                    <!-- Comments List -->
                    <div class="d-flex flex-column gap-3">
                        @if (!Model.Comentarios.Any())
                        {
                            <p class="text-muted small text-center py-3">No hay observaciones registradas aún.</p>
                        }
                        else
                        {
                            foreach (var c in Model.Comentarios)
                            {
                                <div class="p-3 border rounded bg-light mb-2 shadow-sm">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 border-bottom pb-2">
                                        <div>
                                            <i class="bi bi-person-badge text-primary me-1"></i><strong>@c.NombreCoordinador</strong> 
                                            <span class="badge bg-info text-dark text-xxs ms-1">@c.PosicionCoordinador</span>
                                            <span class="badge bg-secondary text-white text-xxs ms-1">@c.EquipoCoordinador</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(c.NombreTemporada))
                                            {
                                                <span class="badge bg-dark text-white text-xxs font-monospace"><i class="bi bi-calendar3 me-1"></i>@c.NombreTemporada</span>
                                            }
                                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@(c.FechaCreacion.HasValue ? c.FechaCreacion.Value.ToString("dd/MM/yyyy hh:mm tt") : "N/D")</small>
                                        </div>
                                    </div>
                                    <p class="small text-dark mb-0">@c.Comentario</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Panel Historial de Excepciones de 3 Años -->
            <div class="tab-pane fade" id="panel-excepciones" role="tabpanel">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                        <div>
                            <h6 class="font-bold text-slate-800 m-0"><i class="bi bi-shield-check text-primary me-2"></i>Historial de Excepciones al Requisito de 3 Años</h6>
                            <p class="text-xs text-muted mb-0">Registro y trazabilidad de solicitudes de excepción evaluadas por CE y CMI.</p>
                        </div>
                        @if (Model.RequiereExcepcion3Anios && Model.ExcepcionActiva == null && ViewBag.PuedeSolicitarExcepcion == true && Model.ParticipacionActual != null && Model.ParticipacionActual.TemporadaActiva)
                        {
                            <button type="button" class="btn btn-sm btn-primary font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSolicitarExcepcion">
                                <i class="bi bi-plus-circle me-1"></i>Nueva Solicitud
                            </button>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 text-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Temporada</th>
                                    <th>Fecha Solicitud</th>
                                    <th>Motivo y Justificación</th>
                                    <th>Aprobación CE</th>
                                    <th>Aprobación CMI</th>
                                    <th>Estado Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.HistorialExcepciones.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted small">No hay solicitudes de excepción registradas para esta iglesia.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var ex in Model.HistorialExcepciones)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-dark text-white font-monospace">@ex.NombreTemporada</span>
                                                <div class="text-xxs text-muted mt-1">Prev: @ex.NombreTemporadaPrevia (@ex.DiferenciaTemporadas temp.)</div>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold">@ex.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                                                <small class="text-muted text-xxs">Por: @ex.NombreSolicitante</small>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark text-xs">@ex.Motivo</div>
                                                <div class="text-xs text-muted text-truncate" style="max-width: 250px;" title="@ex.Justificacion">@ex.Justificacion</div>
                                                @if (!string.IsNullOrEmpty(ex.ResultadoDesempeno))
                                                {
                                                    <small class="d-block text-xxs text-info mt-1"><i class="bi bi-info-circle me-1"></i>@ex.ResultadoDesempeno</small>
                                                }
                                            </td>
                                            <td>
                                                @if (ex.AprobadoCE)
                                                {
                                                    <span class="badge bg-success-soft text-success"><i class="bi bi-check-circle me-1"></i>Aprobado</span>
                                                    <div class="text-xxs text-muted mt-1">@ex.NombreUsuarioAprobacionCE</div>
                                                    if (!string.IsNullOrEmpty(ex.ComentarioCE))
                                                    {
                                                        <div class="text-xxs text-muted fst-italic">"@ex.ComentarioCE"</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-soft text-muted"><i class="bi bi-clock me-1"></i>Pendiente</span>
                                                }
                                            </td>
                                            <td>
                                                @if (ex.AprobadoCMI)
                                                {
                                                    <span class="badge bg-success-soft text-success"><i class="bi bi-check-circle me-1"></i>Aprobado</span>
                                                    <div class="text-xxs text-muted mt-1">@ex.NombreUsuarioAprobacionCMI</div>
                                                    if (!string.IsNullOrEmpty(ex.ComentarioCMI))
                                                    {
                                                        <div class="text-xxs text-muted fst-italic">"@ex.ComentarioCMI"</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-soft text-muted"><i class="bi bi-clock me-1"></i>Pendiente</span>
                                                }
                                            </td>
                                            <td>
                                                @if (ex.Estado == "APROBADA")
                                                {
                                                    <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-circle me-1"></i>APROBADA</span>
                                                }
                                                else if (ex.Estado == "PENDIENTE")
                                                {
                                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>PENDIENTE</span>
                                                }
                                                else if (ex.Estado == "RECHAZADA")
                                                {
                                                    <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-circle me-1"></i>RECHAZADA</span>
                                                    if (!string.IsNullOrEmpty(ex.MotivoRechazo))
                                                    {
                                                        <div class="text-xxs text-danger mt-1">@ex.MotivoRechazo</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-white px-2 py-1">@ex.Estado</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Panel Discipulado LGA (5 Contactos & Capacidad) -->
            <div class="tab-pane fade" id="panel-discipulado" role="tabpanel">
                <div class="d-flex flex-column gap-4">
                    
                    <!-- 1. WIDGET DE CAPACIDAD Y RELACIÓN 26 NIÑOS / MAESTRO -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <h6 class="font-bold text-slate-800 m-0">
                                    <i class="bi bi-calculator text-primary me-2"></i>Capacidad de Discipulado LGA — Regla de Oro (26 Niños / Maestro)
                                </h6>
                                <p class="text-xs text-muted mb-0">Cada maestro capacitado debe inscribir, cuidar y graduar aproximadamente 26 niños durante el ciclo de 12 semanas.</p>
                            </div>
                            <div>
                                @if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.CapacidadSuficiente)
                                {
                                    <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill font-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Capacidad Óptima Garantizada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-soft text-warning px-3 py-2 rounded-pill font-semibold">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Requiere Más Maestros Acreditados
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="row g-3 text-center mb-3">
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold text-uppercase mb-1">Cajitas Asignadas</div>
                                    <div class="h4 font-bold text-slate-800 mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.CajitasAsignadas : 0)</div>
                                    <small class="text-xxs text-muted">Solicitud de temporada</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold text-uppercase mb-1">Maestros Acreditados</div>
                                    <div class="h4 font-bold text-primary mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.MaestrosCapacitados : 0)</div>
                                    <small class="text-xxs text-muted">Capacitados en Taller</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold text-uppercase mb-1">Capacidad de Atención</div>
                                    <div class="h4 font-bold text-info mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.CapacidadNinosAtencion : 0) <span class="text-xs font-normal">niños</span></div>
                                    <small class="text-xxs text-muted">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.MaestrosCapacitados : 0) maestros × 26</small>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold text-uppercase mb-1">Maestros Mínimos</div>
                                    <div class="h4 font-bold @(Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.MaestrosCapacitados >= Model.DiscipuladoLGA.MaestrosMinimosRequeridos ? "text-success" : "text-danger") mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.MaestrosMinimosRequeridos : 1)</div>
                                    <small class="text-xxs text-muted">Cálculo: Math.Ceiling(Cajitas / 26)</small>
                                </div>
                            </div>
                        </div>

                        @if (Model.DiscipuladoLGA != null && !Model.DiscipuladoLGA.CapacidadSuficiente)
                        {
                            <div class="alert alert-warning py-2 px-3 mb-0 d-flex align-items-center gap-2 rounded-3 text-xs">
                                <i class="bi bi-info-circle-fill flex-shrink-0 text-warning"></i>
                                <span><strong>Atención Ministerial:</strong> Se sugiere acreditar al menos <strong>@(Model.DiscipuladoLGA.MaestrosMinimosRequeridos - Model.DiscipuladoLGA.MaestrosCapacitados) maestro(s) adicional(es)</strong> para garantizar la atención personalizada de los niños durante el discipulado.</span>
                            </div>
                        }
                    </div>

                    <!-- 2. SEMÁFORO Y TARJETA DE LLAMADA RÁPIDA (5 MINUTOS) -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <h6 class="font-bold text-slate-800 m-0">
                                    <i class="bi bi-telephone-inbound text-primary me-2"></i>Acompañamiento del CD / CE — Tarjeta de Llamada (5 Minutos)
                                </h6>
                                <p class="text-xs text-muted mb-0">Conversaciones cortas que generan decisiones y multiplican impacto en el Compañero de Ministerio (CM).</p>
                            </div>
                            @if (ViewBag.PuedeGestionarDiscipulado == true && Model.ParticipacionActual != null)
                            {
                                <button type="button" class="btn btn-sm btn-primary font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRegistrarLlamadaLGA">
                                    <i class="bi bi-telephone-plus me-1"></i>Registrar Llamada (5 Min)
                                </button>
                            }
                        </div>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-4 border-end-md text-center py-2">
                                <div class="text-xs text-muted font-semibold text-uppercase mb-2">Semáforo de Acompañamiento</div>
                                @if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.SemaforoVigente == "VERDE")
                                {
                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-success-soft text-success border border-success border-opacity-25 font-bold">
                                        <i class="bi bi-check-circle-fill fs-5"></i>
                                        <span>TODO EN ORDEN (Sigan así)</span>
                                    </div>
                                }
                                else if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.SemaforoVigente == "AMARILLO")
                                {
                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-warning-soft text-warning border border-warning border-opacity-25 font-bold">
                                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                        <span>REQUIERE ATENCIÓN (Contactar pronto)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-danger-soft text-danger border border-danger border-opacity-25 font-bold">
                                        <i class="bi bi-x-octagon-fill fs-5"></i>
                                        <span>ACCIÓN INMEDIATA (Riesgo alto)</span>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <div class="p-3 bg-light rounded-3 text-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted fw-semibold">Última Llamada Registrada:</span>
                                        <strong>@(Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.FechaUltimaLlamada.HasValue ? Model.DiscipuladoLGA.FechaUltimaLlamada.Value.ToString("dd/MM/yyyy hh:mm tt") : "Sin llamadas registradas aún")</strong>
                                    </div>
                                    <div class="text-muted">
                                        <strong>Última Acción Acordada:</strong> @(Model.DiscipuladoLGA != null && !string.IsNullOrEmpty(Model.DiscipuladoLGA.UltimaAccionAcordada) ? Model.DiscipuladoLGA.UltimaAccionAcordada : "No se ha registrado una acción acordada reciente.")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. EMBUDO REAL DE DISCIPULADO LGA (DE PORCENTAJES A NÚMEROS REALES) -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <h6 class="font-bold text-slate-800 m-0">
                                    <i class="bi bi-funnel text-primary me-2"></i>Embudo de Discipulado Real — De Números a Vidas Transformadas
                                </h6>
                                <p class="text-xs text-muted mb-0">Seguimiento intencional del recorrido de cada cajita entregada hasta su graduación.</p>
                            </div>
                        </div>

                        <div class="row g-3 text-center">
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold mb-1">1. Cajitas Despachadas</div>
                                    <div class="h4 font-bold text-primary mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.CajitasAsignadas : 0)</div>
                                    <div class="text-xxs text-muted">100% Base Inicial</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold mb-1">2. Niños Inscritos</div>
                                    <div class="h4 font-bold text-info mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.NinosInscritos : 0)</div>
                                    <div class="text-xxs text-muted">Semanas 1 a 3 (Contacto #2)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold mb-1">3. Asistencia Promedio</div>
                                    <div class="h4 font-bold text-warning mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.NinosAsistenciaPromedio : 0)</div>
                                    <div class="text-xxs text-muted">Semanas 4 a 9 (Contacto #3)</div>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="text-xs text-muted font-semibold mb-1">4. Niños Graduados</div>
                                    <div class="h4 font-bold text-success mb-0">@(Model.DiscipuladoLGA != null ? Model.DiscipuladoLGA.NinosGraduados : 0)</div>
                                    <div class="text-xxs text-muted">Semanas 10 a 12 (Contacto #4)</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. GUÍA SIMPLIFICADA: LOS 5 CONTACTOS CON EL COMPAÑERO DE MINISTERIO (CM) -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                            <div>
                                <h6 class="font-bold text-slate-800 m-0">
                                    <i class="bi bi-chat-square-dots text-primary me-2"></i>Guía Simplificada de los 5 Contactos con CMs
                                </h6>
                                <p class="text-xs text-muted mb-0">Principio: Cada llamada o mensaje debe terminar con una decisión, no con un checklist.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            @if (Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.Contactos != null)
                            {
                                foreach (var c in Model.DiscipuladoLGA.Contactos.OrderBy(x => x.NumeroContacto))
                                {
                                    string cardBorder = c.EstadoContacto == "COMPLETADO" ? "border-success" : (c.EstadoContacto == "REQUIERE_ATENCION" ? "border-warning" : "border-slate-200");
                                    string badgeColor = c.EstadoContacto == "COMPLETADO" ? "bg-success" : (c.EstadoContacto == "REQUIERE_ATENCION" ? "bg-warning text-dark" : "bg-secondary");

                                    <div class="col-12">
                                        <div class="card border @cardBorder rounded-3 shadow-sm p-3">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-primary rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">@c.NumeroContacto</span>
                                                    <div>
                                                        <h6 class="font-bold text-slate-800 mb-0">Contacto @c.NumeroContacto: @c.NombreFase</h6>
                                                        <span class="text-xxs text-muted"><i class="bi bi-calendar-event me-1"></i>@c.PeriodoAgenda</span>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge @badgeColor px-2.5 py-1 text-xxs font-semibold">@c.EstadoContacto</span>
                                                    @if (ViewBag.PuedeGestionarDiscipulado == true && Model.ParticipacionActual != null)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2 text-xs font-semibold" onclick="abrirModalEditarContacto(@c.NumeroContacto, '@c.NombreFase', '@c.PeriodoAgenda', '@c.PreguntaClave', '@c.DatoMinimo1Label', '@c.DatoMinimo1', '@c.DatoMinimo2Label', '@c.DatoMinimo2', '@c.DatoMinimo3Label', '@c.DatoMinimo3', '@c.DecisionTomada', '@c.ComentarioAccion', '@c.EstadoContacto')">
                                                            <i class="bi bi-pencil-square me-1"></i>Editar / Registrar
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <div class="bg-light rounded p-2 mb-2 text-xs">
                                                <div class="text-primary font-semibold mb-1"><i class="bi bi-question-circle me-1"></i>Pregunta Clave: <em>"@c.PreguntaClave"</em></div>
                                                <div class="row g-2 text-slate-700">
                                                    @if (!string.IsNullOrEmpty(c.DatoMinimo1Label))
                                                    {
                                                        <div class="col-md-4">
                                                            <strong>@c.DatoMinimo1Label:</strong> @(string.IsNullOrEmpty(c.DatoMinimo1) ? "—" : c.DatoMinimo1)
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(c.DatoMinimo2Label))
                                                    {
                                                        <div class="col-md-4">
                                                            <strong>@c.DatoMinimo2Label:</strong> @(string.IsNullOrEmpty(c.DatoMinimo2) ? "—" : c.DatoMinimo2)
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(c.DatoMinimo3Label))
                                                    {
                                                        <div class="col-md-4">
                                                            <strong>@c.DatoMinimo3Label:</strong> @(string.IsNullOrEmpty(c.DatoMinimo3) ? "—" : c.DatoMinimo3)
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 text-xs pt-1 border-top">
                                                <div>
                                                    <strong>Decisión / Estado:</strong> <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(c.DecisionTomada) ? "Pendiente de contacto" : c.DecisionTomada)</span>
                                                    @if (!string.IsNullOrEmpty(c.ComentarioAccion))
                                                    {
                                                        <span class="ms-2 text-muted fst-italic">"@c.ComentarioAccion"</span>
                                                    }
                                                </div>
                                                <div class="text-muted text-xxs">
                                                    @(c.FechaContacto.HasValue ? $"Registrado: {c.FechaContacto.Value.ToString("dd/MM/yyyy")} por {c.NombreUsuarioContacto ?? "Coordinador"}" : "Aún no ejecutado")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- 5. HISTORIAL DE BITÁCORA DE LLAMADAS RÁPIDAS -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 border-bottom pb-2">
                            <h6 class="font-bold text-slate-800 m-0"><i class="bi bi-clock-history text-primary me-2"></i>Historial de Llamadas de Acompañamiento (5 Minutos)</h6>
                            <span class="badge bg-light text-dark border">@(Model.DiscipuladoLGA != null && Model.DiscipuladoLGA.BitacoraLlamadas != null ? Model.DiscipuladoLGA.BitacoraLlamadas.Count : 0) registros</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha / Hora</th>
                                        <th>Coordinador</th>
                                        <th>Etapa / Enfoque</th>
                                        <th>Obstáculo y Apoyo</th>
                                        <th>Acción Acordada</th>
                                        <th class="text-center">Semáforo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.DiscipuladoLGA == null || !Model.DiscipuladoLGA.BitacoraLlamadas.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted small">No hay llamadas registradas en la bitácora aún.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var ll in Model.DiscipuladoLGA.BitacoraLlamadas)
                                        {
                                            string badgeSem = ll.SemaforoEstado == "VERDE" ? "bg-success" : (ll.SemaforoEstado == "AMARILLO" ? "bg-warning text-dark" : "bg-danger");
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold small">@ll.FechaHora.ToString("dd/MM/yyyy")</div>
                                                    <small class="text-muted text-xxs">@ll.FechaHora.ToString("hh:mm tt") (@ll.DuracionMinutos min)</small>
                                                </td>
                                                <td><span class="small font-bold">@ll.NombreCoordinador</span></td>
                                                <td>
                                                    <div class="small fw-semibold">@ll.EtapaDiscipulado</div>
                                                    <span class="badge bg-light text-muted border text-xxs">@ll.EnfoqueAplicado</span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(ll.ObstaculoReportado))
                                                    {
                                                        <div class="text-xs text-danger"><i class="bi bi-exclamation-circle me-1"></i>@ll.ObstaculoReportado</div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ll.ApoyoRequerido))
                                                    {
                                                        <div class="text-xs text-primary"><i class="bi bi-life-preserver me-1"></i>Apoyo: @ll.ApoyoRequerido</div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="text-xs text-dark fw-medium">@ll.AccionAcordada</div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge @badgeSem px-2.5 py-1 text-xxs font-bold">@ll.SemaforoEstado</span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================================
     MODALES PARA TRANSICIONES DE ETAPAS (APROBACIONES/RECHAZOS)
     ============================================================================ -->

@if (Model.ParticipacionActual != null)
{
    var p = Model.ParticipacionActual;

    <!-- MODAL 2.A: APROBAR EVALUACIÓN INICIAL -->
    <div class="modal fade" id="modalAprobarEvalInicial" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("EvaluarInicial", "Iglesia")" method="post">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    <input type="hidden" name="estado" value="Aprobada" />
                    
                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-check-circle me-2 text-success"></i>Aprobar Evaluación Inicial</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios de Aprobación</label>
                            <textarea name="comentario" class="form-control" rows="3" placeholder="Comentarios o notas de la evaluación de la iglesia..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success font-semibold">Aprobar Evaluación</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL GLOBAL: DETENER PROCESO -->
    <div class="modal fade" id="modalDetenerProcesoGlobal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("DetenerProceso", "Iglesia")" method="post" class="needs-validation" novalidate onsubmit="if(!this.checkValidity()){this.classList.add('was-validated'); return false;}">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    
                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold text-white"><i class="bi bi-pause-circle me-2 text-warning"></i>Detener Proceso de la Iglesia</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="small text-slate-600 mb-3">El proceso de participación será puesto en pausa y la iglesia no avanzará a la siguiente etapa hasta que un coordinador decida reabrir el proceso.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Motivo principal (Obligatorio)</label>
                            <input type="text" name="motivo" class="form-control" placeholder="Ej: Falta de documentación, requiere verificación..." required />
                            <div class="invalid-feedback">Por favor, escriba el motivo principal para detener el proceso.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios Detallados (Opcional)</label>
                            <textarea name="comentario" class="form-control" rows="3" placeholder="Notas adicionales sobre el caso..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning font-semibold text-white">Confirmar Detención</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL GLOBAL: REABRIR PROCESO -->
    <div class="modal fade" id="modalReabrirProcesoGlobal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("ReabrirProceso", "Iglesia")" method="post" class="needs-validation" novalidate onsubmit="if(!this.checkValidity()){this.classList.add('was-validated'); return false;}">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    
                    <div class="modal-header bg-success text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-arrow-counterclockwise me-2"></i>Reabrir Proceso</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="small text-slate-600 mb-3">Estás a punto de reanudar el proceso de esta iglesia. Será restituida a la etapa anterior para continuar su ciclo de participación.</p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Justificación de la Reapertura (Obligatorio)</label>
                            <textarea name="comentario" class="form-control" rows="3" placeholder="Ej: Documentación completada, información validada, etc." required></textarea>
                            <div class="invalid-feedback">Debe proporcionar un comentario que justifique esta acción.</div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success font-semibold">Confirmar Reapertura</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2.B: RECHAZAR EVALUACIÓN INICIAL -->
