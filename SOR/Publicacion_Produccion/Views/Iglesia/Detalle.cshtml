        background-color: rgba(2, 132, 199, 0.15) !important;
        color: #0369a1 !important;
    }
    .badge.bg-info-soft {
        background-color: rgba(13, 148, 136, 0.15) !important;
        color: #0f766e !important;
    }
    .badge.bg-success-soft {
        background-color: rgba(25, 135, 84, 0.15) !important;
        color: #198754 !important;
    }
</style>

<!-- MODAL CAMBIAR ESTATUS REPORTE -->
<div class="modal fade" id="modalCambiarEstatusReporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("CambiarEstatusReporte", "Iglesia")" method="post" class="needs-validation" novalidate onsubmit="if(!this.checkValidity()){this.classList.add('was-validated'); return false;}">
                @if (Model.ParticipacionActual != null)
                {
                    <input type="hidden" name="idParticipacion" value="@Model.ParticipacionActual.IdParticipacion" />
                }
                <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold"><i class="bi bi-pencil-square me-2"></i>Cambiar Estatus de Reporte</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small text-slate-600 mb-3">Modifica el estatus de evaluación exclusivo para reportes de esta iglesia.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estatus de Evaluación (Reporte)</label>
                        <select name="estatusEvaluacionReporte" class="form-select" required>
                            <option value="">Seleccione...</option>
                            <option value="Pendiente" @(Model.ParticipacionActual != null && Model.ParticipacionActual.EstatusEvaluacionReporte == "Pendiente" ? "selected" : "")>Pendiente</option>
                            <option value="Reportó" @(Model.ParticipacionActual != null && Model.ParticipacionActual.EstatusEvaluacionReporte == "Reportó" ? "selected" : "")>Reportó</option>
                            <option value="No Reportó" @(Model.ParticipacionActual != null && Model.ParticipacionActual.EstatusEvaluacionReporte == "No Reportó" ? "selected" : "")>No Reportó</option>
                            <option value="Castigada" @(Model.ParticipacionActual != null && Model.ParticipacionActual.EstatusEvaluacionReporte == "Castigada" ? "selected" : "")>Castigada</option>
                        </select>
                        <div class="invalid-feedback">Debe seleccionar un estatus.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comentarios / Notas</label>
                        <textarea name="comentario" class="form-control" rows="2" placeholder="Opcional. Escriba un comentario sobre este cambio..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-dark font-semibold">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================================
     MODALES PARA EXCEPCIÓN A LA REGLA DE 3 AÑOS (SOLICITAR, CE, CMI, RECHAZAR)
     ============================================================================ -->

<!-- MODAL SOLICITAR EXCEPCIÓN -->
<div class="modal fade" id="modalSolicitarExcepcion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <form action="@Url.Action("SolicitarExcepcion3Anios", "Iglesia")" method="post" class="needs-validation" novalidate onsubmit="if(!this.checkValidity()){this.classList.add('was-validated'); return false;}">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                <input type="hidden" name="idTemporada" value="@(Model.ParticipacionActual != null ? Model.ParticipacionActual.IdTemporada : 0)" />
                <input type="hidden" name="temporadaPreviaId" value="@Model.IdTemporadaPrevia" />
                <input type="hidden" name="diferenciaTemporadas" value="@Model.DiferenciaAniosAntiguedad" />
                <input type="hidden" name="resultadoDesempeno" value="@(Model.DesempenoHistorico != null ? Model.DesempenoHistorico.ResumenTexto : "")" />

                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
