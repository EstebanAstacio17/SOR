@model IEnumerable<SOR.Models.MovimientoInventario>
@{
    ViewBag.Title = "Kárdex de Movimientos — Logística OCC";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var materiales = ViewBag.Materiales as IEnumerable<SOR.Models.Material> ?? new List<SOR.Models.Material>();
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-1"><i class="bi bi-journal-text me-2" style="color:var(--apple-accent)"></i>Kárdex de Movimientos</h1>
            <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Logistica")">Logística</a></li>
                <li class="breadcrumb-item active">Kárdex</li>
            </ol></nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex gap-3 align-items-center flex-wrap">
            <h6 class="mb-0 fw-semibold me-auto">Trazabilidad de Movimientos de Inventario</h6>
            <input type="text" id="filtroKardex" class="form-control form-control-sm" style="max-width:240px" placeholder="Buscar..." />
            <select id="filtroTipo" class="form-select form-select-sm" style="max-width:200px">
                <option value="">— Todos los tipos —</option>
                <option value="RECEPCION_CONTENEDOR">Recepción Contenedor</option>
                <option value="TRANSFERENCIA_EQUIPO">Transferencia Equipo</option>
                <option value="DESPACHO_IGLESIA">Despacho Iglesia</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-sm" id="tablaKardex">
                <thead class="table-light">
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Tipo</th>
                        <th>Material</th>
                        <th class="text-center">Cantidad</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Referencia</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-journal-x fs-2 d-block mb-2"></i>No hay movimientos registrados en esta temporada
                        </td></tr>
                    }
                    @foreach (var m in Model)
                    {
                        string tipoColor = m.TipoMovimiento == "RECEPCION_CONTENEDOR" ? "bg-primary" :
                                           m.TipoMovimiento == "TRANSFERENCIA_EQUIPO" ? "bg-warning text-dark" :
                                           m.TipoMovimiento == "DESPACHO_IGLESIA" ? "bg-success" : "bg-secondary";
                        string destino = !string.IsNullOrEmpty(m.NombreAlmacenDestino) ? m.NombreAlmacenDestino :
                                         !string.IsNullOrEmpty(m.NombreEquipoDestino) ? "Equipo: " + m.NombreEquipoDestino :
                                         !string.IsNullOrEmpty(m.NombreIglesia) ? "Iglesia: " + m.NombreIglesia : "—";
                        <tr data-tipo="@m.TipoMovimiento" data-busq="@m.NombreMaterial @m.TipoMovimiento @m.NombreIglesia @m.NombreEquipoDestino @m.IdDocumentoReferencia">
                            <td class="text-muted small">@m.FechaHora.ToString("dd/MM/yy HH:mm")</td>
                            <td><span class="badge @tipoColor small">@m.TipoMovimiento.Replace("_", " ")</span></td>
                            <td><span class="badge bg-primary me-1">@m.CodigoMaterial</span><span class="small">@m.NombreMaterial</span></td>
                            <td class="text-center fw-semibold">@m.Cantidad.ToString("N0")</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(m.NombreAlmacenOrigen) ? "—" : m.NombreAlmacenOrigen)</td>
                            <td class="small">@destino</td>
                            <td><code class="small">@m.IdDocumentoReferencia</code></td>
                            <td class="text-muted small">@m.CorreoUsuario</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var filtroText = document.getElementById('filtroKardex');
    var filtroTipo = document.getElementById('filtroTipo');

    function filtrar() {
        var texto = filtroText.value.toLowerCase();
        var tipo = filtroTipo.value;
        document.querySelectorAll('#tablaKardex tbody tr[data-tipo]').forEach(function (tr) {
            var matchTexto = tr.dataset.busq.toLowerCase().includes(texto);
            var matchTipo = !tipo || tr.dataset.tipo === tipo;
            tr.style.display = (matchTexto && matchTipo) ? '' : 'none';
        });
    }

    filtroText.addEventListener('input', filtrar);
    filtroTipo.addEventListener('change', filtrar);
})();
</script>
}
