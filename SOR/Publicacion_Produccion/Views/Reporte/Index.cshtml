@model IEnumerable<SOR.Models.ReporteEvento>
@{
    ViewBag.Title = "Reportes y Estadísticas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h3 font-bold text-slate-800 mb-1"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Reportes de Eventos y La Gran Aventura</h2>
        <p class="text-muted mb-0">Consolidado de asistencia de niños, decisiones por Cristo y graduados de discipulado.</p>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-light border-0 p-3">
        <h3 class="h5 font-bold mb-0 text-slate-800"><i class="bi bi-journal-text me-2 text-primary"></i>Historial de Reportes Ingresados</h3>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tipo de Reporte</th>
                        <th>Fecha Evento</th>
                        <th>Niños Asistentes</th>
                        <th>Aceptaron al Señor</th>
                        <th>Graduados Gran Aventura</th>
                        <th>Adjunto</th>
                        <th class="text-end pe-4">Fecha Carga</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-slate-400"></i>
                                No hay reportes ingresados para esta temporada.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge @(item.TipoReporte == "GranAventura" ? "bg-indigo text-white" : "bg-primary")" style="background: #4f46e5;">
                                        @item.TipoReporte
                                    </span>
                                </td>
                                <td>@(item.Fecha.HasValue ? item.Fecha.Value.ToString("dd/MM/yyyy") : "N/D")</td>
                                <td><strong class="text-dark fs-6">@item.CantidadNinos</strong></td>
                                <td><strong class="text-success fs-6">@item.CuantosAceptaronSenor</strong></td>
                                <td><strong class="text-indigo fs-6" style="color: #4f46e5;">@item.CuantosGraduaron</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ReporteAdjuntoRuta))
                                    {
                                        <a href="@item.ReporteAdjuntoRuta" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-arrow-down me-1"></i>Ver Reporte
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin adjunto</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <small class="text-muted">@(item.FechaCreacion.HasValue ? item.FechaCreacion.Value.ToString("dd/MM/yyyy") : "")</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
