@{
    Layout = null;
}

<!doctype html>
<html lang="es" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar Contraseña | SOR</title>

    <!-- Bootstrap 5 (local) -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- CSS propio -->
    <link href="~/Content/css/Login.css" rel="stylesheet" />
</head>

<body class="d-flex align-items-center py-4 bg-body-tertiary">
    <main class="form-signin w-100 m-auto">
        <form action="@Url.Action("RecuperarClave", "Acceso")" method="post">
            <!-- LOGO -->
            <img src="~/Content/css/Imgs/OCC-logo.png" class="logo-login" alt="Logo">

            <!-- TITULO -->
            <h1 class="h3 mb-3 fw-normal text-center">
                Recuperar Contraseña
            </h1>
            <p class="text-muted text-center small mb-4">
                Ingresa tu correo electrónico registrado y enviaremos una solicitud de restablecimiento al administrador del sistema para su aprobación.
            </p>

            <!-- CORREO -->
            <div class="form-floating mb-3">
                <input type="email" name="Correo" class="form-control" id="floatingInput" placeholder="correo@ejemplo.com" required>
                <label for="floatingInput">Correo electrónico</label>
            </div>

            <!-- MENSAJES -->
            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger mt-3 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewData["Mensaje"]
                </div>
            }

            <!-- BOTONES -->
            <button class="btn btn-primary w-100 py-2 mt-2" type="submit">
                <i class="bi bi-send-fill me-1"></i> Solicitar Restablecimiento
            </button>

            <!-- RETORNAR -->
            <div class="text-center mt-4">
                <a href="@Url.Action("Login", "Acceso")" class="text-decoration-none small text-slate-400">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Login
                </a>
            </div>

            <p class="mt-5 mb-3 text-body-secondary text-center">
                &copy; @DateTime.Now.Year - SOR | Powered by PortaForza
            </p>
        </form>
    </main>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</body>
</html>
