@model SOR.Models.SolicitudUsuarioViewModel
@{
    Layout = null;
    var perfil = Model?.Perfil ?? new SOR.Models.PerfilCoordinador();
    string nombreCompleto = $"{perfil.PrimerNombre} {perfil.OtrosNombres} {perfil.PrimerApellido} {perfil.OtrosApellidos}".Trim();
    if (string.IsNullOrWhiteSpace(nombreCompleto)) { nombreCompleto = "Sin Nombre Registrado"; }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Imprimir Perfil - @nombreCompleto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 13px; background-color: #fff; color: #333; }
        .print-header { border-bottom: 2px solid #003580; padding-bottom: 10px; margin-bottom: 20px; }
        .section-title { font-size: 1.1rem; color: #003580; border-bottom: 1px solid #dee2e6; padding-bottom: 4px; margin-bottom: 12px; margin-top: 20px; font-weight: bold; }
        .data-row { margin-bottom: 8px; }
        .data-label { font-weight: 600; color: #555; }
        .document-preview img { max-width: 100%; max-height: 450px; height: auto; margin-top: 8px; border: 1px solid #ccc; border-radius: 4px; }
        @media print {
            .no-print { display: none !important; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="container my-3">
        <div class="text-end mb-3 no-print">
            <button class="btn btn-primary" onclick="window.print()">🖨️ Imprimir Ahora</button>
            <button class="btn btn-secondary" onclick="window.close()">Cerrar</button>
        </div>

        <div class="print-header text-center">
            <h2 class="mb-1" style="color:#003580;font-weight:700;">Expediente de Coordinador - OCC República Dominicana</h2>
            <p class="text-muted mb-0 small">Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="row mb-3 align-items-center bg-light p-3 rounded border">
            <div class="col-md-2 text-center">
                @if (!string.IsNullOrEmpty(perfil.FotoRuta))
                {
                    <img src="@Url.Action("VerAdjunto", "Admin", new { id = Model.IdUsuario, tipo = "foto" })" alt="Foto" class="img-thumbnail" style="max-height: 120px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                    <div class="bg-white border text-muted align-items-center justify-content-center" style="display:none; height: 120px; width: 120px; margin: 0 auto; line-height: 120px;">Sin Foto</div>
                }
                else
                {
                    <div class="bg-white border text-muted d-flex align-items-center justify-content-center" style="height: 120px; width: 120px; margin: 0 auto;">Sin Foto</div>
                }
            </div>
            <div class="col-md-10">
                <h3 class="font-weight-bold mb-1" style="color:#003580;">@nombreCompleto</h3>
                <p class="mb-1"><strong>Equipo Asignado:</strong> @(string.IsNullOrEmpty(perfil.NombreEquipo) ? "Sin Asignar" : perfil.NombreEquipo)</p>
                <p class="mb-1"><strong>Posición / Rol:</strong> @(string.IsNullOrEmpty(perfil.NombrePosicion) ? "Sin Asignar" : perfil.NombrePosicion)</p>
                <p class="mb-0"><strong>Correo:</strong> @(string.IsNullOrEmpty(Model.Correo) ? "N/D" : Model.Correo)</p>
            </div>
        </div>

        <h4 class="section-title">1. Datos Personales e Identidad</h4>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Fecha de Nacimiento:</span> @(perfil.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "N/D")</div>
            <div class="col-6"><span class="data-label">Sexo:</span> @(string.IsNullOrEmpty(perfil.Sexo) ? "N/D" : perfil.Sexo)</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Estado Civil:</span> @(string.IsNullOrEmpty(perfil.EstadoCivil) ? "N/D" : perfil.EstadoCivil)</div>
            <div class="col-6"><span class="data-label">Nacionalidad:</span> @(string.IsNullOrEmpty(perfil.Nacionalidad) ? "N/D" : perfil.Nacionalidad)</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Número de Documento (Cédula):</span> @(string.IsNullOrEmpty(perfil.NumeroDocumento) ? "N/D" : perfil.NumeroDocumento)</div>
            <div class="col-6"><span class="data-label">Número de Pasaporte:</span> @(string.IsNullOrEmpty(perfil.NumeroPasaporte) ? (perfil.NoPoseePasaporte ? "No posee" : "N/D") : perfil.NumeroPasaporte)</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Talla de Camisa:</span> @(string.IsNullOrEmpty(perfil.Talla) ? "N/D" : perfil.Talla)</div>
        </div>

        <h4 class="section-title">2. Información de Contacto y Dirección</h4>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Teléfono Fijo:</span> @(string.IsNullOrEmpty(perfil.TelefonoFijo) ? "N/D" : perfil.TelefonoFijo)</div>
            <div class="col-6"><span class="data-label">Celular / WhatsApp:</span> @(string.IsNullOrEmpty(perfil.TelefonoCelularWhatsApp) ? "N/D" : perfil.TelefonoCelularWhatsApp)</div>
        </div>
        <div class="row data-row">
            <div class="col-12"><span class="data-label">Dirección:</span> @perfil.Calle #@perfil.Numero, @perfil.Sector, @perfil.Ciudad, @perfil.Provincia, @perfil.Pais</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Datos del Cónyuge:</span> @(string.IsNullOrEmpty(perfil.DatosConyugue) ? "N/D" : perfil.DatosConyugue)</div>
            <div class="col-6"><span class="data-label">Contacto de Emergencia:</span> @(string.IsNullOrEmpty(perfil.ContactoEmergencia) ? "N/D" : perfil.ContactoEmergencia)</div>
        </div>

        <h4 class="section-title">3. Información Ministerial</h4>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Iglesia Local:</span> @(string.IsNullOrEmpty(perfil.IglesiaLocal) ? "N/D" : perfil.IglesiaLocal)</div>
            <div class="col-6"><span class="data-label">Pastor:</span> @(string.IsNullOrEmpty(perfil.PastorIglesiaLocal) ? "N/D" : perfil.PastorIglesiaLocal)</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Cargo en la Iglesia:</span> @(string.IsNullOrEmpty(perfil.CargoIglesiaLocal) ? "N/D" : perfil.CargoIglesiaLocal)</div>
            <div class="col-6"><span class="data-label">Años de Servicio:</span> @(perfil.AniosServicioMinisterial.HasValue ? perfil.AniosServicioMinisterial.Value.ToString() : "N/D")</div>
        </div>
        <div class="row data-row">
            <div class="col-12"><span class="data-label">Detalles Ministeriales:</span> @(string.IsNullOrEmpty(perfil.InfoMinisterial) ? "N/D" : perfil.InfoMinisterial)</div>
        </div>

        <h4 class="section-title">4. Educación, Trabajo y Capacitaciones OCC</h4>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Nivel Educativo:</span> @(string.IsNullOrEmpty(perfil.NivelEducativo) ? "N/D" : perfil.NivelEducativo)</div>
            <div class="col-6"><span class="data-label">Profesión / Carrera:</span> @(string.IsNullOrEmpty(perfil.ProfesionCarrera) ? "N/D" : perfil.ProfesionCarrera)</div>
        </div>
        <div class="row data-row">
            <div class="col-12"><span class="data-label">Información Educativa Adicional:</span> @(string.IsNullOrEmpty(perfil.InfoEducativa) ? "N/D" : perfil.InfoEducativa)</div>
        </div>
        <div class="row data-row">
            <div class="col-6"><span class="data-label">Ocupación / Empresa:</span> @(string.IsNullOrEmpty(perfil.OcupacionEmpresaLaboral) ? "N/D" : perfil.OcupacionEmpresaLaboral)</div>
            <div class="col-6"><span class="data-label">Teléfono de Trabajo:</span> @(string.IsNullOrEmpty(perfil.TelefonoTrabajo) ? "N/D" : perfil.TelefonoTrabajo)</div>
        </div>
        <div class="row data-row">
            <div class="col-12"><span class="data-label">Información Laboral Adicional:</span> @(string.IsNullOrEmpty(perfil.InfoLaboral) ? "N/D" : perfil.InfoLaboral)</div>
        </div>
        <div class="row data-row">
            <div class="col-12"><span class="data-label">Capacitaciones OCC Anteriores:</span> @(string.IsNullOrEmpty(perfil.CapacitacionesOCC) ? "N/D" : perfil.CapacitacionesOCC)</div>
        </div>

        <!-- Se imprimen los documentos si están disponibles -->
        <div class="page-break"></div>
        <h4 class="section-title">Anexos: Documentos Adjuntos</h4>
        
        <div class="row">
            <div class="col-12 mb-4 document-preview">
                <h5>Documento de Identidad (Cédula)</h5>
                @if (!string.IsNullOrEmpty(perfil.DocumentoAdjuntoRuta))
                {
                    if (perfil.DocumentoAdjuntoRuta.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <p class="text-muted">El documento es un PDF. <a href="@Url.Action("VerAdjunto", "Admin", new { id = Model.IdUsuario, tipo = "cedula" })" target="_blank" class="no-print btn btn-sm btn-outline-primary ms-2">Abrir / Descargar PDF</a></p>
                    }
                    else
                    {
                        <img src="@Url.Action("VerAdjunto", "Admin", new { id = Model.IdUsuario, tipo = "cedula" })" alt="Cédula" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <p class="text-muted small fst-italic" style="display:none;">Archivo de imagen no disponible físicamente en el almacenamiento.</p>
                    }
                }
                else
                {
                    <p class="text-muted">No se adjuntó Cédula.</p>
                }
            </div>

            <div class="col-12 mb-4 document-preview">
                <h5>Pasaporte</h5>
                @if (!string.IsNullOrEmpty(perfil.PasaporteAdjuntoRuta))
                {
                    if (perfil.PasaporteAdjuntoRuta.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <p class="text-muted">El documento es un PDF. <a href="@Url.Action("VerAdjunto", "Admin", new { id = Model.IdUsuario, tipo = "pasaporte" })" target="_blank" class="no-print btn btn-sm btn-outline-primary ms-2">Abrir / Descargar PDF</a></p>
                    }
                    else
                    {
                        <img src="@Url.Action("VerAdjunto", "Admin", new { id = Model.IdUsuario, tipo = "pasaporte" })" alt="Pasaporte" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <p class="text-muted small fst-italic" style="display:none;">Archivo de imagen no disponible físicamente en el almacenamiento.</p>
                    }
                }
                else
                {
                    <p class="text-muted">@(perfil.NoPoseePasaporte ? "El coordinador indicó que no posee pasaporte." : "No se adjuntó Pasaporte.")</p>
                }
            </div>
        </div>
    </div>
</body>
</html>
