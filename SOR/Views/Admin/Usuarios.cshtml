@model IEnumerable<SOR.Models.SolicitudUsuarioViewModel>
@{
    ViewBag.Title = "Gestión de Usuarios y Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listaRoles = (List<SelectListItem>)ViewBag.ListaRolesAdmin ?? new List<SelectListItem>();
    var listaEstados = (List<SelectListItem>)ViewBag.ListaEstadosAdmin ?? new List<SelectListItem>();
    var listaEquipos = (List<SelectListItem>)ViewBag.ListaEquiposAdmin ?? new List<SelectListItem>();
    var listaPosiciones = (List<SelectListItem>)ViewBag.ListaPosicionesAdmin ?? new List<SelectListItem>();
    var uActual = (SOR.Models.Usuario)ViewBag.UsuarioActual;
}

<style>
    .table-premium th {
        font-weight: 600;
        font-size: 0.78rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding-top: 14px;
        padding-bottom: 14px;
    }
    .table-premium td {
        padding-top: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.9rem;
    }
    .badge-soft {
        font-weight: 600;
        font-size: 0.72rem;
        padding: 5px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid transparent;
    }
    .badge-soft-warning { background-color: #fffbeb; color: #b45309; border-color: #fde68a; }
    .badge-soft-info { background-color: #f0f9ff; color: #0369a1; border-color: #bae6fd; }
    .badge-soft-primary { background-color: #eef2ff; color: #4338ca; border-color: #c7d2fe; }
    .badge-soft-success { background-color: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
    .badge-soft-danger { background-color: #fef2f2; color: #b91c1c; border-color: #fecaca; }
    .badge-soft-secondary { background-color: #f8fafc; color: #475569; border-color: #e2e8f0; }

    .badge-rol {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 4px 8px;
        border-radius: 6px;
    }
    
    .btn-action-dropdown {
        border: 1px solid #cbd5e1;
        background-color: #ffffff;
        color: #334155;
        font-weight: 500;
        font-size: 0.82rem;
        padding: 6px 12px;
        border-radius: 6px;
        transition: all 0.2s;
    }
    .btn-action-dropdown:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }
    .dropdown-menu-premium {
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
        border-radius: 8px;
        padding: 6px;
    }
    .dropdown-menu-premium .dropdown-item {
        font-size: 0.85rem;
        padding: 7px 12px;
        border-radius: 6px;
        color: #334155;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .dropdown-menu-premium .dropdown-item:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .text-nowrap-th {
        white-space: nowrap;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="h3 font-bold mb-1 text-slate-800"><i class="bi bi-people-fill text-primary me-2"></i>Gestión de Usuarios y Permisos</h2>
        <p class="text-muted mb-0">Revisa expedientes, aprueba solicitudes, administra estados y asigna roles/posiciones en los equipos OCC RD.</p>
    </div>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-2">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="buscarUsuarioInput" class="form-control bg-light border-start-0" placeholder="Buscar..." onkeyup="filtrarTablaUsuarios()">
                </div>
            </div>
            <div class="col-md-2">
                <select id="filtroEquipoUsuario" class="form-select bg-light text-truncate" onchange="onFilterChange('filtroEquipoUsuario')">
                    <option value="">Equipos (Todos)</option>
                    @foreach (var eq in listaEquipos) { 
                        <option value="@(eq.Text.Contains("] ") ? eq.Text.Substring(eq.Text.IndexOf("] ") + 2) : eq.Text)">@eq.Text</option> 
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="filtroEstadoUsuario" class="form-select bg-light text-truncate" onchange="onFilterChange('filtroEstadoUsuario')">
                    <option value="">Estados (Todos)</option>
                    @foreach (var est in listaEstados) { <option value="@est.Text">@est.Text</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select id="filtroRolOCCUsuario" class="form-select bg-light text-truncate" onchange="onFilterChange('filtroRolOCCUsuario')">
                    <option value="">Rol OCC (Todos)</option>
                    @foreach (var pos in listaPosiciones) { <option value="@pos.Text">@pos.Text</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select id="filtroRolSeguridadUsuario" class="form-select bg-light text-truncate" onchange="onFilterChange('filtroRolSeguridadUsuario')">
                    <option value="">Seguridad (Todos)</option>
                    @foreach (var rol in listaRoles) { <option value="@rol.Text">@rol.Text</option> }
                </select>
            </div>
            <div class="col-md-2 d-flex">
                <button class="btn btn-outline-secondary w-100 text-truncate" type="button" onclick="limpiarFiltrosUsuarios()">
                    <i class="bi bi-eraser me-1"></i>Limpiar
                </button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-premium align-middle mb-0" id="tablaUsuarios">
                <thead>
                    <tr>
                        <th class="ps-4 text-nowrap-th">Usuario / Correo</th>
                        <th class="text-nowrap-th">Coordinador</th>
                        <th class="text-nowrap-th">Equipo y Rol OCC</th>
                        <th class="text-nowrap-th">Estado de Cuenta</th>
                        <th class="text-nowrap-th">Rol Seguridad</th>
                        <th class="text-end pe-4 text-nowrap-th" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2 text-slate-300"></i>
                                No se encontraron registros de usuario en el sistema.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var u in Model)
                        {
                            <tr class="fila-usuario">
                                <td class="ps-4">
                                    <div class="fw-bold text-slate-800">@u.Correo</div>
                                    <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>Registrado: @(u.FechaRegistro.HasValue ? u.FechaRegistro.Value.ToString("dd/MM/yyyy") : "-")</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(u.Perfil.PrimerNombre))
                                    {
                                        <div class="fw-semibold text-slate-800">@u.Perfil.PrimerNombre @u.Perfil.PrimerApellido</div>
                                        <small class="text-muted"><i class="bi bi-whatsapp me-1 text-success"></i>@(u.Perfil.TelefonoCelularWhatsApp ?? "N/D")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs"><i class="bi bi-file-earmark-lock me-1"></i>Sin expediente</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(u.Perfil.NombreEquipo))
                                    {
                                        <span class="badge bg-light text-dark fw-bold border px-2 py-1 rounded" style="font-size: 0.75rem; color: #000000 !important;">@u.Perfil.NombreEquipo</span>
                                        <div class="small text-sky-700 font-semibold mt-0.5"><i class="bi bi-person-badge-fill me-1"></i>@u.Perfil.NombrePosicion</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted text-xs"><i class="bi bi-dash"></i> Sin asignación</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IdEstado == 1) // PendienteCorreo
                                    {
                                        <span class="badge-soft badge-soft-warning"><i class="bi bi-envelope-exclamation-fill"></i>Pendiente Correo</span>
                                    }
                                    else if (u.IdEstado == 2) // CorreoAprobado
                                    {
                                        <span class="badge-soft badge-soft-info"><i class="bi bi-file-earmark-text-fill"></i>Formulario Pendiente</span>
                                    }
                                    else if (u.IdEstado == 3) // PerfilPendiente
                                    {
                                        <span class="badge-soft badge-soft-primary"><i class="bi text-indigo-600 bi-person-lines-fill"></i>Perfil a Revisar</span>
                                    }
                                    else if (u.IdEstado == 4) // Activo
                                    {
                                        <span class="badge-soft badge-soft-success"><i class="bi bi-check-circle-fill"></i>Activo</span>
                                    }
                                    else if (u.IdEstado == 5) // Rechazado
                                    {
                                        <span class="badge-soft badge-soft-danger"><i class="bi bi-x-circle-fill"></i>Rechazado</span>
                                    }
                                    else if (u.IdEstado == 6) // Suspendido
                                    {
                                        <span class="badge-soft badge-soft-secondary"><i class="bi bi-slash-circle-fill"></i>Suspendido</span>
                                    }
                                    else if (u.IdEstado == 7) // Pendiente Restablecimiento
                                    {
                                        <span class="badge-soft badge-soft-warning"><i class="bi bi-key-fill"></i>P. Restablecimiento</span>
                                    }
                                    else if (u.IdEstado == 8) // Aprobado Restablecimiento
                                    {
                                        <span class="badge-soft badge-soft-info"><i class="bi bi-unlock-fill"></i>Apro. Restablecer</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-rol @(u.NombreRol == "SuperAdmin" ? "bg-danger text-white" : u.NombreRol == "Administrador" ? "bg-warning text-dark" : "bg-light text-slate-600 border")">
                                        @u.NombreRol
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-action-dropdown dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical me-1"></i> Acciones
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-premium">
                                            <li>
                                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalVerExpediente_@u.IdUsuario">
                                                    <i class="bi bi-eye text-info"></i> Ver Perfil
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#modalEditarUsuario_@u.IdUsuario">
                                                    <i class="bi bi-gear text-primary"></i> Editar Puesto / Estado
                                                </button>
                                            </li>
                                            
                                            @if (u.IdEstado == 1)
                                            {
                                                <li><hr class="dropdown-divider border-slate-100"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item text-success fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAprobarCorreo_@u.IdUsuario">
                                                        <i class="bi bi-check-lg"></i> Aprobar Correo
                                                    </button>
                                                </li>
                                                <li>
                                                    <form action="@Url.Action("RechazarUsuario", "Admin")" method="post" class="d-block" onsubmit="return confirm('¿Está seguro de rechazar esta solicitud de registro de correo?');">
                                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-x-lg"></i> Rechazar Registro
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            else if (u.IdEstado == 3)
                                            {
                                                <li><hr class="dropdown-divider border-slate-100"></li>
                                                <li>
                                                    <form action="@Url.Action("AprobarPerfil", "Admin")" method="post" class="d-block">
                                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                        <button type="submit" class="dropdown-item text-success fw-semibold">
                                                            <i class="bi bi-check-circle"></i> Aprobar Perfil
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form action="@Url.Action("RechazarUsuario", "Admin")" method="post" class="d-block" onsubmit="return confirm('¿Está seguro de rechazar este expediente de coordinador?');">
                                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-x-circle"></i> Rechazar Perfil
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            else if (u.IdEstado == 7)
                                            {
                                                <li><hr class="dropdown-divider border-slate-100"></li>
                                                <li>
                                                    <form action="@Url.Action("AprobarRestablecimiento", "Admin")" method="post" class="d-block" onsubmit="return confirm('¿Está seguro de aprobar la solicitud de recuperación de contraseña de este usuario?');">
                                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                        <button type="submit" class="dropdown-item text-success fw-semibold">
                                                            <i class="bi bi-unlock-fill"></i> Aprobar Restablecimiento
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form action="@Url.Action("RechazarRestablecimiento", "Admin")" method="post" class="d-block" onsubmit="return confirm('¿Está seguro de rechazar la solicitud de recuperación de contraseña? (La cuenta del usuario se suspenderá y se liberará su rol)');">
                                                        <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="bi bi-slash-circle-fill"></i> Rechazar Restablecimiento
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>

                                    <!-- MODAL VER EXPEDIENTE COMPLETO -->
                                    <div class="modal fade text-start" id="modalVerExpediente_@u.IdUsuario" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                            <div class="modal-content border-0 rounded-4 shadow">
                                                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                                                    <h5 class="modal-title font-bold"><i class="bi bi-person-vcard me-2 text-info"></i>Expediente de Coordinador: @u.Correo</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <!-- Pestaña 1: Datos Personales -->
                                                    <h6 class="font-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-person-badge-fill me-1"></i>1. Datos Personales e Identidad</h6>
                                                    <div class="row g-3 mb-4 small text-slate-700">
                                                        <div class="col-md-6"><strong>Nombre Completo:</strong> @u.Perfil.PrimerNombre @u.Perfil.OtrosNombres @u.Perfil.PrimerApellido @u.Perfil.OtrosApellidos</div>
                                                        <div class="col-md-6"><strong>Cédula:</strong> @(string.IsNullOrEmpty(u.Perfil.NumeroDocumento) ? "N/D" : u.Perfil.NumeroDocumento)</div>
                                                        <div class="col-md-6"><strong>Celular / WhatsApp:</strong> @(string.IsNullOrEmpty(u.Perfil.TelefonoCelularWhatsApp) ? "N/D" : u.Perfil.TelefonoCelularWhatsApp)</div>
                                                        <div class="col-md-6"><strong>Teléfono Fijo:</strong> @(string.IsNullOrEmpty(u.Perfil.TelefonoFijo) ? "N/D" : u.Perfil.TelefonoFijo)</div>
                                                        <div class="col-md-6"><strong>Dirección:</strong> @u.Perfil.Calle #@u.Perfil.Numero, @u.Perfil.Sector, @u.Perfil.Ciudad</div>
                                                        <div class="col-md-6"><strong>Talla de Camisa:</strong> @(string.IsNullOrEmpty(u.Perfil.Talla) ? "N/D" : u.Perfil.Talla)</div>
                                                        <div class="col-md-6"><strong>Contacto Emergencia:</strong> @(string.IsNullOrEmpty(u.Perfil.ContactoEmergencia) ? "N/D" : u.Perfil.ContactoEmergencia)</div>
                                                        <div class="col-md-6"><strong>Datos Cónyuge:</strong> @(string.IsNullOrEmpty(u.Perfil.DatosConyugue) ? "N/D" : u.Perfil.DatosConyugue)</div>
                                                    </div>

                                                    <!-- Pestaña 2: Ministerial, Educativo y Laboral -->
                                                    <h6 class="font-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-book-half me-1"></i>2. Trayectoria Ministerial, Educación y Trabajo</h6>
                                                    <div class="row g-3 mb-4 small text-slate-700">
                                                        <div class="col-md-6"><strong>Iglesia Local:</strong> @(string.IsNullOrEmpty(u.Perfil.IglesiaLocal) ? "N/D" : u.Perfil.IglesiaLocal)</div>
                                                        <div class="col-md-6"><strong>Pastor de Iglesia:</strong> @(string.IsNullOrEmpty(u.Perfil.PastorIglesiaLocal) ? "N/D" : u.Perfil.PastorIglesiaLocal)</div>
                                                        <div class="col-md-6"><strong>Cargo en Iglesia:</strong> @(string.IsNullOrEmpty(u.Perfil.CargoIglesiaLocal) ? "N/D" : u.Perfil.CargoIglesiaLocal)</div>
                                                        <div class="col-md-6"><strong>Nivel Educativo:</strong> @(string.IsNullOrEmpty(u.Perfil.NivelEducativo) ? "N/D" : u.Perfil.NivelEducativo)</div>
                                                        <div class="col-md-6"><strong>Profesión / Carrera:</strong> @(string.IsNullOrEmpty(u.Perfil.ProfesionCarrera) ? "N/D" : u.Perfil.ProfesionCarrera)</div>
                                                        <div class="col-md-6"><strong>Ocupación Laboral:</strong> @(string.IsNullOrEmpty(u.Perfil.OcupacionEmpresaLaboral) ? "N/D" : u.Perfil.OcupacionEmpresaLaboral)</div>
                                                        <div class="col-md-12"><strong>Capacitaciones OCC:</strong> @(string.IsNullOrEmpty(u.Perfil.CapacitacionesOCC) ? "N/D" : u.Perfil.CapacitacionesOCC)</div>
                                                    </div>

                                                    <!-- Pestaña 3: Asignación OCC -->
                                                    <h6 class="font-bold text-primary border-bottom pb-2 mb-3"><i class="bi bi-diagram-3-fill me-1"></i>3. Asignación OCC y Adjuntos</h6>
                                                    <div class="row g-3 small text-slate-700">
                                                        <div class="col-md-6"><strong>Equipo Solicitado:</strong> @(string.IsNullOrEmpty(u.Perfil.NombreEquipo) ? "Sin Asignar" : u.Perfil.NombreEquipo)</div>
                                                        <div class="col-md-6"><strong>Posición Solicitada:</strong> @(string.IsNullOrEmpty(u.Perfil.NombrePosicion) ? "Sin Asignar" : u.Perfil.NombrePosicion)</div>
                                                        <div class="col-md-6">
                                                            <strong>Documento Cédula:</strong> 
                                                            @if (!string.IsNullOrEmpty(u.Perfil.DocumentoAdjuntoRuta))
                                                            {
                                                                <a href="@u.Perfil.DocumentoAdjuntoRuta" target="_blank" class="btn btn-xs btn-outline-primary ms-1"><i class="bi bi-download"></i> Ver Cédula</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">Sin adjunto</span>
                                                            }
                                                        </div>
                                                        <div class="col-md-6">
                                                            <strong>Pasaporte:</strong> 
                                                            @if (!string.IsNullOrEmpty(u.Perfil.PasaporteAdjuntoRuta))
                                                            {
                                                                <a href="@u.Perfil.PasaporteAdjuntoRuta" target="_blank" class="btn btn-xs btn-outline-primary ms-1"><i class="bi bi-download"></i> Ver Pasaporte</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">Sin adjunto</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-light rounded-bottom-4">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- MODAL EDITAR PERMISOS Y ROLES -->
                                    <div class="modal fade text-start" id="modalEditarUsuario_@u.IdUsuario" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <form action="@Url.Action("EditarUsuarioAdmin", "Admin")" method="post">
                                                <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                <div class="modal-content border-0 rounded-4 shadow">
                                                    <div class="modal-header bg-primary text-white rounded-top-4 py-3">
                                                        <h5 class="modal-title font-bold"><i class="bi bi-gear-fill me-2"></i>Editar Permisos y Puesto</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="mb-3">
                                                            <label class="form-label font-semibold text-slate-700">Correo:</label>
                                                            <input type="text" class="form-control bg-light" value="@u.Correo" readonly />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-semibold text-slate-700">Rol de Seguridad:</label>
                                                            @Html.DropDownList("idRolSeguridad", new SelectList(listaRoles, "Value", "Text", u.IdRolSeguridad), new { @class = "form-select" })
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-semibold text-slate-700">Estado de Cuenta:</label>
                                                            @Html.DropDownList("idEstado", new SelectList(listaEstados, "Value", "Text", u.IdEstado), new { @class = "form-select" })
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-semibold text-slate-700">Equipo Asignado:</label>
                                                            @Html.DropDownList("idEquipo", new SelectList(listaEquipos, "Value", "Text", u.Perfil.IdEquipo), "-- Sin Equipo --", new { @class = "form-select" })
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label font-semibold text-slate-700">Posición en el Equipo:</label>
                                                            @Html.DropDownList("idPosicion", new SelectList(listaPosiciones, "Value", "Text", u.Perfil.IdPosicion), "-- Sin Posición --", new { @class = "form-select" })
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light rounded-bottom-4">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- MODAL APROBAR CORREO -->
                                    <div class="modal fade text-start" id="modalAprobarCorreo_@u.IdUsuario" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <form action="@Url.Action("AprobarCorreo", "Admin")" method="post">
                                                <input type="hidden" name="idUsuario" value="@u.IdUsuario" />
                                                <div class="modal-content border-0 rounded-4 shadow">
                                                    <div class="modal-header bg-success text-white rounded-top-4 py-3">
                                                        <h5 class="modal-title font-bold"><i class="bi bi-envelope-check me-2"></i>Aprobar Registro de Correo</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="text-muted small">Puedes corregir el correo electrónico si el usuario cometió alguna errata al registrarse.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold text-slate-700">Correo Electrónico:</label>
                                                            <input type="email" name="correoCorregido" class="form-control" value="@u.Correo" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light rounded-bottom-4">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                        <button type="submit" class="btn btn-success">Confirmar y Aprobar</button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var activeFilters = [];

        function onFilterChange(selectId) {
            var val = document.getElementById(selectId).value;
            // Remover si existía
            activeFilters = activeFilters.filter(id => id !== selectId);
            
            if (val !== "") {
                activeFilters.push(selectId);
                // Si hay más de 2 filtros activos, quitar el más antiguo
                if (activeFilters.length > 2) {
                    var oldest = activeFilters.shift();
                    document.getElementById(oldest).value = "";
                }
            }
            filtrarTablaUsuarios();
        }

        function limpiarFiltrosUsuarios() {
            document.getElementById("buscarUsuarioInput").value = "";
            document.getElementById("filtroEquipoUsuario").value = "";
            document.getElementById("filtroEstadoUsuario").value = "";
            document.getElementById("filtroRolOCCUsuario").value = "";
            document.getElementById("filtroRolSeguridadUsuario").value = "";
            activeFilters = [];
            filtrarTablaUsuarios();
        }

        function filtrarTablaUsuarios() {
            var input = document.getElementById("buscarUsuarioInput").value.toLowerCase().trim();
            var eq = document.getElementById("filtroEquipoUsuario").value.toLowerCase().trim();
            var est = document.getElementById("filtroEstadoUsuario").value.toLowerCase().trim();
            var rolocc = document.getElementById("filtroRolOCCUsuario").value.toLowerCase().trim();
            var rolseg = document.getElementById("filtroRolSeguridadUsuario").value.toLowerCase().trim();

            var filas = document.querySelectorAll("#tablaUsuarios tbody tr.fila-usuario");

            filas.forEach(function (fila) {
                var c1 = fila.cells[0] ? fila.cells[0].textContent.toLowerCase() : "";
                var c2 = fila.cells[1] ? fila.cells[1].textContent.toLowerCase() : "";
                var c3 = fila.cells[2] ? fila.cells[2].textContent.toLowerCase() : ""; // Equipo y Rol OCC
                var c4 = fila.cells[3] ? fila.cells[3].textContent.toLowerCase() : ""; // Estado
                var c5 = fila.cells[4] ? fila.cells[4].textContent.toLowerCase() : ""; // Rol Seguridad

                var matchInput = input === "" || c1.indexOf(input) > -1 || c2.indexOf(input) > -1 || c3.indexOf(input) > -1 || c4.indexOf(input) > -1 || c5.indexOf(input) > -1;
                var matchEq = eq === "" || c3.indexOf(eq) > -1;
                var matchEst = est === "" || c4.indexOf(est) > -1;
                var matchRolOcc = rolocc === "" || c3.indexOf(rolocc) > -1;
                var matchRolSeg = rolseg === "" || c5.indexOf(rolseg) > -1;

                if (matchInput && matchEq && matchEst && matchRolOcc && matchRolSeg) {
                    fila.style.display = "";
                } else {
                    fila.style.display = "none";
                }
            });
        }
    </script>
}
