@model IEnumerable<SOR.Models.EquipoConDetalles>
@{
    ViewBag.Title = "Gestión Organizacional - Equipos";
    var niveles = ViewBag.Niveles as List<SOR.Models.NivelEquipo> ?? new List<SOR.Models.NivelEquipo>();
    var todosEquipos = ViewBag.TodosEquipos as List<SOR.Models.EquipoConDetalles> ?? new List<SOR.Models.EquipoConDetalles>();
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 font-bold text-slate-800 mb-1">
                    <i class="bi bi-diagram-3 text-primary me-2"></i>Estructura Territorial y Equipos
                </h1>
                <p class="text-muted mb-0">Gestiona los equipos a nivel Nacional, Regional y Local, sus jerarquías y dependencias.</p>
            </div>
            <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCrearEquipo">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Equipo
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- PANEL DE ÁRBOL JERÁRQUICO -->
    <div class="col-lg-4 col-md-12">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-bottom border-light">
                <h2 class="card-title h6 font-bold text-slate-700 mb-0">
                    <i class="bi bi-tree me-2 text-info"></i>Árbol de Jerarquía Organizacional
                </h2>
            </div>
            <div class="card-body">
                <div class="hierarchy-tree">
                    @* Nivel 1: ENL *@
                    @foreach (var enl in Model.Where(e => e.RangoJerarquico == 1))
                    {
                        <div class="tree-item mb-3">
                            <span class="badge bg-primary mb-1"><i class="bi bi-globe me-1"></i> @enl.NombreNivel</span>
                            <div class="fw-bold text-slate-800 ps-2 mb-2">@enl.NombreEquipo</div>
                            
                            @* Nivel 2: ERLE (Hijos de este ENL) *@
                            <div class="ps-4 border-start border-light-subtle ms-2">
                                @foreach (var erle in Model.Where(e => e.IdEquipoPadre == enl.IdEquipo))
                                {
                                    <div class="tree-item mb-2">
                                        <span class="badge bg-info text-dark mb-1"><i class="bi bi-geo-alt me-1"></i> @erle.NombreNivel</span>
                                        <div class="fw-semibold text-slate-700 ps-2 mb-1">@erle.NombreEquipo</div>

                                        @* Nivel 3: ERL (Hijos de este ERLE) *@
                                        <div class="ps-4 border-start border-light-subtle ms-2">
                                            @foreach (var erl in Model.Where(e => e.IdEquipoPadre == erle.IdEquipo))
                                            {
                                                <div class="mb-1 text-slate-600 ps-2 py-1 bg-light rounded-2 text-xs">
                                                    <i class="bi bi-dot text-secondary"></i> @erl.NombreEquipo
                                                </div>
                                            }
                                            @if (!Model.Any(e => e.IdEquipoPadre == erle.IdEquipo))
                                            {
                                                <span class="text-muted text-xs ps-2 d-block italic">Sin equipos locales</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE EQUIPOS -->
    <div class="col-lg-8 col-md-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
                <h2 class="card-title h6 font-bold text-slate-700 mb-0">
                    <i class="bi bi-table me-2 text-primary"></i>Listado de Equipos
                </h2>
                <span class="badge bg-light text-slate-600">@Model.Count() Equipos Registrados</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-slate-600">
                            <tr>
                                <th class="border-0 px-4 py-3">ID</th>
                                <th class="border-0 py-3">Nombre del Equipo</th>
                                <th class="border-0 py-3">Nivel / Rango</th>
                                <th class="border-0 py-3">Equipo Supervisor (Padre)</th>
                                <th class="border-0 py-3">Estado</th>
                                <th class="border-0 text-end px-4 py-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eq in Model)
                            {
                                <tr class="@(eq.Activo ? "" : "text-muted opacity-75 bg-light-subtle")">
                                    <td class="px-4 py-3 text-slate-500">@eq.IdEquipo</td>
                                    <td class="py-3 font-semibold @(eq.Activo ? "text-slate-800" : "text-slate-500 text-decoration-line-through")">@eq.NombreEquipo</td>
                                    <td class="py-3">
                                        @if (eq.RangoJerarquico == 1)
                                        {
                                            <span class="badge bg-primary">@eq.NombreNivel</span>
                                        }
                                        else if (eq.RangoJerarquico == 2)
                                        {
                                            <span class="badge bg-info text-dark">@eq.NombreNivel</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@eq.NombreNivel</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (eq.IdEquipoPadre.HasValue)
                                        {
                                            <span class="text-slate-700 fw-medium">@eq.NombreEquipoPadre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic small">Nivel Superior Nacional</span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        @if (eq.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle-fill me-1"></i>Inactivo</span>
                                        }
                                                                         <td class="text-end px-4 py-3 text-nowrap" style="min-width: 120px;">
                                        <div class="d-inline-flex align-items-center justify-content-end gap-1">
                                            <button class="btn btn-outline-primary btn-sm btn-edit-equipo" data-id="@eq.IdEquipo" title="Editar Equipo">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form action="@Url.Action("Eliminar", "Equipos")" method="post" class="d-inline form-delete-equipo m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idEquipo" value="@eq.IdEquipo" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Desactivar o Eliminar Equipo" onclick="return confirm('¿Está seguro de que desea eliminar/inhabilitar este equipo? Si posee dependencias asociadas, el sistema lo desactivará automáticamente para preservar los datos históricos.');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL CREAR EQUIPO -->
<!-- ========================================== -->
<div class="modal fade" id="modalCrearEquipo" tabindex="-1" aria-labelledby="crearEquipoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title font-bold text-white" id="crearEquipoLabel"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Equipo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="@Url.Action("Crear", "Equipos")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-semibold text-slate-700">Nombre del Equipo</label>
                        <input type="text" name="NombreEquipo" class="form-control" placeholder="Ej. ERL Cibao Norte" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-semibold text-slate-700">Nivel Jerárquico</label>
                        <select name="IdNivelEquipo" id="selectNivelCrear" class="form-select" required>
                            <option value="">-- Selecciona Nivel --</option>
                            @foreach (var n in niveles)
                            {
                                <option value="@n.IdNivelEquipo" data-rango="@n.RangoJerarquico">@n.NombreNivel (Rango @n.RangoJerarquico)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="divPadreCrear">
                        <label class="form-label font-semibold text-slate-700">Equipo Supervisor (Padre)</label>
                        <select name="IdEquipoPadre" id="selectPadreCrear" class="form-select">
                            <option value="">-- Selecciona Supervisor --</option>
                            @foreach (var eq in todosEquipos.Where(t => t.Activo))
                            {
                                <option value="@eq.IdEquipo" data-rango="@eq.RangoJerarquico">[@eq.NombreNivel] @eq.NombreEquipo</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">El equipo supervisor debe poseer un nivel jerárquico superior (rango menor).</small>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Guardar Equipo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL EDITAR EQUIPO -->
<!-- ========================================== -->
<div class="modal fade" id="modalEditarEquipo" tabindex="-1" aria-labelledby="editarEquipoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title font-bold text-white" id="editarEquipoLabel"><i class="bi bi-pencil-square me-2 text-info"></i>Editar Equipo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="@Url.Action("Editar", "Equipos")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdEquipo" id="editIdEquipo" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-semibold text-slate-700">Nombre del Equipo</label>
                        <input type="text" name="NombreEquipo" id="editNombreEquipo" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-semibold text-slate-700">Nivel Jerárquico</label>
                        <select name="IdNivelEquipo" id="editSelectNivel" class="form-select" required>
                            <option value="">-- Selecciona Nivel --</option>
                            @foreach (var n in niveles)
                            {
                                <option value="@n.IdNivelEquipo" data-rango="@n.RangoJerarquico">@n.NombreNivel (Rango @n.RangoJerarquico)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="divPadreEditar">
                        <label class="form-label font-semibold text-slate-700">Equipo Supervisor (Padre)</label>
                        <select name="IdEquipoPadre" id="editSelectPadre" class="form-select">
                            <option value="">-- Selecciona Supervisor --</option>
                            @foreach (var eq in todosEquipos.Where(t => t.Activo))
                            {
                                <option value="@eq.IdEquipo" data-rango="@eq.RangoJerarquico" id="opt-edit-padre-@eq.IdEquipo">[@eq.NombreNivel] @eq.NombreEquipo</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">El equipo supervisor debe poseer un nivel jerárquico superior (rango menor).</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-semibold text-slate-700">Estado del Equipo</label>
                        <select name="Activo" id="editActivo" class="form-select" required>
                            <option value="true">Activo / Habilitado</option>
                            <option value="false">Inactivo / Inhabilitado</option>
                        </select>
                        <small class="text-muted d-block mt-1">Inhabilitar un equipo impedirá que sea seleccionado en nuevos registros de usuarios o iglesias.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-semibold px-4">Actualizar Datos</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Lógica para filtrar y ocultar el selector de padre si se selecciona nivel 1 (ENL/Nacional)
            function ajustarSelectPadre(selectNivel, divPadre, selectPadre) {
                var selectedOpt = selectNivel.find('option:selected');
                var rango = selectedOpt.data('rango');
                
                if (rango == 1) {
                    divPadre.hide();
                    selectPadre.val('');
                    selectPadre.removeAttr('required');
                } else {
                    divPadre.show();
                    selectPadre.attr('required', 'required');
                    
                    // Filtrar opciones del padre para que solo muestre equipos con jerarquía superior (rango menor)
                    selectPadre.find('option').each(function() {
                        var val = $(this).val();
                        if (val === '') return;
                        
                        var rangoPadre = $(this).data('rango');
                        if (rangoPadre >= rango) {
                            $(this).hide();
                        } else {
                            $(this).show();
                        }
                    });
                }
            }

            $('#selectNivelCrear').on('change', function() {
                ajustarSelectPadre($(this), $('#divPadreCrear'), $('#selectPadreCrear'));
            });

            $('#editSelectNivel').on('change', function() {
                ajustarSelectPadre($(this), $('#divPadreEditar'), $('#editSelectPadre'));
            });

            // Disparar AJAX para cargar datos del equipo al hacer clic en editar
            $('.btn-edit-equipo').on('click', function () {
                var id = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("ObtenerEquipo", "Equipos")',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            var eq = res.data;
                            $('#editIdEquipo').val(eq.IdEquipo);
                            $('#editNombreEquipo').val(eq.NombreEquipo);
                            $('#editSelectNivel').val(eq.IdNivelEquipo);
                            $('#editActivo').val(eq.Activo ? 'true' : 'false');
                            
                            // Ocultar la opción del propio equipo para que no se seleccione a sí mismo como padre
                            $('#editSelectPadre').find('option').show();
                            $('#opt-edit-padre-' + eq.IdEquipo).hide();

                            // Ajustar y establecer padre
                            ajustarSelectPadre($('#editSelectNivel'), $('#divPadreEditar'), $('#editSelectPadre'));
                            $('#editSelectPadre').val(eq.IdEquipoPadre);

                            // Mostrar modal
                            var myModal = new bootstrap.Modal(document.getElementById('modalEditarEquipo'));
                            myModal.show();
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        alert('Error al conectar con el servidor.');
                    }
                });
            });
        });
    </script>
}
