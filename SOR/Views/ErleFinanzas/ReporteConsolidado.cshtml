@model SOR.Models.ERLE.ErleReporteConsolidadoViewModel
@{
    ViewBag.Title = "Reporte Consolidado Anual de Finanzas — " + Model.NombreEquipo;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var grupos = Model.Filas.GroupBy(f => f.Grupo).ToList();
    var ingresos = Model.Filas.Where(f => f.Tipo == "INGRESO").ToList();
    var gastos = Model.Filas.Where(f => f.Tipo == "GASTO").ToList();

    decimal totIngDOP = ingresos.Sum(i => i.TotalDOP);
    decimal totGasDOP = gastos.Sum(g => g.TotalDOP);
    decimal saldoNetoDOP = totIngDOP - totGasDOP;
    decimal saldoNetoUSD = Model.TasaCambio > 0 ? Math.Round(saldoNetoDOP / Model.TasaCambio, 2) : 0m;
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h3 font-bold text-slate-800 mb-1">
            <i class="bi bi-grid-3x3 text-primary me-2"></i>Finanzas — Reporte Consolidado Anual
        </h2>
        <p class="text-muted mb-0">Matriz anual de ejecución acumulada mensual por categorías para @Model.NombreEquipo (@Model.NombreTemporada).</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "ErleFinanzas", new { temporadaId = Model.TemporadaId, equipoId = Model.EquipoId, mes = "OCT" })" class="btn btn-outline-secondary font-semibold px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver al Libro Mensual
        </a>
        <button type="button" class="btn btn-primary font-semibold px-4 shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-2"></i>Imprimir / Exportar
        </button>
    </div>
</div>

<!-- BARRA DE FILTROS -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label text-xs fw-semibold mb-1 text-muted">Equipo</label>
            <select id="selectEquipoConsolidado" class="form-select form-select-sm bg-light" onchange="cambiarFiltrosConsolidado()">
                @foreach (var eq in Model.ListaEquipos)
                {
                    <option value="@eq.Value" @(Model.EquipoId.ToString() == eq.Value ? "selected" : "")>@eq.Text</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label text-xs fw-semibold mb-1 text-muted">Temporada</label>
            <select id="selectTemporadaConsolidado" class="form-select form-select-sm bg-light" onchange="cambiarFiltrosConsolidado()">
                @foreach (var tmp in Model.ListaTemporadas)
                {
                    <option value="@tmp.Value" @(Model.TemporadaId.ToString() == tmp.Value ? "selected" : "")>@tmp.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex">
            <a href="@Url.Action("ReporteConsolidado", "ErleFinanzas")" class="btn btn-sm btn-outline-secondary w-100 font-semibold">
                <i class="bi bi-arrow-clockwise me-1"></i>Recargar
            </a>
        </div>
    </div>
</div>

<!-- TARJETAS KPI ANUAL -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #198754 !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Total Ingresos Anuales</div>
                    <div class="h4 font-bold text-success mb-0 font-monospace">RD$ @totIngDOP.ToString("N2")</div>
                    <small class="text-muted font-monospace">$@((Model.TasaCambio > 0 ? Math.Round(totIngDOP / Model.TasaCambio, 2) : 0).ToString("N2")) USD</small>
                </div>
                <div class="rounded-circle p-3 bg-success-soft text-success">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #dc3545 !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Total Gastos Anuales</div>
                    <div class="h4 font-bold text-danger mb-0 font-monospace">RD$ @totGasDOP.ToString("N2")</div>
                    <small class="text-muted font-monospace">$@((Model.TasaCambio > 0 ? Math.Round(totGasDOP / Model.TasaCambio, 2) : 0).ToString("N2")) USD</small>
                </div>
                <div class="rounded-circle p-3 bg-danger-soft text-danger">
                    <i class="bi bi-graph-down-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Balance Neto Acumulado</div>
                    <div class="h4 font-bold @(saldoNetoDOP < 0 ? "text-danger" : "text-primary") mb-0 font-monospace">RD$ @saldoNetoDOP.ToString("N2")</div>
                    <small class="text-muted font-monospace">$@saldoNetoUSD.ToString("N2") USD</small>
                </div>
                <div class="rounded-circle p-3 bg-primary-soft text-primary">
                    <i class="bi bi-wallet2 fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MATRIZ CONSOLIDADA -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom">
        <div>
            <h6 class="mb-0 fw-bold text-slate-800">
                <i class="bi bi-table me-2 text-primary"></i>Matriz de Flujo Financiero Mensual
            </h6>
            <small class="text-muted">Desglose de ejecución de 12 meses por categoría (Pesos Dominicanos / Dólares)</small>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size: 0.82rem;">
                <thead class="table-dark text-center align-middle">
                    <tr>
                        <th style="min-width: 60px;">Cat.</th>
                        <th style="min-width: 220px;" class="text-start">Descripción</th>
                        <th style="min-width: 80px;">SEP</th>
                        <th style="min-width: 80px;">OCT</th>
                        <th style="min-width: 80px;">NOV</th>
                        <th style="min-width: 80px;">DIC</th>
                        <th style="min-width: 80px;">ENE</th>
                        <th style="min-width: 80px;">FEB</th>
                        <th style="min-width: 80px;">MAR</th>
                        <th style="min-width: 80px;">ABR</th>
                        <th style="min-width: 80px;">MAY</th>
                        <th style="min-width: 80px;">JUN</th>
                        <th style="min-width: 80px;">JUL</th>
                        <th style="min-width: 80px;">AGO</th>
                        <th style="min-width: 110px;" class="bg-primary text-white">Total DOP</th>
                        <th style="min-width: 95px;" class="bg-dark text-warning">Total USD</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in grupos)
                    {
                        <tr class="table-secondary fw-bold text-uppercase" style="font-size: 0.84rem;">
                            <td colspan="16" class="ps-3 py-1.5 text-dark">
                                <i class="bi bi-folder2-open me-1 text-primary"></i>@g.Key
                            </td>
                        </tr>
                        foreach (var fila in g)
                        {
                            <tr>
                                <td class="text-center font-monospace fw-bold text-primary">@fila.CategoriaId</td>
                                <td class="fw-semibold text-slate-800">@fila.Descripcion</td>
                                <td class="text-end font-monospace">@(fila.SEP > 0 ? fila.SEP.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.OCT > 0 ? fila.OCT.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.NOV > 0 ? fila.NOV.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.DIC > 0 ? fila.DIC.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.ENE > 0 ? fila.ENE.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.FEB > 0 ? fila.FEB.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.MAR > 0 ? fila.MAR.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.ABR > 0 ? fila.ABR.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.MAY > 0 ? fila.MAY.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.JUN > 0 ? fila.JUN.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.JUL > 0 ? fila.JUL.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace">@(fila.AGO > 0 ? fila.AGO.ToString("N0") : "-")</td>
                                <td class="text-end font-monospace fw-bold bg-light text-primary">RD$ @fila.TotalDOP.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold bg-light text-success">$@fila.TotalUSD.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-dark text-end fw-bold font-monospace">
                    <tr class="table-info text-dark">
                        <td colspan="2" class="text-start">TOTAL INGRESOS (DOP):</td>
                        <td>@ingresos.Sum(i => i.SEP).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.OCT).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.NOV).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.DIC).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.ENE).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.FEB).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.MAR).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.ABR).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.MAY).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.JUN).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.JUL).ToString("N0")</td>
                        <td>@ingresos.Sum(i => i.AGO).ToString("N0")</td>
                        <td class="text-primary fw-bold">RD$ @totIngDOP.ToString("N2")</td>
                        <td class="text-success fw-bold">$@((Model.TasaCambio > 0 ? Math.Round(totIngDOP / Model.TasaCambio, 2) : 0).ToString("N2"))</td>
                    </tr>
                    <tr class="table-warning text-dark">
                        <td colspan="2" class="text-start">TOTAL GASTOS (DOP):</td>
                        <td>@gastos.Sum(g => g.SEP).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.OCT).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.NOV).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.DIC).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.ENE).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.FEB).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.MAR).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.ABR).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.MAY).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.JUN).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.JUL).ToString("N0")</td>
                        <td>@gastos.Sum(g => g.AGO).ToString("N0")</td>
                        <td class="text-danger fw-bold">RD$ @totGasDOP.ToString("N2")</td>
                        <td class="text-danger fw-bold">$@((Model.TasaCambio > 0 ? Math.Round(totGasDOP / Model.TasaCambio, 2) : 0).ToString("N2"))</td>
                    </tr>
                    <tr class="table-primary text-dark fs-6">
                        <td colspan="2" class="text-start fw-bold">BALANCE NETO DISPONIBLE:</td>
                        <td>@((ingresos.Sum(i => i.SEP) - gastos.Sum(g => g.SEP)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.OCT) - gastos.Sum(g => g.OCT)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.NOV) - gastos.Sum(g => g.NOV)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.DIC) - gastos.Sum(g => g.DIC)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.ENE) - gastos.Sum(g => g.ENE)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.FEB) - gastos.Sum(g => g.FEB)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.MAR) - gastos.Sum(g => g.MAR)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.ABR) - gastos.Sum(g => g.ABR)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.MAY) - gastos.Sum(g => g.MAY)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.JUN) - gastos.Sum(g => g.JUN)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.JUL) - gastos.Sum(g => g.JUL)).ToString("N0"))</td>
                        <td>@((ingresos.Sum(i => i.AGO) - gastos.Sum(g => g.AGO)).ToString("N0"))</td>
                        <td class="fw-bold @(saldoNetoDOP < 0 ? "text-danger" : "text-success")">RD$ @saldoNetoDOP.ToString("N2")</td>
                        <td class="fw-bold @(saldoNetoUSD < 0 ? "text-danger" : "text-success")">$@saldoNetoUSD.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-secondary-soft {
        background-color: rgba(108, 117, 125, 0.12) !important;
        color: #6c757d !important;
    }
    .bg-primary-soft {
        background-color: rgba(13, 110, 253, 0.12) !important;
        color: #0d6efd !important;
    }
    .bg-success-soft {
        background-color: rgba(25, 135, 84, 0.12) !important;
        color: #198754 !important;
    }
    .bg-danger-soft {
        background-color: rgba(220, 53, 69, 0.12) !important;
        color: #dc3545 !important;
    }
</style>

@section scripts {
<script>
    function cambiarFiltrosConsolidado() {
        var eqId = document.getElementById("selectEquipoConsolidado").value;
        var tmpId = document.getElementById("selectTemporadaConsolidado").value;
        var url = '@Url.Action("ReporteConsolidado", "ErleFinanzas")' + '?temporadaId=' + tmpId + '&equipoId=' + eqId;
        window.location.href = url;
    }
</script>
}
