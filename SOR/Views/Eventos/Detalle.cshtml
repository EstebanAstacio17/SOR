<!-- MODAL CONFIRMAR DESPACHO CON CÉDULA INSTITUCIONAL -->
<div class="modal fade" id="modalConfirmarDespacho" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                <h5 class="modal-title font-bold"><i class="bi bi-send-check me-2 text-success"></i>Confirmar Entrega de Materiales</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("ConfirmarDespacho", "Eventos", FormMethod.Post, new { onsubmit = "return serializarMaterialesDespacho()" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEvento" value="@evento.IdEvento" />
                <input type="hidden" name="IdDespachoIglesia" id="hdIdDespachoConfirmar" value="0" />
                <input type="hidden" name="MaterialesJson" id="hdMaterialesJson" value="[]" />
                
                <!-- Datos del Receptor enviados al backend -->
                <input type="hidden" name="TipoReceptor" id="hdTipoReceptor" value="PASTOR" />
                <input type="hidden" name="NombreReceptor" id="hdNombreReceptor" value="" />
                <input type="hidden" name="DocumentoIdentidadReceptor" id="hdCedulaReceptor" value="" />
                <input type="hidden" name="DocumentoCedulaReceptor" id="hdDocumentoCedulaReceptor" value="" />
                <input type="hidden" name="TelefonoReceptor" id="hdTelReceptor" value="" />
                <input type="hidden" name="CantidadesJson" id="hdCantidadesJson" value="{}" />

                <div class="modal-body p-4">
                    <div class="alert alert-info py-2.5 px-3 small mb-3 border border-info border-opacity-25 rounded-3">
                        <i class="bi bi-shield-check text-primary me-1 fs-6"></i><strong>Regla de Entrega Institucional:</strong> Solo se entregan materiales al <strong>Pastor General</strong>, al <strong>Líder Ministerial</strong> o a <strong>ambos líderes juntos</strong> debidamente registrados. Seleccione a continuación quién está presente recibiendo con su documento físico de identidad en mano.
                    </div>

                    <div class="card bg-light border-0 p-3 mb-3 rounded-3">
                        <span class="text-xs text-muted text-uppercase fw-semibold">Iglesia Receptora</span>
                        <h5 class="fw-bold text-slate-800 mb-0" id="txtNombreIglesiaConfirmar">—</h5>
                    </div>

                    <h6 class="fw-bold mb-2 text-slate-800"><i class="bi bi-person-vcard me-2 text-primary"></i>Seleccionar Quién Recibe los Materiales</h6>
                    
                    <!-- Opciones de Selección del Receptor Registrado -->
                    <div class="row g-2 mb-3">
                        <!-- Opción Pastor -->
                        <div class="col-md-4">
                            <label class="card h-100 p-3 border rounded-3 cursor-pointer option-receptor-card" for="optReceptorPastor">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="optReceptor" id="optReceptorPastor" value="PASTOR" checked onchange="seleccionarOpcionReceptor('PASTOR')" />
                                    <span class="form-check-label fw-bold text-slate-800 d-block">
                                        <i class="bi bi-person-badge text-primary me-1"></i>Pastor General
                                    </span>
                                </div>
                                <div class="small bg-white p-2 rounded border">
                                    <div class="text-xs text-muted fw-semibold">Nombre:</div>
                                    <div class="fw-bold text-slate-800 text-truncate" id="txtPastorNombre">—</div>
                                    <div class="text-xs text-muted fw-semibold mt-1">Cédula / Identidad:</div>
                                    <div class="font-monospace text-primary fw-semibold" id="txtPastorCedula">—</div>
                                    <div class="text-xs text-muted fw-semibold mt-1">Teléfono:</div>
                                    <div class="text-slate-700" id="txtPastorTelefono">—</div>
                                </div>
                            </label>
                        </div>

                        <!-- Opción Líder Ministerial -->
                        <div class="col-md-4">
                            <label class="card h-100 p-3 border rounded-3 cursor-pointer option-receptor-card" for="optReceptorLider">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="optReceptor" id="optReceptorLider" value="LIDER_MINISTERIAL" onchange="seleccionarOpcionReceptor('LIDER_MINISTERIAL')" />
                                    <span class="form-check-label fw-bold text-slate-800 d-block">
                                        <i class="bi bi-person-check text-info me-1"></i>Líder Ministerial
                                    </span>
                                </div>
                                <div class="small bg-white p-2 rounded border">
                                    <div class="text-xs text-muted fw-semibold">Nombre:</div>
                                    <div class="fw-bold text-slate-800 text-truncate" id="txtLiderNombre">—</div>
                                    <div class="text-xs text-muted fw-semibold mt-1">Cédula / Identidad:</div>
                                    <div class="font-monospace text-primary fw-semibold" id="txtLiderCedula">—</div>
                                    <div class="text-xs text-muted fw-semibold mt-1">Teléfono:</div>
                                    <div class="text-slate-700" id="txtLiderTelefono">—</div>
                                </div>
                            </label>
                        </div>

                        <!-- Opción Ambos Presentes -->
                        <div class="col-md-4">
                            <label class="card h-100 p-3 border rounded-3 cursor-pointer option-receptor-card" for="optReceptorAmbos">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="optReceptor" id="optReceptorAmbos" value="AMBOS" onchange="seleccionarOpcionReceptor('AMBOS')" />
                                    <span class="form-check-label fw-bold text-slate-800 d-block">
                                        <i class="bi bi-people-fill text-success me-1"></i>Ambos Presentes
                                    </span>
                                </div>
                                <div class="small bg-white p-2 rounded border">
                                    <div class="text-xs text-muted fw-semibold">Entrega Conjunta:</div>
                                    <div class="fw-bold text-slate-800">Pastor y Líder</div>
                                    <div class="text-xs text-muted mt-1">Se registran las credenciales de ambos representantes.</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Resumen del Receptor Seleccionado -->
                    <div class="card p-3 mb-3 border-success border-opacity-50 bg-success-soft rounded-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <span class="text-xs text-muted text-uppercase fw-semibold d-block">Persona Acreditada:</span>
                                <div id="txtReceptorResumen" class="small text-slate-800 font-semibold">Pastor General</div>
                            </div>
                            <div class="col-md-4">
                                <span class="text-xs text-muted text-uppercase fw-semibold d-block">Cédula / Documento:</span>
                                <span id="txtCedulaResumen" class="font-monospace fw-bold text-primary small">—</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-xs text-muted text-uppercase fw-semibold d-block">Teléfono de Contacto:</span>
                                <span id="txtTelefonoResumen" class="fw-semibold text-slate-700 small">—</span>
                            </div>
                            <div class="col-12 mt-2 pt-2 border-top">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkValidadoEnMano" required checked />
                                    <label class="form-check-label small fw-bold text-slate-800" for="chkValidadoEnMano">
                                        <i class="bi bi-patch-check-fill text-success me-1"></i>Cédula física validada en mano al momento de la entrega
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Observaciones de Entrega -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Observaciones del Despacho (Opcional)</label>
                        <input type="text" name="Observaciones" class="form-control form-control-sm" placeholder="ej. Cajas selladas, retiro en persona, comentarios adicionales..." />
                    </div>

                    <h6 class="fw-bold mb-2 text-slate-800"><i class="bi bi-box-seam me-2 text-primary"></i>Materiales a Entregar</h6>
                    <div class="table-responsive border rounded-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>Material</th><th class="text-center">Unidad</th><th class="text-center">Asignado</th><th class="text-center">A Despachar</th><th class="text-center">Estado</th></tr>
                            </thead>
                            <tbody id="tbodyMaterialesDespacho">
                                <tr><td colspan="5" class="text-center text-muted py-3">Cargando...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success font-semibold shadow-sm"><i class="bi bi-check2-circle me-1"></i>Confirmar Despacho y Descontar Stock</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL NO DESPACHO -->
<div class="modal fade" id="modalNoDespacho" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4 py-3">
                <h5 class="modal-title font-bold"><i class="bi bi-x-circle me-2"></i>Marcar Iglesia como No Despachada</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("MarcarNoDespacho", "Eventos", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEvento" value="@evento.IdEvento" />
                <input type="hidden" name="IdDespachoIglesia" id="hdIdDespachoNoDespacho" value="0" />
                <div class="modal-body p-4">
                    <p class="small text-slate-700 mb-2">
                        Se registrará el motivo por el cual la iglesia <strong id="txtNombreIglesiaNoDespacho">—</strong> no recibió los materiales en este evento.
                    </p>
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <i class="bi bi-info-circle me-1"></i><strong>Nota de Inventario:</strong> El inventario de materiales <strong>NO se descontará</strong> y la asignación quedará disponible para reprogramar en un futuro evento.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motivo del No Despacho <span class="text-danger">*</span></label>
                        <select name="Motivo" class="form-select" required>
                            <option value="">— Seleccione un motivo —</option>
                            <option value="NO_ASISTIO">No asistió al evento</option>
                            <option value="SIN_CEDULA">Asistió sin documento de identidad (cédula)</option>
                            <option value="RECEPTOR_NO_AUTORIZADO">Receptor no autorizado (no es Pastor ni Líder Ministerial)</option>
                            <option value="STOCK_INSUFICIENTE">Stock insuficiente en el equipo</option>
                            <option value="RECHAZO_MATERIAL">Rechazó recibir el material</option>
                            <option value="OTRO">Otro motivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Detalle / Observaciones</label>
                        <textarea name="Observaciones" id="txtMotivoNoDespacho" class="form-control" rows="3" placeholder="Explique detalles adicionales..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger font-semibold shadow-sm"><i class="bi bi-save me-1"></i>Guardar Motivo</button>
                </div>
            }
        </div>
    </div>
</div>

