@{
    ViewBag.Title = "Detalle del Evento y Asistencias";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var evento = (SOR.Models.Evento)ViewBag.Evento;
    var iglesias = (List<SOR.Controllers.IglesiaParticipacionViewModel>)ViewBag.Iglesias;
    var maestros = (List<SOR.Controllers.MaestroAsistenciaViewModel>)ViewBag.Maestros;
    bool puedeEditar = ViewBag.PuedeEditar != null && (bool)ViewBag.PuedeEditar;
    var u = (SOR.Models.Usuario)Session["usuario"] ?? new SOR.Models.Usuario();
    bool eventoPasado = evento != null && evento.Fecha.Date < DateTime.Today;
    var eventoDespacho = ViewBag.EventoDespacho as SOR.Models.EventoDespacho;
    var iglesiasDisponibles = ViewBag.IglesiasDisponibles as IEnumerable<SOR.Models.DespachoIglesiaItem> ?? new List<SOR.Models.DespachoIglesiaItem>();
    bool esAdmin = ViewBag.EsAdmin == true || u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2;
    bool esCL = ViewBag.EsCL == true || u.IdPosicion == 6 || (u.NombrePosicion != null && u.NombrePosicion.IndexOf("Logística", StringComparison.OrdinalIgnoreCase) >= 0) || (u.NombrePosicion != null && u.NombrePosicion.IndexOf("Logistica", StringComparison.OrdinalIgnoreCase) >= 0);
}

@Html.AntiForgeryToken()

<div class="mb-4">
    <a href="@Url.Action("Index", "Eventos")" class="btn btn-sm btn-outline-secondary font-semibold">
        <i class="bi bi-arrow-left me-1"></i>Volver a Eventos
    </a>
</div>

@if (eventoPasado)
{
    <div class="alert alert-secondary py-2 px-3 mb-4 d-flex align-items-center gap-2 rounded-3 border">
        <i class="bi bi-clock-history text-muted flex-shrink-0 fs-5"></i>
        <div class="small">
            Este evento se realizó el <strong>@evento.Fecha.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</strong>.
            @if (u.IdRolSeguridad != 1 && u.IdRolSeguridad != 2)
            {
                <span>La lista de asistencia se encuentra en <strong>modo histórico de solo lectura</strong> y está inhabilitada para retiro o modificación de participantes.</span>
            }
            else
            {
                <span>Modo de edición administrativa habilitado para SuperAdmin / Administrador.</span>
            }
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- Panel Izquierdo: Ficha del Evento -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-header bg-dark text-white rounded-top-4 py-3 border-0">
                <h5 class="card-title mb-0 font-bold"><i class="bi bi-calendar-event me-2"></i>Ficha del Evento</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4 text-center">
                    @if (evento.TipoEvento == "Vision")
                    {
                        <span class="fs-1 text-purple"><i class="bi bi-eye"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-purple-soft text-purple px-3 py-1.5 rounded-pill mt-1">Presentación de la Visión</span>
                    }
                    else if (evento.TipoEvento == "Taller")
                    {
                        <span class="fs-1 text-info"><i class="bi bi-book"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-info-soft text-info px-3 py-1.5 rounded-pill mt-1">Taller OCC</span>
                    }
                    else if (evento.TipoEvento == "Despacho")
                    {
                        <span class="fs-1 text-success"><i class="bi bi-send-check"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill mt-1">Despacho de Materiales</span>
                    }
                    else if (evento.TipoEvento == "Evangelistico")
                    {
                        <span class="fs-1 text-success"><i class="bi bi-heart-pulse"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill mt-1">Evento Evangelístico</span>
                    }
                    else if (evento.TipoEvento == "GranAventura")
                    {
                        <span class="fs-1 text-warning"><i class="bi bi-compass"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-warning-soft text-warning px-3 py-1.5 rounded-pill mt-1">La Gran Aventura</span>
                    }
                    else
                    {
                        <span class="fs-1 text-secondary"><i class="bi bi-calendar3"></i></span>
                        <h4 class="font-bold text-slate-800 mt-2">@evento.NombreEvento</h4>
                        <span class="badge bg-secondary-soft text-secondary px-3 py-1.5 rounded-pill mt-1">@evento.TipoEvento</span>
                    }
                </div>

                <hr class="border-slate-200">

                <div class="d-flex flex-column gap-3 mt-3">
                    <div>
                        <small class="text-muted d-block uppercase tracking-wider text-xxs font-semibold">Temporada</small>
                        <strong class="text-slate-800">@evento.NombreTemporada</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block uppercase tracking-wider text-xxs font-semibold">Fecha del Evento</small>
                        <strong class="text-slate-800"><i class="bi bi-calendar3 me-1"></i>@evento.Fecha.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block uppercase tracking-wider text-xxs font-semibold">Lugar</small>
                        <strong class="text-slate-800"><i class="bi bi-geo-alt me-1"></i>@(string.IsNullOrEmpty(evento.Lugar) ? "No especificado" : evento.Lugar)</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block uppercase tracking-wider text-xxs font-semibold">Responsable</small>
                        <strong class="text-slate-800"><i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(evento.Responsable) ? "Sin responsable" : evento.Responsable)</strong>
                    </div>
                    <div>
                        <small class="text-muted d-block uppercase tracking-wider text-xxs font-semibold">Creado Por</small>
                        <strong class="text-slate-800">@evento.CorreoCreador</strong>
                        <small class="text-muted d-block font-monospace">@evento.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Iglesias y Asistencia de Maestros o Despacho -->
    <div class="col-lg-8">
        @if (!puedeEditar)
        {
            <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4">
                <i class="bi bi-info-circle-fill me-2"></i>Modo <strong>Solo Lectura</strong>: Este evento pertenece a otro equipo u otra jurisdicción. Puedes consultar los detalles y la asistencia, pero no realizar modificaciones.
            </div>
        }

        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (evento.TipoEvento == "Despacho" && eventoDespacho != null)
        {
            <!-- SECCIÓN ESPECIALIZADA DE EVENTO DE DESPACHO -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
                    <h5 class="h6 font-bold text-slate-800 mb-0">
                        <i class="bi bi-truck-front text-primary me-2"></i>Control de Despacho Presencial de Materiales
                    </h5>
                    @if (puedeEditar)
                    {
                        <button type="button" class="btn btn-sm btn-primary font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAgregarIglesiaDespacho">
                            <i class="bi bi-plus-lg me-1"></i>Agregar Iglesia al Despacho
                        </button>
                    }
                </div>

                <!-- Métricas de Progreso -->
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="text-xs text-muted text-uppercase font-semibold">Total Asignadas</div>
                            <div class="h4 font-bold text-slate-800 mb-0">@eventoDespacho.TotalIglesiasAsignadas</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-success-soft rounded-3 text-center">
                            <div class="text-xs text-success text-uppercase font-semibold">Despachadas</div>
                            <div class="h4 font-bold text-success mb-0">@eventoDespacho.TotalIglesiasDespachadas</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-warning-soft rounded-3 text-center">
                            <div class="text-xs text-warning text-uppercase font-semibold">Pendientes</div>
                            <div class="h4 font-bold text-warning mb-0">@eventoDespacho.TotalIglesiasPendientes</div>
                        </div>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 10px; border-radius: 980px;">
                    <div class="progress-bar bg-success" style="width: @(eventoDespacho.PorcentajeDespachado.ToString("F0"))%"></div>
                </div>
                <div class="small text-muted text-end mb-4">Progreso del evento: <strong>@(eventoDespacho.PorcentajeDespachado.ToString("F1"))%</strong></div>

                <!-- Tabla de Iglesias Programadas -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Iglesia</th>
                                <th>Comprobante</th>
                                <th class="text-center">Estado</th>
                                <th>Receptor / Cédula</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!eventoDespacho.Iglesias.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2 text-slate-300"></i>
                                        No hay iglesias programadas en este evento de despacho.<br />
                                        @if (puedeEditar)
                                        {
                                            <button class="btn btn-sm btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#modalAgregarIglesiaDespacho">
                                                <i class="bi bi-plus-lg me-1"></i>Agregar primera iglesia
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @foreach (var ig in eventoDespacho.Iglesias)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-slate-800">@ig.NombreIglesia</div>
                                        <div class="text-xs text-muted">@(string.IsNullOrEmpty(ig.DireccionIglesia) ? "" : ig.DireccionIglesia)</div>
                                    </td>
                                    <td>
                                        <span class="font-monospace text-xs">@ig.NumeroComprobanteDespacho</span>
                                    </td>
                                    <td class="text-center">
                                        @if (ig.EstadoDespacho == "DESPACHADA")
                                        {
                                            <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Despachada</span>
                                        }
                                        else if (ig.EstadoDespacho == "NO_DESPACHADA")
                                        {
                                            <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill" title="@ig.MotivoNoDespacho"><i class="bi bi-x-circle-fill me-1"></i>No Despachada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-soft text-warning px-3 py-1.5 rounded-pill"><i class="bi bi-clock-history me-1"></i>Programada</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(ig.NombreReceptor))
                                        {
                                            <div class="small fw-semibold">@ig.NombreReceptor</div>
                                            <div class="text-xs text-muted font-monospace">@ig.DocumentoIdentidadReceptor (@ig.TipoReceptor)</div>
                                        }
                                        else if (!string.IsNullOrEmpty(ig.MotivoNoDespacho))
                                        {
                                            <div class="text-xs text-danger fst-italic">@ig.MotivoNoDespacho</div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-muted">Pendiente de retiro</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-1 flex-wrap">
                                            @if (ig.EstadoDespacho == "PROGRAMADA")
                                            {
                                                if (esCL || esAdmin)
                                                {
                                                    <button class="btn btn-sm btn-success font-semibold shadow-sm" onclick="abrirModalConfirmarDespacho(@ig.IdDespachoIglesia, '@Html.Raw(ig.NombreIglesia.Replace("'","\\'"))')">
                                                        <i class="bi bi-check2-circle me-1"></i>Despachar
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="abrirModalNoDespacho(@ig.IdDespachoIglesia, '@Html.Raw(ig.NombreIglesia.Replace("'","\\'"))')" title="Marcar como No Despachada">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border py-1.5 px-2" title="Solo el Coordinador de Logística (CL) puede ejecutar despachos">
                                                        <i class="bi bi-shield-lock me-1 text-secondary"></i>Exclusivo CL
                                                    </span>
                                                }
                                            }
                                            @if (ig.EstadoDespacho == "DESPACHADA")
                                            {
                                                <a href="@Url.Action("ComprobanteDespacho", "Eventos", new { id = ig.IdDespachoIglesia })" target="_blank" class="btn btn-sm btn-outline-secondary font-semibold">
                                                    <i class="bi bi-printer me-1"></i>Comprobante
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            var cantAsistentesTotal = iglesias.Sum(x => x.AsistentesDetalle.Count);
            <ul class="nav nav-tabs border-bottom-0 mb-3" id="tabEvento" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active font-semibold px-4 border-0 rounded-top-4 shadow-sm" id="iglesias-tab" data-bs-toggle="tab" data-bs-target="#tab-iglesias" type="button" role="tab" aria-selected="true">
                        <i class="bi bi-building me-1"></i>Iglesias Aprobadas (@iglesias.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link font-semibold px-4 border-0 rounded-top-4 ms-2 shadow-sm" id="maestros-tab" data-bs-toggle="tab" data-bs-target="#tab-maestros" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-people me-1"></i>
                        @(evento.TipoEvento == "Vision" ? "Pastores / Líderes" : "Maestros / Asistencia") (@cantAsistentesTotal)
                    </button>
                </li>
            </ul>

        <div class="tab-content" id="tabEventoContent">
            <!-- Pestaña 1: Iglesias Participantes -->
            <div class="tab-pane fade show active" id="tab-iglesias" role="tabpanel" aria-labelledby="iglesias-tab">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="ps-4 text-white">Iglesia</th>
                                        <th class="text-white">Equipo Asignado</th>
                                        <th class="text-white">Pastor / Líder / Asistencia</th>
                                        <th class="text-end pe-4 text-white" style="width: 200px;">Acción / Detalle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!iglesias.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                <i class="bi bi-info-circle fs-2 d-block mb-2 text-slate-300"></i>
                                                No hay iglesias con perfiles aprobados activos para esta temporada.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var ig in iglesias)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="fw-bold text-slate-800">@ig.NombreIglesia</div>
                                                </td>
                                                <td>
                                                    <span class="badge" style="color: #475569; background-color: #f1f5f9; border: 1px solid #cbd5e1; padding: 0.25rem 0.5rem; font-size: 0.75rem;">@ig.NombreEquipo</span>
                                                </td>
                                                <td>
                                                    @if (ig.Asistio)
                                                    {
                                                        <span class="badge bg-success-soft text-success px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Asistió</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-soft text-danger px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>No Asistió / Pendiente</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-4">
                                                    <div class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
                                                        <button type="button" class="btn btn-sm btn-outline-info font-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAsistentes_@ig.IdParticipacion">
                                                            <i class="bi bi-people me-1"></i>Asistentes (@ig.AsistentesDetalle.Count)
                                                        </button>

                                                    </div>

                                                    <!-- MODAL GESTIONAR ASISTENTES DE LA IGLESIA -->
                                                    <div class="modal fade text-start" id="modalAsistentes_@ig.IdParticipacion" tabindex="-1" aria-hidden="true">
                                                        <div class="modal-dialog modal-lg">
                                                            <div class="modal-content border-0 rounded-4 shadow">
                                                                @if (evento.TipoEvento == "Vision")
                                                                {
                                                                    var pastorCheck = ig.AsistentesDetalle.Any(x => x.NombreCompleto.ToLower().Contains(ig.Pastor.Nombres.ToLower()) && x.NombreCompleto.ToLower().Contains(ig.Pastor.Apellidos.ToLower()));
                                                                    var liderCheck = ig.AsistentesDetalle.Any(x => x.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Nombres.ToLower()) && x.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Apellidos.ToLower()));

                                                                    <form action="@Url.Action("GuardarAsistenciaVision", "Eventos")" method="post" onsubmit="return confirm('¿Confirmar la asistencia de los representantes seleccionados a este evento?');">
                                                                        <input type="hidden" name="idEvento" value="@evento.IdEvento" />
                                                                        <input type="hidden" name="idParticipacion" value="@ig.IdParticipacion" />
                                                                        <input type="hidden" name="idIglesia" value="@ig.IdIglesia" />

                                                                        <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                                                                            <h5 class="modal-title font-bold"><i class="bi bi-people-fill me-2 text-info"></i>Asistentes: @ig.NombreIglesia</h5>
                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                        </div>
                                                                        <div class="modal-body p-4">
                                                                            <p class="text-muted small mb-3">Actualiza los datos del Pastor y Líder Ministerial, y selecciona quiénes asistieron a este evento.</p>

                                                                            <!-- Pastor Card -->
                                                                            <div class="card border border-slate-200 rounded-3 mb-3 bg-light">
                                                                                <div class="card-header bg-secondary text-white py-2 font-bold small d-flex justify-content-between align-items-center">
                                                                                    <span><i class="bi bi-person-badge me-1"></i>Datos del Pastor</span>
                                                                                    <div class="form-check m-0">
                                                                                        <input type="checkbox" name="pastorAsistio" value="true" class="form-check-input" id="chkPastorAsistio_@ig.IdParticipacion" @(pastorCheck ? "checked" : "") />
                                                                                        <label class="form-check-label fw-bold text-white small" for="chkPastorAsistio_@ig.IdParticipacion">¿Asistió?</label>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="card-body p-3">
                                                                                    <div class="row g-2">
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Nombres</label>
                                                                                            <input type="text" name="pastor.Nombres" class="form-control form-control-sm" value="@ig.Pastor.Nombres" required />
                                                                                        </div>
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Apellidos</label>
                                                                                            <input type="text" name="pastor.Apellidos" class="form-control form-control-sm" value="@ig.Pastor.Apellidos" required />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Cédula</label>
                                                                                            <input type="text" name="pastor.DocumentoIdentidad" class="form-control form-control-sm" value="@ig.Pastor.DocumentoIdentidad" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Celular</label>
                                                                                            <input type="text" name="pastor.Celular" class="form-control form-control-sm" value="@ig.Pastor.Celular" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Correo</label>
                                                                                            <input type="email" name="pastor.Correo" class="form-control form-control-sm" value="@ig.Pastor.Correo" required placeholder="pastor@ejemplo.com" />
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <!-- Líder Ministerial Card -->
                                                                            <div class="card border border-slate-200 rounded-3 bg-light">
                                                                                <div class="card-header bg-dark text-white py-2 font-bold small d-flex justify-content-between align-items-center">
                                                                                    <span><i class="bi bi-person-workspace me-1"></i>Datos del Líder Ministerial</span>
                                                                                    <div class="form-check m-0">
                                                                                        <input type="checkbox" name="liderAsistio" value="true" class="form-check-input" id="chkLiderAsistio_@ig.IdParticipacion" @(liderCheck ? "checked" : "") />
                                                                                        <label class="form-check-label fw-bold text-white small" for="chkLiderAsistio_@ig.IdParticipacion">¿Asistió?</label>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="card-body p-3">
                                                                                    <div class="row g-2">
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Nombres</label>
                                                                                            <input type="text" name="lider.Nombres" class="form-control form-control-sm" value="@ig.LiderMinisterial.Nombres" required />
                                                                                        </div>
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Apellidos</label>
                                                                                            <input type="text" name="lider.Apellidos" class="form-control form-control-sm" value="@ig.LiderMinisterial.Apellidos" required />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Cédula</label>
                                                                                            <input type="text" name="lider.DocumentoIdentidad" class="form-control form-control-sm" value="@ig.LiderMinisterial.DocumentoIdentidad" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Celular</label>
                                                                                            <input type="text" name="lider.Celular" class="form-control form-control-sm" value="@ig.LiderMinisterial.Celular" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Correo</label>
                                                                                            <input type="email" name="lider.Correo" class="form-control form-control-sm" value="@ig.LiderMinisterial.Correo" required placeholder="lider@ejemplo.com" />
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                            @if (eventoPasado && u.IdRolSeguridad != 1 && u.IdRolSeguridad != 2)
                                                                            {
                                                                                <button type="button" class="btn btn-secondary font-semibold" disabled title="El evento ya pasó"><i class="bi bi-lock me-1"></i>Evento Pasado (Solo Lectura)</button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Confirmar y Guardar Asistencia</button>
                                                                            }
                                                                        </div>
                                                                    </form>
                                                                }
                                                                else if (evento.TipoEvento == "Taller")
                                                                {
                                                                    var liderCheck = ig.AsistentesDetalle.Any(x => x.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Nombres.ToLower()) && x.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Apellidos.ToLower()));

                                                                    <form action="@Url.Action("GuardarAsistenciaTaller", "Eventos")" method="post" onsubmit="return confirm('¿Confirmar la asistencia de los maestros y representantes a este Taller OCC?');">
                                                                        <input type="hidden" name="idEvento" value="@evento.IdEvento" />
                                                                        <input type="hidden" name="idParticipacion" value="@ig.IdParticipacion" />
                                                                        <input type="hidden" name="idIglesia" value="@ig.IdIglesia" />

                                                                        <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                                                                            <h5 class="modal-title font-bold"><i class="bi bi-book-half me-2 text-info"></i>Asistencia Taller: @ig.NombreIglesia</h5>
                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                        </div>
                                                                        <div class="modal-body p-4">
                                                                            <p class="text-muted small mb-3">Actualiza los datos del Líder Ministerial y de los Maestros de discipulado, y marca quiénes asistieron al Taller.</p>

                                                                            <!-- Líder Ministerial Card -->
                                                                            <div class="card border border-slate-200 rounded-3 mb-4 bg-light">
                                                                                <div class="card-header bg-dark text-white py-2 font-bold small d-flex justify-content-between align-items-center">
                                                                                    <span><i class="bi bi-person-workspace me-1"></i>Líder Ministerial</span>
                                                                                    <div class="form-check m-0">
                                                                                        <input type="checkbox" name="liderAsistio" value="true" class="form-check-input" id="chkTallerLider_@ig.IdParticipacion" @(liderCheck ? "checked" : "") />
                                                                                        <label class="form-check-label fw-bold text-white small" for="chkTallerLider_@ig.IdParticipacion">¿Asistió?</label>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="card-body p-3">
                                                                                    <div class="row g-2">
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Nombres</label>
                                                                                            <input type="text" name="lider.Nombres" class="form-control form-control-sm" value="@ig.LiderMinisterial.Nombres" required />
                                                                                        </div>
                                                                                        <div class="col-md-6">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Apellidos</label>
                                                                                            <input type="text" name="lider.Apellidos" class="form-control form-control-sm" value="@ig.LiderMinisterial.Apellidos" required />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Cédula</label>
                                                                                            <input type="text" name="lider.DocumentoIdentidad" class="form-control form-control-sm" value="@ig.LiderMinisterial.DocumentoIdentidad" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Celular</label>
                                                                                            <input type="text" name="lider.Celular" class="form-control form-control-sm" value="@ig.LiderMinisterial.Celular" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                                                                        </div>
                                                                                        <div class="col-md-4">
                                                                                            <label class="form-label text-xs fw-semibold mb-1">Correo</label>
                                                                                            <input type="email" name="lider.Correo" class="form-control form-control-sm" value="@ig.LiderMinisterial.Correo" required placeholder="lider@ejemplo.com" />
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </div>

                                                                            <!-- Maestros Section -->
                                                                            <h6 class="font-bold text-slate-800 mb-2"><i class="bi bi-people me-1 text-primary"></i>Maestros Registrados</h6>
                                                                            <div id="contenedorMaestrosTaller_@ig.IdParticipacion">
                                                                                @for (int mIdx = 0; mIdx < ig.Maestros.Count; mIdx++)
                                                                                {
                                                                                    var m = ig.Maestros[mIdx];
                                                                                    var mChecked = ig.AsistentesDetalle.Any(x => x.NombreCompleto.ToLower().Contains(m.Nombres.ToLower()) && x.NombreCompleto.ToLower().Contains(m.Apellidos.ToLower()));
                                                                                    <div class="card bg-light border p-3 rounded-3 item-maestro-existente mb-3">
                                                                                        <input type="hidden" name="maestros[@mIdx].IdMaestro" value="@m.IdMaestro" />
                                                                                        <div class="row g-2">
                                                                                            <div class="col-md-4">
                                                                                                <label class="form-label small fw-semibold">Nombres del Maestro <span class="text-danger">*</span></label>
                                                                                                <input type="text" name="maestros[@mIdx].Nombres" class="form-control form-control-sm" value="@m.Nombres" required />
                                                                                            </div>
                                                                                            <div class="col-md-4">
                                                                                                <label class="form-label small fw-semibold">Apellidos <span class="text-danger">*</span></label>
                                                                                                <input type="text" name="maestros[@mIdx].Apellidos" class="form-control form-control-sm" value="@m.Apellidos" required />
                                                                                            </div>
                                                                                            <div class="col-md-4">
                                                                                                <label class="form-label small fw-semibold">Cédula</label>
                                                                                                <input type="text" name="maestros[@mIdx].DocumentoIdentidad" class="form-control form-control-sm" value="@m.DocumentoIdentidad" pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                                                                            </div>
                                                                                            <div class="col-md-5">
                                                                                                <label class="form-label small fw-semibold">Celular</label>
                                                                                                <input type="text" name="maestros[@mIdx].Celular" class="form-control form-control-sm" value="@m.Celular" pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                                                                            </div>
                                                                                            <div class="col-md-5">
                                                                                                <label class="form-label small fw-semibold">Correo</label>
                                                                                                <input type="email" name="maestros[@mIdx].Correo" class="form-control form-control-sm" value="@m.Correo" placeholder="maestro@correo.com" />
                                                                                            </div>
                                                                                            <div class="col-md-2 d-flex align-items-end justify-content-center">
                                                                                                <div class="form-check mb-2">
                                                                                                    <input type="checkbox" name="maestrosAsistieronIds" value="@m.IdMaestro" class="form-check-input" id="chkM_@m.IdMaestro" @(mChecked ? "checked" : "") />
                                                                                                    <label class="form-check-label fw-semibold text-xs" for="chkM_@m.IdMaestro">Asistió</label>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            @if (!eventoPasado || u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2)
                                                                            {
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="agregarFilaMaestroNuevo('contenedorMaestrosTaller_@ig.IdParticipacion')">
                                                                                    <i class="bi bi-plus-circle me-1"></i>Registrar Nuevo Maestro en Taller
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                        <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                                            @if (eventoPasado && u.IdRolSeguridad != 1 && u.IdRolSeguridad != 2)
                                                                            {
                                                                                <button type="button" class="btn btn-secondary font-semibold" disabled title="El evento ya pasó"><i class="bi bi-lock me-1"></i>Evento Pasado (Solo Lectura)</button>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Confirmar y Guardar Asistencia</button>
                                                                            }
                                                                        </div>
                                                                    </form>
                                                                }
                                                                else
                                                                {
                                                                    <form action="@Url.Action("GuardarAsistentes", "Eventos")" method="post">
                                                                        <input type="hidden" name="idEvento" value="@evento.IdEvento" />
                                                                        <input type="hidden" name="idParticipacion" value="@ig.IdParticipacion" />
                                                                        <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                                                                            <h5 class="modal-title font-bold"><i class="bi bi-people-fill me-2 text-info"></i>Asistentes: @ig.NombreIglesia</h5>
                                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                        </div>
                                                                        <div class="modal-body p-4">
                                                                            <p class="text-muted small mb-3">Registra o edita los datos de las personas que asistieron por parte de esta iglesia (pastores, líderes, voluntarios).</p>
                                                                            
                                                                            <div id="contenedorAsistentes_@ig.IdParticipacion" class="d-flex flex-column gap-3 mb-3">
                                                                                @if (ig.AsistentesDetalle.Any())
                                                                                {
                                                                                    for (int idx = 0; idx < ig.AsistentesDetalle.Count; idx++)
                                                                                    {
                                                                                        var a = ig.AsistentesDetalle[idx];
                                                                                        <div class="card bg-light border p-3 rounded-3 item-asistente">
                                                                                            <div class="row g-2">
                                                                                                <div class="col-md-4">
                                                                                                    <label class="form-label small fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
                                                                                                    <input type="text" name="asistentes[@idx].NombreCompleto" class="form-control form-control-sm" value="@a.NombreCompleto" required @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    <label class="form-label small fw-semibold">Cédula / Identidad</label>
                                                                                                    <input type="text" name="asistentes[@idx].Identificacion" class="form-control form-control-sm" value="@a.Identificacion" placeholder="001-0000000-0" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                                </div>
                                                                                                <div class="col-md-2">
                                                                                                    <label class="form-label small fw-semibold">Teléfono</label>
                                                                                                    <input type="text" name="asistentes[@idx].Telefono" class="form-control form-control-sm" value="@a.Telefono" placeholder="809-555-5555" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                                </div>
                                                                                                <div class="col-md-3">
                                                                                                    <label class="form-label small fw-semibold">Correo Electrónico</label>
                                                                                                    <div class="d-flex gap-1">
                                                                                                        <input type="email" name="asistentes[@idx].Correo" class="form-control form-control-sm" value="@a.Correo" placeholder="correo@ejemplo.com" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                                        @if (puedeEditar)
                                                                                                        {
                                                                                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.item-asistente').remove();"><i class="bi bi-trash"></i></button>
                                                                                                        }
                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="card bg-light border p-3 rounded-3 item-asistente">
                                                                                        <div class="row g-2">
                                                                                            <div class="col-md-4">
                                                                                                <label class="form-label small fw-semibold">Nombre Completo <span class="text-danger">*</span></label>
                                                                                                <input type="text" name="asistentes[0].NombreCompleto" class="form-control form-control-sm" required placeholder="Ej: Juan Pérez" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                <label class="form-label small fw-semibold">Cédula / Identidad</label>
                                                                                                <input type="text" name="asistentes[0].Identificacion" class="form-control form-control-sm" placeholder="001-0000000-0" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                            </div>
                                                                                            <div class="col-md-2">
                                                                                                <label class="form-label small fw-semibold">Teléfono</label>
                                                                                                <input type="text" name="asistentes[0].Telefono" class="form-control form-control-sm" placeholder="809-555-5555" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                            </div>
                                                                                            <div class="col-md-3">
                                                                                                <label class="form-label small fw-semibold">Correo Electrónico</label>
                                                                                                <div class="d-flex gap-1">
                                                                                                    <input type="email" name="asistentes[0].Correo" class="form-control form-control-sm" placeholder="correo@ejemplo.com" @(!puedeEditar ? "readonly=\"readonly\"" : "") />
                                                                                                    @if (puedeEditar)
                                                                                                    {
                                                                                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.item-asistente').remove();"><i class="bi bi-trash"></i></button>
                                                                                                    }
                                                                                                </div>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                }
                                                                            </div>

                                                                            @if (puedeEditar)
                                                                            {
                                                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="agregarFilaAsistente('contenedorAsistentes_@ig.IdParticipacion')">
                                                                                    <i class="bi bi-plus-circle me-1"></i>Agregar Asistente
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                        <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                                                            @if (puedeEditar)
                                                                            {
                                                                                <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Guardar y Confirmar Asistencia</button>
                                                                            }
                                                                        </div>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pestaña 2: Listado de Asistentes Confirmados -->
            <div class="tab-pane fade" id="tab-maestros" role="tabpanel" aria-labelledby="maestros-tab">
                <div class="card border-0 shadow-sm rounded-4 bg-white mb-3">
                    <div class="card-header bg-light py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-slate-800">
                            <i class="bi bi-person-check me-2 text-primary"></i>
                            @(evento.TipoEvento == "Vision" ? "Asistentes Registrados (Pastores / Líderes)" : "Asistentes Registrados (Líderes / Maestros)")
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Representante / Asistente</th>
                                        <th>Iglesia</th>
                                        <th>Rol / Relación</th>
                                        <th>Identificación</th>
                                        <th>Contacto</th>
                                        <th class="text-end pe-4">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var asistentesList = new List<dynamic>();
                                        foreach (var ig in iglesias)
                                        {
                                            foreach (var a in ig.AsistentesDetalle)
                                            {
                                                string rol = "Representante";
                                                if (evento.TipoEvento == "Vision")
                                                {
                                                    if (ig.Pastor != null && !string.IsNullOrEmpty(ig.Pastor.Nombres) && a.NombreCompleto.ToLower().Contains(ig.Pastor.Nombres.ToLower()))
                                                    {
                                                        rol = "Pastor";
                                                    }
                                                    else if (ig.LiderMinisterial != null && !string.IsNullOrEmpty(ig.LiderMinisterial.Nombres) && a.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Nombres.ToLower()))
                                                    {
                                                        rol = "Líder Ministerial";
                                                    }
                                                }
                                                else
                                                {
                                                    if (ig.LiderMinisterial != null && !string.IsNullOrEmpty(ig.LiderMinisterial.Nombres) && a.NombreCompleto.ToLower().Contains(ig.LiderMinisterial.Nombres.ToLower()))
                                                    {
                                                        rol = "Líder Ministerial";
                                                    }
                                                    else
                                                    {
                                                        rol = "Maestro";
                                                    }
                                                }

                                                asistentesList.Add(new {
                                                    IdAsistente = a.IdAsistente,
                                                    Nombre = a.NombreCompleto,
                                                    Iglesia = ig.NombreIglesia,
                                                    Rol = rol,
                                                    Identificacion = a.Identificacion,
                                                    Telefono = a.Telefono,
                                                    Correo = a.Correo
                                                });
                                            }
                                        }
                                    }

                                    @if (!asistentesList.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="bi bi-person-x fs-2 d-block mb-2 text-slate-300"></i>
                                                No hay asistentes confirmados para este evento todavía.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var ast in asistentesList)
                                        {
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="fw-bold text-slate-800">@ast.Nombre</div>
                                                </td>
                                                <td>
                                                    <strong class="text-dark">@ast.Iglesia</strong>
                                                </td>
                                                <td>
                                                    <span class="badge @(ast.Rol == "Pastor" ? "bg-primary-soft text-primary" : (ast.Rol == "Líder Ministerial" ? "bg-info-soft text-info" : "bg-success-soft text-success")) border">
                                                        @ast.Rol
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="font-monospace text-slate-600">@(string.IsNullOrEmpty(ast.Identificacion) ? "N/D" : ast.Identificacion)</span>
                                                </td>
                                                <td>
                                                    <div class="small"><i class="bi bi-telephone text-muted me-1"></i>@(string.IsNullOrEmpty(ast.Telefono) ? "N/D" : ast.Telefono)</div>
                                                    <div class="text-xs text-muted"><i class="bi bi-envelope text-muted me-1"></i>@(string.IsNullOrEmpty(ast.Correo) ? "N/D" : ast.Correo)</div>
                                                </td>
                                                <td class="text-end pe-4">
                                                    @if (puedeEditar)
                                                    {
                                                        if (eventoPasado && u.IdRolSeguridad != 1 && u.IdRolSeguridad != 2)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled title="El evento ya pasó. No se puede modificar la asistencia histórica.">
                                                                <i class="bi bi-lock me-1"></i>Inhabilitado
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-asistencia-maestro"
                                                                    data-id-asistente="@ast.IdAsistente"
                                                                    data-id-evento="@evento.IdEvento"
                                                                    data-nombre="@ast.Nombre"
                                                                    title="Retirar de esta asistencia">
                                                                <i class="bi bi-trash me-1"></i>Eliminar
                                                            </button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var checkAll = document.getElementById("checkAllMaestros");
        if(checkAll) {
            checkAll.addEventListener("change", function() {
                var checkboxes = document.querySelectorAll(".check-maestro");
                for (var checkbox of checkboxes) {
                    checkbox.checked = this.checked;
                }
            });
        }

        // Restaurar pestaña activa anterior
        var eventoId = '@evento.IdEvento';
        var storedTabId = localStorage.getItem('activeEventoTab_' + eventoId);
        if (storedTabId) {
            var tabBtn = document.getElementById(storedTabId);
            if (tabBtn) {
                var tab = new bootstrap.Tab(tabBtn);
                tab.show();
            }
        }

        // Guardar pestaña seleccionada
        var tabElements = document.querySelectorAll('#tabEvento button[data-bs-toggle="tab"]');
        tabElements.forEach(function(el) {
            el.addEventListener('shown.bs.tab', function(e) {
                localStorage.setItem('activeEventoTab_' + eventoId, e.target.id);
            });
        });

        // Manejador AJAX para los formularios de asistencia del evento
        $(document).on('submit', 'form[action*="RegistrarAsistenciaIglesia"], form[action*="GuardarAsistenciaVision"], form[action*="GuardarAsistenciaTaller"]', function(e) {
            e.preventDefault();
            var formEl = this;
            var $form = $(this);
            
            if (!formEl.checkValidity()) {
                e.stopPropagation();
                $form.addClass('was-validated');
                alert('Por favor, complete todos los datos obligatorios correctamente antes de confirmar la asistencia.');
                return false;
            }

            var $btn = $form.find('button[type="submit"]');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Guardando...');
            
            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize(),
                success: function() {
                    // Ocultar modal si existe
                    var $modal = $form.closest('.modal');
                    if ($modal.length) {
                        var modalInstance = bootstrap.Modal.getInstance($modal[0]);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                    location.reload();
                },
                error: function() {
                    alert('Error al registrar la asistencia.');
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // Manejador para retirar maestro de la asistencia
        $(document).on('click', '.btn-eliminar-asistencia-maestro', function(e) {
            e.preventDefault();
            var $btn = $(this);
            var idAsistente = $btn.data('id-asistente');
            var idEvento = $btn.data('id-evento');
            var nombre = $btn.data('nombre') || 'este maestro';

            if (!confirm('¿Está seguro de que desea retirar a "' + nombre + '" de la asistencia de este evento?\n\nNota: El maestro NO será eliminado del sistema, únicamente se retirará de esta asistencia.')) {
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val() || $('[name="__RequestVerificationToken"]').val();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Eliminando...');

            $.ajax({
                url: '@Url.Action("EliminarMaestroDeAsistencia", "Eventos")',
                type: 'POST',
                data: {
                    idEvento: idEvento,
                    idAsistente: idAsistente,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    if (response.success) {
                        var $row = $btn.closest('tr');
                        $row.fadeOut(300, function() {
                            $(this).remove();
                            location.reload();
                        });
                    } else {
                        alert(response.message || 'No se pudo retirar el maestro de la asistencia.');
                        $btn.prop('disabled', false).html('<i class="bi bi-trash me-1"></i>Eliminar');
                    }
                },
                error: function(xhr) {
                    var msg = 'Error en el servidor al intentar retirar al maestro de la asistencia.';
                    if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    } else if (xhr && xhr.responseText && xhr.responseText.indexOf('anti-forgery') !== -1) {
                        msg = 'Error de seguridad con el token de verificación. Por favor recargue la página.';
                    } else if (xhr && xhr.status === 403) {
                        msg = 'No tiene permisos para modificar la asistencia de este evento.';
                    }
                    alert(msg);
                    $btn.prop('disabled', false).html('<i class="bi bi-trash me-1"></i>Eliminar');
                }
            });
        });
    });

