    // =========================================================================
    // FUNCIONES DE DESPACHO PRESENCIAL
    // =========================================================================
    var datosReceptorActual = {};

    function abrirModalConfirmarDespacho(idDespacho, nombreIglesia) {
        document.getElementById('hdIdDespachoConfirmar').value = idDespacho;
        document.getElementById('txtNombreIglesiaConfirmar').innerText = nombreIglesia;
        
        var tbody = document.getElementById('tbodyMaterialesDespacho');
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Cargando materiales y datos institucionales...</td></tr>';

        var modal = new bootstrap.Modal(document.getElementById('modalConfirmarDespacho'));
        modal.show();

        fetch('@Url.Action("ObtenerDespachoMateriales", "Eventos")?id=' + idDespacho)
            .then(function(res) { return res.json(); })
            .then(function(data) {
                datosReceptorActual = data;
                
                // Mostrar datos del Pastor
                var nomPastor = data.nombrePastor && data.nombrePastor.trim() !== '' ? data.nombrePastor : 'Pastor No Asignado';
                var cedPastor = data.cedulaPastor && data.cedulaPastor.trim() !== '' ? data.cedulaPastor : 'Sin documento';
                var telPastor = data.telefonoPastor && data.telefonoPastor.trim() !== '' ? data.telefonoPastor : 'Sin teléfono';
                document.getElementById('txtPastorNombre').innerText = nomPastor;
                document.getElementById('txtPastorCedula').innerText = cedPastor;
                document.getElementById('txtPastorTelefono').innerText = telPastor;

                // Mostrar datos del Líder Ministerial
                var nomLider = data.nombreLider && data.nombreLider.trim() !== '' ? data.nombreLider : 'Líder No Asignado';
                var cedLider = data.cedulaLider && data.cedulaLider.trim() !== '' ? data.cedulaLider : 'Sin documento';
                var telLider = data.telefonoLider && data.telefonoLider.trim() !== '' ? data.telefonoLider : 'Sin teléfono';
                document.getElementById('txtLiderNombre').innerText = nomLider;
                document.getElementById('txtLiderCedula').innerText = cedLider;
                document.getElementById('txtLiderTelefono').innerText = telLider;

                // Seleccionar Pastor por defecto
                document.getElementById('optReceptorPastor').checked = true;
                seleccionarOpcionReceptor('PASTOR');

                // Si no hay Líder registrado, deshabilitar esa opción
                var tieneLider = data.nombreLider && data.nombreLider.trim() !== '';
                document.getElementById('optReceptorLider').disabled = !tieneLider;
                document.getElementById('optReceptorAmbos').disabled = !tieneLider;

                // Cargar materiales
                tbody.innerHTML = '';
                var mats = data.materiales || [];
                if (!mats || mats.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No hay materiales configurados para esta asignación.</td></tr>';
                    return;
                }
                mats.forEach(function(m) {
                    var cantDefecto = m.CantidadAsignada;
                    var tr = document.createElement('tr');
                    tr.className = 'fila-material-despacho';
                    tr.dataset.id = m.IdMaterial;
                    tr.dataset.asignada = m.CantidadAsignada;

                    var badgeClass = 'bg-primary-soft text-primary border border-primary-subtle';
                    if (m.CodigoMaterial === 'OE') badgeClass = 'bg-info-soft text-info border border-info-subtle';
                    else if (m.CodigoMaterial === 'MR') badgeClass = 'bg-primary-soft text-primary border border-primary-subtle';
                    else if (m.CodigoMaterial === 'GA') badgeClass = 'bg-success-soft text-success border border-success-subtle';
                    else if (m.CodigoMaterial === 'GM') badgeClass = 'bg-warning-soft text-warning border border-warning-subtle';
                    else if (m.CodigoMaterial === 'NT') badgeClass = 'bg-secondary-soft text-secondary border border-secondary-subtle';
                    else if (m.CodigoMaterial === 'PO') badgeClass = 'bg-purple-soft text-purple border border-purple-subtle';

                    tr.innerHTML = `
                        <td><span class="badge ${badgeClass} me-2 font-mono">${m.CodigoMaterial}</span><strong class="text-slate-800">${m.NombreMaterial}</strong></td>
                        <td class="text-center text-muted">${m.UnidadEntrega}</td>
                        <td class="text-center fw-semibold">${m.CantidadAsignada}</td>
                        <td style="max-width:130px">
                            <input type="number" class="form-control form-control-sm text-center fw-bold inp-cant-despachar"
                                value="${cantDefecto}" min="0" max="${m.CantidadAsignada}" required />
                        </td>
                        <td class="text-center text-muted text-xs status-dif">${cantDefecto === m.CantidadAsignada ? 'Completa' : 'Parcial'}</td>
                    `;
                    tbody.appendChild(tr);
                });

                tbody.querySelectorAll('.inp-cant-despachar').forEach(function(inp) {
                    inp.addEventListener('input', function() {
                        var tr = this.closest('tr');
                        var asig = parseInt(tr.dataset.asignada) || 0;
                        var val = parseInt(this.value) || 0;
                        var st = tr.querySelector('.status-dif');
                        if (val === asig) {
                            st.innerText = 'Completa';
                            st.className = 'text-center text-xs text-success fw-semibold status-dif';
                        } else if (val === 0) {
                            st.innerText = 'No entregado';
                            st.className = 'text-center text-xs text-danger fw-semibold status-dif';
                        } else {
                            st.innerText = 'Parcial (' + (asig - val) + ' pend.)';
                            st.className = 'text-center text-xs text-warning fw-semibold status-dif';
                        }
                    });
                });
            })
            .catch(function(err) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-3">Error al cargar materiales: ' + err + '</td></tr>';
            });
    }

    function seleccionarOpcionReceptor(tipo) {
        document.getElementById('hdTipoReceptor').value = tipo;
        var nomPastor = datosReceptorActual.nombrePastor || 'Pastor General';
        var cedPastor = datosReceptorActual.cedulaPastor || 'No registrada';
        var telPastor = datosReceptorActual.telefonoPastor || 'Sin teléfono';

        var nomLider = datosReceptorActual.nombreLider || 'Líder Ministerial';
        var cedLider = datosReceptorActual.cedulaLider || 'No registrada';
        var telLider = datosReceptorActual.telefonoLider || 'Sin teléfono';

        if (tipo === 'PASTOR') {
            document.getElementById('hdNombreReceptor').value = nomPastor;
            document.getElementById('hdCedulaReceptor').value = cedPastor;
            document.getElementById('hdDocumentoCedulaReceptor').value = cedPastor;
            document.getElementById('hdTelReceptor').value = telPastor;
            document.getElementById('txtReceptorResumen').innerHTML = `<i class="bi bi-person-check-fill text-primary me-1"></i><strong>${nomPastor}</strong> <span class="badge bg-primary-soft text-primary ms-1">Pastor General</span>`;
            document.getElementById('txtCedulaResumen').innerText = cedPastor;
            document.getElementById('txtTelefonoResumen').innerText = telPastor;
        } else if (tipo === 'LIDER_MINISTERIAL') {
            document.getElementById('hdNombreReceptor').value = nomLider;
            document.getElementById('hdCedulaReceptor').value = cedLider;
            document.getElementById('hdDocumentoCedulaReceptor').value = cedLider;
            document.getElementById('hdTelReceptor').value = telLider;
            document.getElementById('txtReceptorResumen').innerHTML = `<i class="bi bi-person-check-fill text-info me-1"></i><strong>${nomLider}</strong> <span class="badge bg-info-soft text-info ms-1">Líder Ministerial</span>`;
            document.getElementById('txtCedulaResumen').innerText = cedLider;
            document.getElementById('txtTelefonoResumen').innerText = telLider;
        } else if (tipo === 'AMBOS') {
            var nombres = nomPastor + ' y ' + nomLider;
            var cedulas = cedPastor + ' / ' + cedLider;
            var tels = (telPastor !== 'Sin teléfono' ? telPastor : '') + (telLider !== 'Sin teléfono' ? ' • ' + telLider : '');
            if (!tels.trim()) tels = 'Sin teléfonos registrados';
            document.getElementById('hdNombreReceptor').value = nombres;
            document.getElementById('hdCedulaReceptor').value = cedulas;
            document.getElementById('hdDocumentoCedulaReceptor').value = cedulas;
            document.getElementById('hdTelReceptor').value = tels;
            document.getElementById('txtReceptorResumen').innerHTML = `<i class="bi bi-people-fill text-success me-1"></i><strong>${nomPastor}</strong> (Pastor) y <strong>${nomLider}</strong> (Líder)`;
            document.getElementById('txtCedulaResumen').innerText = cedulas;
            document.getElementById('txtTelefonoResumen').innerText = tels;
        }
    }

    function serializarMaterialesDespacho() {
        var items = [];
        var cantDict = {};
        document.querySelectorAll('.fila-material-despacho').forEach(function(tr) {
            var idMat = parseInt(tr.dataset.id);
            var asig = parseInt(tr.dataset.asignada) || 0;
            var desp = parseInt(tr.querySelector('.inp-cant-despachar').value) || 0;
            items.push({
                IdMaterial: idMat,
                CantidadAsignada: asig,
                CantidadDespachada: desp
            });
            cantDict[idMat.toString()] = desp;
        });
        document.getElementById('hdMaterialesJson').value = JSON.stringify(items);
        document.getElementById('hdCantidadesJson').value = JSON.stringify(cantDict);
        return true;
    }

    function abrirModalNoDespacho(idDespacho, nombreIglesia) {
        document.getElementById('hdIdDespachoNoDespacho').value = idDespacho;
        document.getElementById('txtNombreIglesiaNoDespacho').innerText = nombreIglesia;
        document.getElementById('txtMotivoNoDespacho').value = '';
        new bootstrap.Modal(document.getElementById('modalNoDespacho')).show();
    }
</script>

