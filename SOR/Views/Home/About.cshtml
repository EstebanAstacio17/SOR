@{
    ViewBag.Title = "Acerca de SOR | OCC Rep Dom";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-dark text-white p-4 text-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <i class="bi bi-box-seam-fill fs-1 text-sky-400 mb-2" style="color: #38bdf8;"></i>
                <h1 class="h3 font-bold mb-1">Sistema de Gestión Interna OCC República Dominicana (SOR)</h1>
                <p class="text-slate-300 mb-0">Operation Christmas Child RD &bull; Samaritan's Purse</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="mb-4">
                    <h3 class="h5 font-bold text-primary border-bottom pb-2">Propósito del Sistema</h3>
                    <p class="text-muted leading-relaxed">
                        El <strong>SOR</strong> (Sistema de Operaciones Regionales) es la plataforma integral diseñada para optimizar, coordinar y acompañar toda la labor de los Equipos de Liderazgo Nacional (ENL), Estratégicos (ERLE) y Regionales (ERL) de <em>Operation Christmas Child</em> en la República Dominicana.
                    </p>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h4 class="h6 font-bold text-dark"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Jerarquía y Equipos</h4>
                            <p class="text-muted small mb-0">
                                Gestión estructurada de voluntarios por niveles (ENL, ERLE, ERL) y 6 roles clave: Coordinador de Equipo, Movilización, Discipulado, Logística, Oración y Recursos.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h4 class="h6 font-bold text-dark"><i class="bi bi-building-fill text-success me-2"></i>Gestión de Iglesias</h4>
                            <p class="text-muted small mb-0">
                                Expediente completo de iglesias socias, pastores, líderes de discipulado, maestros capacitados y seguimiento por temporadas.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h4 class="h6 font-bold text-dark"><i class="bi bi-book-fill text-warning me-2"></i>La Gran Aventura</h4>
                            <p class="text-muted small mb-0">
                                Control de despachos de materiales de discipulado, eventos evangelísticos y reportes de vidas transformadas por el Evangelio.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 rounded-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                        <div>
                            <strong>Compromiso y Transparencia:</strong> Todos los datos administrados en esta plataforma están protegidos y destinados exclusivamente al cumplimiento de la Gran Comisión.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
