@{
    ViewBag.Title = "Panel Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuario = (SOR.Models.Usuario)ViewBag.Usuario ?? new SOR.Models.Usuario { Correo = "Usuario", NombreRol = "Coordinador" };
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
            <div class="card-body p-4 text-white">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-semibold mb-2">
                            <i class="bi bi-shield-check me-1"></i>@(usuario.NombreRol ?? "Coordinador")
                        </span>
                        <h2 class="h3 font-bold mb-1">¡Bienvenido, @usuario.Correo!</h2>
                        <p class="text-slate-300 mb-0">
                            <i class="bi bi-diagram-3 me-1"></i>Equipo: <strong>@(usuario.NombreEquipo ?? "Sin Equipo Asignado")</strong> | 
                            <i class="bi bi-person-badge me-1"></i>Posición: <strong>@(usuario.NombrePosicion ?? "Pendiente de Completar Perfil")</strong>
                        </p>
                    </div>
                    <div>
                        <!-- Estado Activo Removido -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Área Designada de Notificaciones -->
@{
    var notifs = SOR.Controllers.IglesiaController.ObtenerNotificacionesUsuario(usuario.IdUsuario);
}
@if (notifs != null && notifs.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="h6 font-bold text-slate-800 mb-3 border-bottom pb-2">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Notificaciones de Cambios de Equipo / Incorporaciones
                </h5>
                <div class="d-flex flex-column gap-2">
                    @foreach (var n in notifs)
                    {
                        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-warning rounded-3 d-flex align-items-center justify-content-between p-3 m-0" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-info-circle-fill text-warning fs-5 me-3"></i>
                                <div>
                                    <span class="fw-semibold text-slate-800">@n.Mensaje</span>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Recibido: @n.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")</small>
                                </div>
                            </div>
                            <form action="@Url.Action("MarcarNotificacionLeida", "Iglesia")" method="post" class="m-0 ms-3">
                                <input type="hidden" name="idNotificacion" value="@n.IdNotificacion" />
                                <button type="submit" class="btn btn-sm btn-dark font-semibold rounded-pill px-3 py-1 text-nowrap">
                                    <i class="bi bi-check-lg me-1"></i>Marcar como Vista
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Tarjetas de Resumen y Accesos Rápidos -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Iglesias Registradas</span>
                    <h3 class="h2 font-bold mb-0 mt-1" style="color: #0284c7;">0</h3>
                </div>
                <div class="p-3 bg-sky-50 rounded-3 text-sky-600" style="background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-building fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Temporada Activa</span>
                    <h3 class="h2 font-bold mb-0 mt-1 text-success">2026</h3>
                </div>
                <div class="p-3 bg-emerald-50 rounded-3 text-emerald-600" style="background: #dcfce7; color: #16a34a;">
                    <i class="bi bi-calendar-event fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Solicitudes Pendientes</span>
                    <h3 class="h2 font-bold mb-0 mt-1 text-warning">0</h3>
                </div>
                <div class="p-3 bg-amber-50 rounded-3 text-amber-600" style="background: #fef3c7; color: #d97706;">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Nivel Jerárquico</span>
                    <h3 class="h2 font-bold mb-0 mt-1 text-indigo" style="color: #4f46e5;">@(usuario.NombreNivel ?? (usuario.RangoJerarquico == 1 ? "ENL" : usuario.RangoJerarquico == 2 ? "ERLE" : "ERL"))</h3>
                </div>
                <div class="p-3 rounded-3 text-indigo" style="background: #e0e7ff; color: #4f46e5;">
                    <i class="bi bi-diagram-2 fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4 h-100">
            <h4 class="h5 font-bold mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Actividad Reciente del Sistema</h4>
            <div class="alert alert-light border rounded-3 p-3 text-muted">
                <i class="bi bi-info-circle me-2"></i>Bienvenido al Sistema de Gestión Interna SOR. La plataforma ha sido inicializada y configurada correctamente con los niveles jerárquicos y roles de OCC RD.
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white p-4 h-100">
            <h4 class="h5 font-bold mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i>Seguridad e Inactividad</h4>
            <p class="text-muted small">
                Por políticas de seguridad de OCC RD, el sistema cerrará automáticamente la sesión tras <strong>5 minutos de inactividad</strong>.
            </p>
            <div class="p-3 bg-light rounded-3">
                <small class="text-muted d-block mb-1">Última marca de actividad:</small>
                <strong class="text-dark"><i class="bi bi-stopwatch me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</strong>
            </div>
        </div>
    </div>
</div>