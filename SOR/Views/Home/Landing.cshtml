@{
    ViewBag.Title = "Bienvenido a OCC República Dominicana | SOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0369a1 100%);
        color: #ffffff;
        padding: 80px 20px;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        margin-top: 20px;
        position: relative;
        overflow: hidden;
    }

    .hero-banner::before {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.1) 0%, transparent 60%);
        pointer-events: none;
    }

    .hero-title {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -1px;
        line-height: 1.2;
        margin-bottom: 20px;
        background: linear-gradient(90deg, #ffffff, #7dd3fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: #cbd5e1;
        max-width: 800px;
        margin: 0 auto 30px auto;
        line-height: 1.6;
    }

    .quote-box {
        background: rgba(255, 255, 255, 0.07);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 30px;
        border-radius: 16px;
        margin: 30px auto;
        max-width: 850px;
        text-align: left;
    }

    .quote-text {
        font-size: 1.15rem;
        font-style: italic;
        color: #e2e8f0;
        line-height: 1.7;
    }

    .btn-action-primary {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff !important;
        font-weight: 600;
        padding: 14px 32px;
        font-size: 1.1rem;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(2, 132, 199, 0.6);
        color: #ffffff !important;
    }

    .btn-action-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-weight: 600;
        padding: 14px 32px;
        font-size: 1.1rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin-left: 15px;
    }

    .btn-action-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff !important;
    }

    .value-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        height: 100%;
    }

    .value-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .card-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: #e0f2fe;
        color: #0284c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }
</style>

<div class="container text-center">
    <div class="hero-banner">
        <h1 class="hero-title">Sistema de Gestión Interna OCC República Dominicana</h1>
        <p class="hero-subtitle">
            Uniendo corazones, coordinando voluntarios y transformando vidas a través de la evangelización y discipulado infantil en toda la República Dominicana.
        </p>

        <div class="quote-box">
            <p class="quote-text">
                <i class="bi bi-quote fs-3 me-2"></i>
                "Cada cajita de regalo es un mensaje tangible del amor de Dios. El trabajo de cada voluntario, coordinador e iglesia socia no es solo logística: es la siembra de la Gran Comisión en el corazón de miles de niños dominicanos."
            </p>
            <div class="text-end text-sky-300 font-semibold" style="color: #7dd3fc; font-weight: 600;">
                — Equipo de Liderazgo OCC Rep Dom
            </div>
        </div>

        <div class="mt-4">
            <a href="@Url.Action("Login", "Acceso")" class="btn-action-primary me-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar Sesión
            </a>
            <a href="@Url.Action("Registrar", "Acceso")" class="btn-action-secondary">
                <i class="bi bi-person-plus me-2"></i>Registrarme como Voluntario
            </a>
        </div>
    </div>

    <!-- Valores y Pilares del Trabajo Voluntario -->
    <div class="row g-4 mt-5">
        <div class="col-md-4 text-start">
            <div class="value-card">
                <div class="card-icon">
                    <i class="bi bi-heart-fill"></i>
                </div>
                <h3 class="h5 font-bold mb-3" style="font-weight: 700; color: #0f172a;">El Valor de tu Trabajo</h3>
                <p class="text-muted" style="color: #64748b;">
                    Tu entrega como coordinador regional o estratégico permite que cada detalle operativo se realice con excelencia y pasión por el Reino.
                </p>
            </div>
        </div>
        <div class="col-md-4 text-start">
            <div class="value-card">
                <div class="card-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h3 class="h5 font-bold mb-3" style="font-weight: 700; color: #0f172a;">Estructura y Unidad</h3>
                <p class="text-muted" style="color: #64748b;">
                    Organizados en Equipos Nacionales (ENL), Estratégicos (ERLE) y Regionales (ERL) para servir eficazmente en cada rincón del país.
                </p>
            </div>
        </div>
        <div class="col-md-4 text-start">
            <div class="value-card">
                <div class="card-icon">
                    <i class="bi bi-book-fill"></i>
                </div>
                <h3 class="h5 font-bold mb-3" style="font-weight: 700; color: #0f172a;">La Gran Aventura</h3>
                <p class="text-muted" style="color: #64748b;">
                    Llevamos el discipulado continuo a las iglesias aliadas, guiando a los niños a conocer, amar y seguir a Jesucristo de por vida.
                </p>
            </div>
        </div>
    </div>
</div>
