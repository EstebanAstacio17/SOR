@model SOR.Models.Iglesia
@{
    ViewBag.Title = "Registrar Iglesia Beneficiada";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listaEquipos = (List<SelectListItem>)ViewBag.ListaEquipos ?? new List<SelectListItem>();
}

<div class="mb-4">
    <h2 class="h3 font-bold text-slate-800 mb-1"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Registrar Nueva Iglesia</h2>
    <p class="text-muted mb-0">Ingresa los datos de la institución, del Pastor principal y del Líder Ministerial.</p>
</div>

@if (ViewData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form action="@Url.Action("Crear", "Iglesia")" method="post" enctype="multipart/form-data">
    <!-- DATOS DE LA INSTITUCIÓN -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white p-3">
            <h3 class="h5 font-bold mb-0"><i class="bi bi-building me-2"></i>1. Datos de la Institución / Iglesia</h3>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label font-semibold">Nombre Completo de la Iglesia o Institución <span class="text-danger">*</span></label>
                    <input type="text" name="NombreIglesia" class="form-control" value="@Model.NombreIglesia" required placeholder="Ej: Iglesia Evangélica Central" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-semibold">RNC o Cédula</label>
                    <input type="text" name="RNC_Cedula" class="form-control" value="@Model.RNC_Cedula" />
                </div>
                <div class="col-md-3">
                    <label class="form-label font-semibold">Teléfono Institucional</label>
                    <input type="text" name="Telefono" class="form-control" value="@Model.Telefono" placeholder="809-000-0000" />
                </div>

                <h5 class="h6 font-bold mt-4 mb-2 text-dark">Dirección Física Completa</h5>
                <div class="col-md-4">
                    <label class="form-label">Calle</label>
                    <input type="text" name="Calle" class="form-control" value="@Model.Calle" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Número</label>
                    <input type="text" name="Numero" class="form-control" value="@Model.Numero" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sector</label>
                    <input type="text" name="Sector" class="form-control" value="@Model.Sector" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ciudad / Provincia</label>
                    <input type="text" name="Ciudad" class="form-control" value="@Model.Ciudad" placeholder="Ej: Santiago" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Referencia de Ubicación</label>
                    <input type="text" name="Referencia" class="form-control" value="@Model.Referencia" placeholder="Ej: Frente al Parque Central" />
                </div>
                <div class="col-md-6">
                    <label class="form-label font-semibold">Equipo OCC Asignado <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.IdEquipo, listaEquipos, "-- Seleccionar Equipo --", new { @class = "form-select", required = "required" })
                </div>
            </div>
        </div>
    </div>

    <!-- DATOS DEL PASTOR -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-secondary text-white p-3">
            <h3 class="h5 font-bold mb-0"><i class="bi bi-person-badge me-2"></i>2. Datos del Pastor Principal</h3>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label font-semibold">Nombres del Pastor</label>
                    <input type="text" name="Pastor.Nombres" class="form-control" value="@Model.Pastor.Nombres" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Apellidos del Pastor</label>
                    <input type="text" name="Pastor.Apellidos" class="form-control" value="@Model.Pastor.Apellidos" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Cédula o Documento de Identidad</label>
                    <input type="text" name="Pastor.DocumentoIdentidad" class="form-control" value="@Model.Pastor.DocumentoIdentidad" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Adjuntar Cédula / Documento (Foto o PDF)</label>
                    <input type="file" name="docPastor" class="form-control" accept="image/*,.pdf" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Celular / WhatsApp</label>
                    <input type="text" name="Pastor.Celular" class="form-control" value="@Model.Pastor.Celular" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Correo Electrónico</label>
                    <input type="email" name="Pastor.Correo" class="form-control" value="@Model.Pastor.Correo" />
                </div>
            </div>
        </div>
    </div>

    <!-- DATOS DEL LÍDER MINISTERIAL -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-dark text-white p-3">
            <h3 class="h5 font-bold mb-0"><i class="bi bi-person-workspace me-2"></i>3. Datos del Líder Ministerial</h3>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label font-semibold">Nombres del Líder</label>
                    <input type="text" name="LiderMinisterial.Nombres" class="form-control" value="@Model.LiderMinisterial.Nombres" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Apellidos del Líder</label>
                    <input type="text" name="LiderMinisterial.Apellidos" class="form-control" value="@Model.LiderMinisterial.Apellidos" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Cédula o Documento de Identidad</label>
                    <input type="text" name="LiderMinisterial.DocumentoIdentidad" class="form-control" value="@Model.LiderMinisterial.DocumentoIdentidad" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Adjuntar Cédula / Documento (Foto o PDF)</label>
                    <input type="file" name="docLider" class="form-control" accept="image/*,.pdf" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Celular / WhatsApp</label>
                    <input type="text" name="LiderMinisterial.Celular" class="form-control" value="@Model.LiderMinisterial.Celular" />
                </div>
                <div class="col-md-4">
                    <label class="form-label font-semibold">Correo Electrónico</label>
                    <input type="email" name="LiderMinisterial.Correo" class="form-control" value="@Model.LiderMinisterial.Correo" />
                </div>
            </div>
        </div>
    </div>

    <div class="text-end mb-5">
        <a href="@Url.Action("Index", "Iglesia")" class="btn btn-secondary me-2">Cancelar</a>
        <button type="submit" class="btn btn-primary px-5 font-semibold">
            <i class="bi bi-check-circle-fill me-2"></i>Guardar Expediente de Iglesia
        </button>
    </div>
</form>
