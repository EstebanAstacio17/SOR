    <script>
        function abrirModalRemoverMaestro(idMaestro, nombreMaestro) {
            document.getElementById('modalRemoverIdMaestro').value = idMaestro;
            document.getElementById('modalRemoverNombreMaestro').textContent = nombreMaestro;
            var modal = new bootstrap.Modal(document.getElementById('modalRemoverMaestro'));
            modal.show();
        }
