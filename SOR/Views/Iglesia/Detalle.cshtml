                            <div class="alert alert-info py-2 small mb-3">
                                <i class="bi bi-info-circle me-1"></i>Esta iglesia no tiene maestros registrados. Ingresa a continuación los datos de los maestros para crearlos y asignarlos al taller:
                            </div>
                            <div id="contenedorMaestrosElegibilidad" class="d-flex flex-column gap-2 mb-3">
                                <div class="card bg-light border p-2 rounded-3 item-maestro-eleg">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Nombres Maestro 1 <span class="text-danger">*</span></label>
                                            <input type="text" name="maestrosNuevos[0].Nombres" class="form-control form-control-sm" required placeholder="Ej: Juan" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                            <input type="text" name="maestrosNuevos[0].Apellidos" class="form-control form-control-sm" required placeholder="Ej: Pérez" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Cédula / Identidad</label>
                                            <input type="text" name="maestrosNuevos[0].DocumentoIdentidad" class="form-control form-control-sm" placeholder="001-0000000-0" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold mb-1">Celular</label>
                                            <input type="text" name="maestrosNuevos[0].Celular" class="form-control form-control-sm" placeholder="809-555-1234" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Comentarios / Observaciones de Elegibilidad</label>
                            <textarea name="comentario" class="form-control" rows="2" placeholder="Ingresa notas o comentarios de la evaluación..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success font-semibold">Aprobar y Habilitar Taller</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 4.B: RECHAZAR ELEGIBILIDAD TALLER OCC -->
    <div class="modal fade" id="modalRechazarElegibilidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
