                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Cantidad de Niños</label>
                                <input type="number" name="cantNinos" class="form-control" min="0" value="0" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Maestros Registrados</label>
                                <input type="number" name="cantMaestrosReg" class="form-control" min="0" value="0" required />
                            </div>
