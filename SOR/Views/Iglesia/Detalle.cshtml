                                        <input type="text" name="pastor.Celular" class="form-control form-control-sm" value="@(Model.Pastor != null ? Model.Pastor.Celular : "")" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Correo <span class="text-danger">*</span></label>
                                        <input type="email" name="pastor.Correo" class="form-control form-control-sm" value="@(Model.Pastor != null ? Model.Pastor.Correo : "")" required placeholder="pastor@ejemplo.com" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Confirmación de Datos del Líder Ministerial -->
                        <div class="card border border-slate-200 rounded-3 bg-light">
                            <div class="card-header bg-dark text-white py-2 font-bold small"><i class="bi bi-person-workspace me-1"></i>Confirmar Datos del Líder Ministerial</div>
                            <div class="card-body p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Nombres <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Nombres" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Nombres : "")" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-xs fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Apellidos" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Apellidos : "")" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Cédula <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.DocumentoIdentidad" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.DocumentoIdentidad : "")" required pattern="^(\d{11}|\d{3}-\d{7}-\d{1})$" placeholder="001-0000000-0" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Celular <span class="text-danger">*</span></label>
                                        <input type="text" name="lider.Celular" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Celular : "")" required pattern="^(809|829|849)[-]?\d{3}[-]?\d{4}$" placeholder="809-555-1234" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label text-xs fw-semibold mb-1">Correo <span class="text-danger">*</span></label>
                                        <input type="email" name="lider.Correo" class="form-control form-control-sm" value="@(Model.LiderMinisterial != null ? Model.LiderMinisterial.Correo : "")" required placeholder="lider@ejemplo.com" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary font-semibold"><i class="bi bi-save me-1"></i>Confirmar Datos y Asignar Evento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            var selResultado = document.querySelector('select[name="resultado"]');
            var divTaller = document.getElementById('divEventoTaller');
            var ddlTaller = document.getElementById('ddlEventoTaller');
            var chkAsistio = document.getElementById('chkAsistio');

            function toggleTaller() {
                if (selResultado && selResultado.value === "Continua") {
                    if (divTaller) divTaller.style.display = "block";
                    if (ddlTaller) ddlTaller.required = true;
                    if (chkAsistio) {
                        chkAsistio.checked = true;
                    }
                } else {
                    if (divTaller) divTaller.style.display = "none";
                    if (ddlTaller) {
                        ddlTaller.required = false;
                        ddlTaller.value = "";
                    }
                }
            }

            if (selResultado) {
                selResultado.addEventListener("change", toggleTaller);
            }
        });

        function generarFilasMaestrosElegibilidad(cantidad) {
            var cont = document.getElementById('contenedorMaestrosElegibilidad');
            if (!cont) return;
            var cant = parseInt(cantidad) || 1;
            if (cant < 1) cant = 1;
            if (cant > 20) cant = 20;

            var html = '';
            for (var i = 0; i < cant; i++) {
                html += `
                    <div class="card bg-light border p-2 rounded-3 item-maestro-eleg">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Nombres Maestro ${i + 1} <span class="text-danger">*</span></label>
                                <input type="text" name="maestrosNuevos[${i}].Nombres" class="form-control form-control-sm" required placeholder="Ej: Maestro ${i + 1}" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Apellidos <span class="text-danger">*</span></label>
                                <input type="text" name="maestrosNuevos[${i}].Apellidos" class="form-control form-control-sm" required placeholder="Ej: Apellido" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Cédula / Identidad</label>
                                <input type="text" name="maestrosNuevos[${i}].DocumentoIdentidad" class="form-control form-control-sm" placeholder="001-0000000-0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold mb-1">Celular</label>
                                <input type="text" name="maestrosNuevos[${i}].Celular" class="form-control form-control-sm" placeholder="809-555-1234" />
                            </div>
                        </div>
                    </div>
                `;
            }
            cont.innerHTML = html;
        }
    </script>

    <!-- MODAL 4.A: APROBAR ELEGIBILIDAD TALLER OCC -->
    <div class="modal fade" id="modalAprobarElegibilidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 rounded-4 shadow">
                <form action="@Url.Action("EvaluarTallerOCC", "Iglesia")" method="post">
                    <input type="hidden" name="idParticipacion" value="@p.IdParticipacion" />
                    <input type="hidden" name="idIglesia" value="@Model.IdIglesia" />
                    <input type="hidden" name="estado" value="Aprobada para Taller OCC" />

                    <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                        <h5 class="modal-title font-bold"><i class="bi bi-check-circle me-2 text-success"></i>Aprobar Elegibilidad para Taller OCC</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Evento de Taller OCC al que se asignará <span class="text-danger">*</span></label>
                            <select name="idEventoTaller" class="form-select" required>
                                <option value="">-- Seleccione un Taller OCC --</option>
                                @foreach (var ev in (List<SelectListItem>)ViewBag.EventosTaller)
                                {
                                    <option value="@ev.Value">@ev.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cantidad de Maestros Asistentes Previstos <span class="text-danger">*</span></label>
                            <input type="number" name="cantidadAsistentes" id="cantMaestrosElegibilidad" class="form-control" min="1" value="@(Model.Maestros.Any() ? Model.Maestros.Count.ToString() : "1")" required placeholder="Ej: 3" onchange="generarFilasMaestrosElegibilidad(this.value)" />
