@model IEnumerable<SOR.Models.Iglesia>
@{
    ViewBag.Title = "Registro de Iglesias";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var u = (SOR.Models.Usuario)ViewBag.UsuarioActual;
    var temporadas = (List<SelectListItem>)ViewBag.FiltroTemporadas;
    var etapas = (List<SelectListItem>)ViewBag.FiltroEtapas;
    var estados = (List<SelectListItem>)ViewBag.FiltroEstados;
    var estatusReportes = (List<SelectListItem>)ViewBag.FiltroEstatusReportes;
    var importarTemporadas = (List<SelectListItem>)ViewBag.ImportarTemporadas;
}

<!-- Cabecera Principal -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h2 class="h3 font-bold text-slate-800 mb-1"><i class="bi bi-building-fill text-primary me-2"></i>Gestión de Iglesias Beneficiadas</h2>
        <p class="text-muted mb-0">Listado e historia de iglesias socias de OCC en República Dominicana.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (u.IdRolSeguridad == 1 || u.IdRolSeguridad == 2 || u.IdPosicion == 1 || u.IdPosicion == 2)
        {
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownAgregarIglesia" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-plus-circle me-1"></i> Agregar Iglesia
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg" aria-labelledby="dropdownAgregarIglesia">
                    <li>
                        <a class="dropdown-item fw-medium py-2" href="@Url.Action("Crear", "Iglesia")">
                            <i class="bi bi-building me-2 text-primary"></i>Registro Individual
                        </a>
                    </li>
                    <li>
                        <button class="dropdown-item fw-medium py-2" type="button" data-bs-toggle="modal" data-bs-target="#modalImportarMasivo">
                            <i class="bi bi-file-earmark-excel me-2 text-success"></i>Importación Masiva (Excel/CSV)
                        </button>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>


<div class="row g-4">
    <!-- Panel Izquierdo: Sidebar de Filtros -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <h5 class="h6 font-bold text-slate-800 mb-3 border-bottom pb-2"><i class="bi bi-funnel me-2 text-primary"></i>Filtros Avanzados</h5>
            <form action="@Url.Action("Index", "Iglesia")" method="get" class="d-flex flex-column gap-3">
                
                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Temporada</label>
                    <select name="idTemporada" class="form-select">
                        <option value="">Todas las temporadas</option>
                        @foreach (var temp in temporadas)
                        {
                            <option value="@temp.Value" @(Request.QueryString["idTemporada"] == temp.Value ? "selected" : "")>@temp.Text</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Denominación</label>
                    <input type="text" name="denominacion" value="@Request.QueryString["denominacion"]" class="form-control" placeholder="Ej: Bautista, Pentecostal..." />
                </div>

                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Tipo Organización</label>
                    <input type="text" name="tipoOrg" value="@Request.QueryString["tipoOrg"]" class="form-control" placeholder="Ej: Iglesia, Asociación..." />
                </div>

                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Etapas en Temporada</label>
                    <select name="etapaProcess" class="form-select">
                        <option value="">Todas las etapas</option>
                        @foreach (var et in etapas)
                        {
                            <option value="@et.Value" @(Request.QueryString["etapaProcess"] == et.Value ? "selected" : "")>@et.Text</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Estado de Participación</label>
                    <select name="estadoParticipacion" class="form-select">
                        <option value="">Todos los estados</option>
                        @foreach (var st in estados)
                        {
                            <option value="@st.Value" @(Request.QueryString["estadoParticipacion"] == st.Value ? "selected" : "")>@st.Text</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label text-slate-600 small fw-semibold">Estatus Evaluación (Reporte)</label>
                    <select name="estatusEvalReporte" class="form-select">
                        <option value="">Todos los estatus</option>
                        @if(estatusReportes != null)
                        {
                            foreach (var rep in estatusReportes)
                            {
                                <option value="@rep.Value" @(Request.QueryString["estatusEvalReporte"] == rep.Value ? "selected" : "")>@rep.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-flex flex-column gap-2 mt-2">
                    <button type="submit" class="btn btn-primary font-semibold w-100"><i class="bi bi-search me-2"></i>Aplicar Filtros</button>
                    <a href="@Url.Action("Index", "Iglesia")" class="btn btn-outline-secondary font-semibold w-100">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Panel Derecho: Listado de Iglesias -->
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-slate-500"><i class="bi bi-search"></i></span>
                        <input type="text" id="txtBuscarIglesia" class="form-control bg-light border-start-0 text-slate-800" placeholder="Escribe aquí para buscar iglesia instantáneamente por nombre, denominación, ciudad o equipo..." style="font-size: 0.9rem;" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select id="filtroEquipoIglesia" class="form-select bg-light text-slate-800" style="font-size: 0.9rem;">
                        <option value="">Todos los Equipos</option>
                        @if (ViewBag.ListaEquipos != null)
                        {
                            foreach (var eq in (List<SelectListItem>)ViewBag.ListaEquipos)
                            {
                                <option value="@eq.Text">@eq.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaIglesias">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Nombre de la Iglesia</th>
                                <th>Pastor / Líder</th>
                                <th>Temporada</th>
                                <th>¿Reportó?</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyIglesias">
                            @if (!Model.Any())
                            {
                                <tr id="rowVacioServidor">
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2 text-slate-400"></i>
                                        No se encontraron iglesias con los filtros aplicados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    var pastorNombre = item.Pastor != null && !string.IsNullOrWhiteSpace(item.Pastor.Nombres)
                                        ? $"{item.Pastor.Nombres} {item.Pastor.Apellidos}".Trim()
                                        : "N/D";
                                    var pastorTel = item.Pastor != null && !string.IsNullOrWhiteSpace(item.Pastor.Celular)
                                        ? item.Pastor.Celular
                                        : (!string.IsNullOrWhiteSpace(item.Telefono) ? item.Telefono : "N/D");

                                    var liderNombre = item.LiderMinisterial != null && !string.IsNullOrWhiteSpace(item.LiderMinisterial.Nombres)
                                        ? $"{item.LiderMinisterial.Nombres} {item.LiderMinisterial.Apellidos}".Trim()
                                        : "N/D";
                                    var liderTel = item.LiderMinisterial != null && !string.IsNullOrWhiteSpace(item.LiderMinisterial.Celular)
                                        ? item.LiderMinisterial.Celular
                                        : "N/D";

                                    var temporadaNombre = item.ParticipacionActual != null && !string.IsNullOrWhiteSpace(item.ParticipacionActual.NombreTemporada)
                                        ? item.ParticipacionActual.NombreTemporada
                                        : "Sin Temporada";

                                    var reporto = item.ParticipacionActual != null && !string.IsNullOrWhiteSpace(item.ParticipacionActual.EstatusEvaluacionReporte)
                                        && (item.ParticipacionActual.EstatusEvaluacionReporte.Equals("Reportó", StringComparison.OrdinalIgnoreCase) 
                                            || item.ParticipacionActual.EstatusEvaluacionReporte.Equals("SI", StringComparison.OrdinalIgnoreCase)
                                            || item.ParticipacionActual.EstatusEvaluacionReporte.Equals("Reporto", StringComparison.OrdinalIgnoreCase));

                                    <tr class="fila-iglesia" data-equipo="@(item.NombreEquipo ?? "")">
                                        <td class="ps-4">
                                            <div class="fw-bold fs-6" style="color: #1e293b;">@item.NombreIglesia</div>
                                            <span class="badge" style="color: #475569; background-color: #f1f5f9; border: 1px solid #cbd5e1; padding: 0.25rem 0.5rem; font-size: 0.75rem;">@item.NombreEquipo</span>
                                        </td>
                                        <td>
                                            <div class="small text-slate-800 fw-semibold mb-1">
                                                <span class="text-primary fw-bold">Pastor:</span> @pastorNombre - @pastorTel
                                            </div>
                                            <div class="small text-slate-600">
                                                <span class="text-secondary fw-bold">Líder:</span> @liderNombre - @liderTel
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                <i class="bi bi-calendar-check me-1 text-primary"></i>@temporadaNombre
                                            </span>
                                        </td>
                                        <td>
                                            @if (reporto)
                                            {
                                                <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 fw-bold">
                                                    <i class="bi bi-check-circle-fill me-1"></i>SÍ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-soft text-muted rounded-pill px-2 py-1">
                                                    <i class="bi bi-dash-circle me-1"></i>NO
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="@Url.Action("Detalle", "Iglesia", new { id = item.IdIglesia })" class="btn btn-sm btn-outline-primary font-semibold">
                                                <i class="bi bi-folder2-open me-1"></i>Ver Expediente
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- PIE DE PAGINACIÓN -->
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3" id="paginationContainer">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="text-muted small fw-medium" id="paginacionInfo">Cargando registros...</span>
                    <div class="d-flex align-items-center gap-2">
                        <label for="filasPorPagina" class="text-muted small mb-0 fw-semibold">Mostrar:</label>
                        <select id="filasPorPagina" class="form-select form-select-sm bg-light" style="width: 85px; font-size: 0.85rem;">
                            <option value="10">10</option>
                            <option value="15" selected>15</option>
                            <option value="20">20</option>
                        </select>
                        <span class="text-muted small">por pág.</span>
                    </div>
                </div>
                <nav aria-label="Paginación de iglesias">
                    <ul class="pagination pagination-sm mb-0 gap-1" id="paginacionNav">
                        <!-- Generado dinámicamente -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- MODAL IMPORTAR MASIVO -->
<div class="modal fade" id="modalImportarMasivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <form id="formImportarMasivo" action="@Url.Action("ImportarMasivo", "Iglesia")" method="post" enctype="multipart/form-data">
                <div class="modal-header bg-dark text-white rounded-top-4 py-3">
                    <h5 class="modal-title font-bold text-white"><i class="bi bi-file-earmark-excel me-2 text-info"></i>Importar Iglesias de forma Masiva</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex flex-column gap-2 mb-3 bg-light p-3 rounded-3 border">
                        <span class="fw-bold text-slate-700 small"><i class="bi bi-file-earmark-arrow-down-fill me-1 text-primary"></i>Recursos Descargables:</span>
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("DescargarPlantillaIglesias", "Iglesia")" class="btn btn-xs btn-outline-success font-semibold flex-fill">
                                <i class="bi bi-file-excel me-1"></i>Plantilla CSV / Ejemplo
                            </a>
                            <a href="@Url.Action("DescargarCondicionesImportacion", "Iglesia")" class="btn btn-xs btn-outline-primary font-semibold flex-fill">
                                <i class="bi bi-file-text me-1"></i>Ver Guía de Condiciones
                            </a>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Temporada a la que se importarán las iglesias <span class="text-danger">*</span></label>
                        <select name="idTemporadaImportar" class="form-select" required>
                            <option value="">-- Seleccionar Temporada --</option>
                            @if (importarTemporadas != null)
                            {
                                foreach (var temp in importarTemporadas)
                                {
                                    <option value="@temp.Value">@temp.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seleccionar archivo de carga (.xlsx / .csv)</label>
                        <input type="file" name="archivoExcel" class="form-control" accept=".xlsx,.csv" required />
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 border-top-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-info text-white font-semibold"><i class="bi bi-eye me-1"></i>Subir y Previsualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-purple-soft {
        background-color: rgba(111, 66, 193, 0.15) !important;
        color: #6f42c1 !important;
    }
    .bg-info-soft {
        background-color: rgba(13, 202, 240, 0.15) !important;
        color: #0dcaf0 !important;
    }
    .bg-success-soft {
        background-color: rgba(25, 135, 84, 0.15) !important;
        color: #198754 !important;
    }
    .bg-warning-soft {
        background-color: rgba(255, 193, 7, 0.15) !important;
        color: #ffc107 !important;
    }
    .bg-danger-soft {
        background-color: rgba(220, 53, 69, 0.15) !important;
        color: #dc3545 !important;
    }
    .bg-secondary-soft {
        background-color: rgba(108, 117, 125, 0.15) !important;
        color: #6c757d !important;
    }
    .page-item .page-link {
        border-radius: 6px !important;
        color: #475569;
        font-weight: 500;
        border: 1px solid #e2e8f0;
        padding: 0.35rem 0.65rem;
    }
    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }
    .page-item.disabled .page-link {
        color: #94a3b8;
        background-color: #f8fafc;
        border-color: #e2e8f0;
    }
</style>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function() {
        var searchInput = document.getElementById('txtBuscarIglesia');
        var selectEquipo = document.getElementById('filtroEquipoIglesia');
        var selectFilas = document.getElementById('filasPorPagina');
        var navPaginacion = document.getElementById('paginacionNav');
        var infoPaginacion = document.getElementById('paginacionInfo');
        var tbody = document.getElementById('tbodyIglesias');
        var rowVacioServidor = document.getElementById('rowVacioServidor');

        var paginaActual = 1;

        function actualizarTablaYPaginacion(resetPagina) {
            if (resetPagina) {
                paginaActual = 1;
            }

            var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
            var equipo = selectEquipo ? selectEquipo.value.toLowerCase().trim() : '';
            var filasVal = selectFilas ? selectFilas.value : '15';
            var pageSize = (filasVal === 'all') ? 999999 : parseInt(filasVal, 10);

            var rows = Array.from(document.querySelectorAll('table tbody tr.fila-iglesia'));
            
            // Si el servidor no trajo iglesias (Model está vacío):
            if (rows.length === 0) {
                if (rowVacioServidor) {
                    rowVacioServidor.style.display = '';
                }
                if (infoPaginacion) {
                    infoPaginacion.textContent = '0 iglesias registradas';
                }
                if (navPaginacion) {
                    navPaginacion.innerHTML = '';
                }
                return;
            }

            if (rowVacioServidor) {
                rowVacioServidor.style.display = 'none';
            }

            // Filtrar filas de datos válidas
            var matchingRows = [];
            rows.forEach(function(row) {
                var text = row.textContent.toLowerCase();
                var eqAttr = (row.getAttribute('data-equipo') || '').toLowerCase();
                var eqCell = row.cells[0] ? row.cells[0].textContent.toLowerCase() : '';

                var matchText = query === '' || text.indexOf(query) > -1;
                var matchEq = equipo === '' || eqAttr.indexOf(equipo) > -1 || eqCell.indexOf(equipo) > -1;

                if (matchText && matchEq) {
                    matchingRows.push(row);
                } else {
                    row.style.display = 'none';
                }
            });

            // Manejo de mensaje cuando el filtro de búsqueda local no da resultados
            var rowNoCoincidencias = document.getElementById('rowNoCoincidenciasBusqueda');
            if (matchingRows.length === 0) {
                if (!rowNoCoincidencias && tbody) {
                    rowNoCoincidencias = document.createElement('tr');
                    rowNoCoincidencias.id = 'rowNoCoincidenciasBusqueda';
                    rowNoCoincidencias.innerHTML = '<td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-search fs-2 d-block mb-2 text-slate-400"></i>No se encontraron iglesias que coincidan con la búsqueda o equipo seleccionado.</td>';
                    tbody.appendChild(rowNoCoincidencias);
                } else if (rowNoCoincidencias) {
                    rowNoCoincidencias.style.display = '';
                }
                if (infoPaginacion) {
                    infoPaginacion.textContent = 'No se encontraron iglesias coincidentes';
                }
                if (navPaginacion) {
                    navPaginacion.innerHTML = '';
                }
                return;
            } else if (rowNoCoincidencias) {
                rowNoCoincidencias.style.display = 'none';
            }

            var totalCoincidencias = matchingRows.length;
            var totalPaginas = Math.ceil(totalCoincidencias / pageSize);
            if (totalPaginas < 1) totalPaginas = 1;

            if (paginaActual > totalPaginas) {
                paginaActual = totalPaginas;
            }

            var inicioIdx = (paginaActual - 1) * pageSize;
            var finIdx = Math.min(inicioIdx + pageSize, totalCoincidencias);

            matchingRows.forEach(function(row, idx) {
                if (idx >= inicioIdx && idx < finIdx) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Actualizar texto informativo
            if (infoPaginacion) {
                infoPaginacion.textContent = 'Mostrando ' + (inicioIdx + 1) + ' a ' + finIdx + ' de ' + totalCoincidencias + ' iglesias';
            }

            // Renderizar botones de paginación
            renderBotonesPaginacion(totalPaginas, totalCoincidencias);
        }

        function renderBotonesPaginacion(totalPaginas, totalCoincidencias) {
            if (!navPaginacion) return;
            navPaginacion.innerHTML = '';
            if (totalCoincidencias <= 0 || totalPaginas <= 1) {
                return;
            }

            // Botón Anterior
            var prevLi = document.createElement('li');
            prevLi.className = 'page-item ' + (paginaActual === 1 ? 'disabled' : '');
            var prevA = document.createElement('a');
            prevA.className = 'page-link';
            prevA.href = '#';
            prevA.innerHTML = '<i class="bi bi-chevron-left"></i>';
            prevA.addEventListener('click', function(e) {
                e.preventDefault();
                if (paginaActual > 1) {
                    paginaActual--;
                    actualizarTablaYPaginacion(false);
                }
            });
            prevLi.appendChild(prevA);
            navPaginacion.appendChild(prevLi);

            // Rango de páginas a mostrar (smart window)
            var delta = 2;
            var startPage = Math.max(1, paginaActual - delta);
            var endPage = Math.min(totalPaginas, paginaActual + delta);

            if (startPage > 1) {
                agregarBotonPagina(1);
                if (startPage > 2) {
                    var elipLi = document.createElement('li');
                    elipLi.className = 'page-item disabled';
                    elipLi.innerHTML = '<span class="page-link border-0 bg-transparent">...</span>';
                    navPaginacion.appendChild(elipLi);
                }
            }

            for (var p = startPage; p <= endPage; p++) {
                agregarBotonPagina(p);
            }

            if (endPage < totalPaginas) {
                if (endPage < totalPaginas - 1) {
                    var elipLi2 = document.createElement('li');
                    elipLi2.className = 'page-item disabled';
                    elipLi2.innerHTML = '<span class="page-link border-0 bg-transparent">...</span>';
                    navPaginacion.appendChild(elipLi2);
                }
                agregarBotonPagina(totalPaginas);
            }

            // Botón Siguiente
            var nextLi = document.createElement('li');
            nextLi.className = 'page-item ' + (paginaActual === totalPaginas ? 'disabled' : '');
            var nextA = document.createElement('a');
            nextA.className = 'page-link';
            nextA.href = '#';
            nextA.innerHTML = '<i class="bi bi-chevron-right"></i>';
            nextA.addEventListener('click', function(e) {
                e.preventDefault();
                if (paginaActual < totalPaginas) {
                    paginaActual++;
                    actualizarTablaYPaginacion(false);
                }
            });
            nextLi.appendChild(nextA);
            navPaginacion.appendChild(nextLi);
        }

        function agregarBotonPagina(num) {
            var li = document.createElement('li');
            li.className = 'page-item ' + (num === paginaActual ? 'active' : '');
            var a = document.createElement('a');
            a.className = 'page-link';
            a.href = '#';
            a.textContent = num;
            a.addEventListener('click', function(e) {
                e.preventDefault();
                if (paginaActual !== num) {
                    paginaActual = num;
                    actualizarTablaYPaginacion(false);
                }
            });
            li.appendChild(a);
            navPaginacion.appendChild(li);
        }

        var debounceTimer;
        if (searchInput) {
            searchInput.addEventListener('keyup', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function() {
                    actualizarTablaYPaginacion(true);
                }, 200);
            });
        }

        if (selectEquipo) {
            selectEquipo.addEventListener('change', function() {
                actualizarTablaYPaginacion(true);
            });
        }

        if (selectFilas) {
            selectFilas.addEventListener('change', function() {
                actualizarTablaYPaginacion(true);
            });
        }

        // Ejecución inicial
        actualizarTablaYPaginacion(true);

        // Validación del formulario de importación masiva con jquery.validate
        if (typeof $.fn.validate === 'function') {
            $("#formImportarMasivo").validate({
                errorElement: 'div',
                errorClass: 'invalid-feedback d-block mt-1',
                highlight: function(element) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element) {
                    $(element).removeClass('is-invalid');
                },
                errorPlacement: function(error, element) {
                    error.insertAfter(element);
                }
            });
        }
    });
</script>
