@model IEnumerable<SOR.Models.ItemInventarioCentral>
@{
    ViewBag.Title = "Inventario Central — Logística OCC";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var almacenes = ViewBag.Almacenes as IEnumerable<SOR.Models.Almacen> ?? new List<SOR.Models.Almacen>();
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-1"><i class="bi bi-building me-2" style="color:var(--apple-accent)"></i>Inventario Central</h1>
            <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Logistica")">Logística</a></li>
                <li class="breadcrumb-item active">Inventario Central</li>
            </ol></nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold">Stock disponible por material y almacén</h6>
            <div class="d-flex gap-2 align-items-center">
                <select id="filtroAlmacen" class="form-select form-select-sm" style="max-width:220px">
                    <option value="">— Todos los almacenes —</option>
                    @foreach (var a in almacenes) { <option value="@a.NombreAlmacen">@a.NombreAlmacen</option> }
                </select>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaInvCentral">
                <thead class="table-light">
                    <tr>
                        <th>Material</th>
                        <th>Almacén</th>
                        <th class="text-center">Físico</th>
                        <th class="text-center">Transferido a Equipos</th>
                        <th class="text-center">Disponible</th>
                        <th class="text-center">% Transferido</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No hay stock registrado. <a href="@Url.Action("Recepciones","Logistica")">Registre una recepción de contenedor.</a>
                        </td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        int pct = item.CantidadFisica > 0 ? (item.CantidadTransferida * 100 / item.CantidadFisica) : 0;
                        <tr data-almacen="@item.NombreAlmacen">
                            <td>
                                <span class="badge bg-primary me-2">@item.CodigoMaterial</span>
                                <strong>@item.NombreMaterial</strong>
                            </td>
                            <td class="text-muted">@item.NombreAlmacen</td>
                            <td class="text-center">@item.CantidadFisica.ToString("N0") <small class="text-muted">@item.UnidadEntrega</small></td>
                            <td class="text-center">@item.CantidadTransferida.ToString("N0")</td>
                            <td class="text-center">
                                <span class="fw-bold @(item.CantidadDisponible > 0 ? "text-success" : "text-danger")">
                                    @item.CantidadDisponible.ToString("N0")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex align-items-center gap-2 justify-content-center">
                                    <div class="progress flex-grow-1" style="height:6px;max-width:80px">
                                        <div class="progress-bar bg-primary" style="width:@pct%"></div>
                                    </div>
                                    <span class="small text-muted">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('filtroAlmacen').addEventListener('change', function () {
    var val = this.value.toLowerCase();
    document.querySelectorAll('#tablaInvCentral tbody tr[data-almacen]').forEach(function (tr) {
        tr.style.display = (!val || tr.dataset.almacen.toLowerCase().includes(val)) ? '' : 'none';
    });
});
</script>
}
