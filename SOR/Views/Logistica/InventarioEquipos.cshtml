@model IEnumerable<SOR.Models.ItemInventarioEquipo>
@{
    ViewBag.Title = "Inventario por Equipo — Logística OCC";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var equipos = ViewBag.Equipos as IEnumerable<System.Web.Mvc.SelectListItem> ?? new List<System.Web.Mvc.SelectListItem>();
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-1"><i class="bi bi-layers me-2" style="color:var(--apple-accent)"></i>Inventario por Equipo</h1>
            <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Logistica")">Logística</a></li>
                <li class="breadcrumb-item active">Inventario Equipos</li>
            </ol></nav>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex gap-2 align-items-center">
            <h6 class="mb-0 fw-semibold me-auto">Stock por equipo y material</h6>
            <select id="filtroEquipo" class="form-select form-select-sm" style="max-width:220px">
                <option value="">— Todos los equipos —</option>
                @foreach (var eq in equipos) { <option value="@eq.Text">@eq.Text</option> }
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-sm" id="tablaInvEq">
                <thead class="table-light">
                    <tr>
                        <th>Equipo</th>
                        <th>Material</th>
                        <th class="text-center">Recibido</th>
                        <th class="text-center">Asignado</th>
                        <th class="text-center">Despachado</th>
                        <th class="text-center">Disponible</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No hay inventario en equipos. <a href="@Url.Action("Transferencias","Logistica")">Registre una transferencia.</a>
                        </td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr data-equipo="@item.NombreEquipo">
                            <td class="fw-semibold">@item.NombreEquipo</td>
                            <td><span class="badge bg-primary me-1">@item.CodigoMaterial</span>@item.NombreMaterial</td>
                            <td class="text-center">@item.CantidadRecibida.ToString("N0") <small class="text-muted">@item.UnidadEntrega</small></td>
                            <td class="text-center">@item.CantidadAsignada.ToString("N0")</td>
                            <td class="text-center text-success fw-semibold">@item.CantidadDespachada.ToString("N0")</td>
                            <td class="text-center">
                                <span class="fw-bold @(item.CantidadDisponible > 0 ? "text-primary" : "text-danger")">
                                    @item.CantidadDisponible.ToString("N0")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('filtroEquipo').addEventListener('change', function () {
    var val = this.value.toLowerCase();
    document.querySelectorAll('#tablaInvEq tbody tr[data-equipo]').forEach(function (tr) {
        tr.style.display = (!val || tr.dataset.equipo.toLowerCase().includes(val)) ? '' : 'none';
    });
});
</script>
}
