@model SOR.Models.Reportes.MovilizacionReporteDTO

<!-- TARJETAS KPI MOVILIZACIÓN -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #0284c7 !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Presentaciones de la Visión</div>
                    <div class="h3 font-bold text-dark mb-0 font-monospace">@Model.TotalPresentacionesVision</div>
                    <small class="text-muted"><i class="bi bi-people me-1"></i>@Model.TotalAsistentesVision.ToString("N0") asistentes totales</small>
                </div>
                <div class="rounded-circle p-3 bg-sky-soft text-sky">
                    <i class="bi bi-megaphone fs-4 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #16a34a !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Equipos Ministeriales</div>
                    <div class="h3 font-bold text-success mb-0 font-monospace">@Model.EquiposMinisterialesCapacitados</div>
                    <small class="text-muted"><i class="bi bi-check-circle me-1"></i>Capacitados y participantes</small>
                </div>
                <div class="rounded-circle p-3 bg-success-soft text-success">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 h-100" style="border-left: 4px solid #d97706 !important;">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted text-xs fw-bold text-uppercase mb-1">Cajitas a Compañeros</div>
                    <div class="h3 font-bold text-warning mb-0 font-monospace">@Model.CajitasEntregadasCompaneros.ToString("N0")</div>
                    <small class="text-muted"><i class="bi bi-box2-heart me-1"></i>@Model.EventosEvangelisticos eventos (@Model.NinosAsistentesEvangelisticos.ToString("N0") niños)</small>
                </div>
                <div class="rounded-circle p-3 bg-warning-soft text-warning">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AUDITORÍA DE IGLESIAS PLANTADAS -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom">
        <div>
            <h6 class="mb-0 fw-bold text-slate-800">
                <i class="bi bi-building-add text-primary me-2"></i>Auditoría de Iglesias Plantadas
            </h6>
            <small class="text-muted">Registro de nuevas congregaciones establecidas durante la temporada</small>
        </div>
        <button type="button" class="btn btn-sm btn-primary font-semibold" data-bs-toggle="modal" data-bs-target="#modalNuevaIglesiaPlantada">
            <i class="bi bi-plus-circle me-1"></i>Registrar Iglesia Plantada
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre de la Iglesia</th>
                        <th>Pastor / Líder Principal</th>
                        <th>Ubicación / Sector</th>
                        <th>Equipo</th>
                        <th class="text-center">Cajitas Entregadas</th>
                        <th class="text-center">Inscritos en LGA</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.IglesiasPlantadas.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                                No hay iglesias plantadas registradas para los filtros seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var ip in Model.IglesiasPlantadas)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-slate-800">@ip.NombreIglesia</td>
                                <td class="fw-semibold text-slate-700">@ip.PastorPrincipal</td>
                                <td class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@ip.Ubicacion</td>
                                <td><span class="badge bg-light text-slate-700 border">@ip.NombreEquipo</span></td>
                                <td class="text-center font-monospace fw-bold text-primary">@ip.CajitasEntregadas.ToString("N0")</td>
                                <td class="text-center font-monospace fw-bold text-success">@ip.InscritosLGA.ToString("N0")</td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarIglesiaPlantada(@ip.IdIglesiaPlantada)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- AUDITORÍA DE GRUPOS NO ALCANZADOS (GNA) -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom">
        <div>
            <h6 class="mb-0 fw-bold text-slate-800">
                <i class="bi bi-compass text-danger me-2"></i>Auditoría de Grupos No Alcanzados (GNA)
            </h6>
            <small class="text-muted">Comunidades y sectores no alcanzados impactados con cajitas y discipulado</small>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger font-semibold" data-bs-toggle="modal" data-bs-target="#modalNuevoGNA">
            <i class="bi bi-plus-circle me-1"></i>Registrar GNA
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre del GNA</th>
                        <th>Compañero de Ministerio</th>
                        <th>Equipo</th>
                        <th class="text-center">Cajitas</th>
                        <th class="text-center">Inscritos LGA</th>
                        <th class="text-center">Creen en Jesús</th>
                        <th class="text-center">Oran / Comparten</th>
                        <th class="text-center">Graduados</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.GruposNoAlcanzados.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1 text-slate-300"></i>
                                No hay Grupos No Alcanzados registrados para los filtros seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var gna in Model.GruposNoAlcanzados)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-slate-800">@gna.NombreGNA</td>
                                <td class="fw-semibold text-slate-700">@gna.CompaneroMinisterio</td>
                                <td><span class="badge bg-light text-slate-700 border">@gna.NombreEquipo</span></td>
                                <td class="text-center font-monospace fw-bold text-primary">@gna.CajitasEntregadas.ToString("N0")</td>
                                <td class="text-center font-monospace fw-bold">@gna.InscritosLGA.ToString("N0")</td>
                                <td class="text-center font-monospace fw-bold text-success">@gna.NinosCreenJesus.ToString("N0")</td>
                                <td class="text-center font-monospace fw-bold text-info">@gna.NinosOranComparten.ToString("N0")</td>
                                <td class="text-center font-monospace fw-bold text-warning">@gna.NinosGraduados.ToString("N0")</td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarGNA(@gna.IdGNA)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
