@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error en el Sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center">
    <div class="card shadow border-0 rounded-4 p-5 mx-auto" style="max-width: 650px;">
        <div class="mb-3">
            <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
        </div>
        <h2 class="text-dark font-bold mb-2">Error al procesar la solicitud</h2>
        <p class="text-muted mb-4">
            @(Model != null && Model.Exception != null ? Model.Exception.Message : "Ha ocurrido un inconveniente al procesar la información solicitada.")
        </p>
        
        @if (Model != null && Model.Exception != null)
        {
            <div class="alert alert-light border text-start small text-danger font-monospace mb-4 p-3 rounded-3" style="word-break: break-all; max-height: 250px; overflow-y: auto;">
                <strong>Detalles técnicos:</strong><br />
                @Model.Exception.GetType().FullName: @Model.Exception.Message
                @if (Model.Exception.InnerException != null)
                {
                    <br /><br /><strong>Causa interna:</strong><br />
                    @Model.Exception.InnerException.Message
                }
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="@Url.Action("Index", "Iglesia")" class="btn btn-primary px-4 py-2 font-semibold">
                <i class="bi bi-arrow-left me-1"></i> Volver a Iglesias
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4 py-2 font-semibold">
                Ir al Inicio
            </a>
        </div>
    </div>
</div>
