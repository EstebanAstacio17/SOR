    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @if (Session["usuario"] != null && ViewContext.RouteData.Values["controller"]?.ToString() != "Acceso")
    {
        var uActualSesion = (SOR.Models.Usuario)Session["usuario"];
        bool recienLogueado = false;
        if (Session["RecienLogueado"] != null)
        {
            recienLogueado = (bool)Session["RecienLogueado"];
            Session["RecienLogueado"] = null;
        }
        <script>
            (function () {
                var userId = '@uActualSesion.IdUsuario';
                var keyActiveTab = 'SOR_ACTIVE_TAB_USER_' + userId;
                var isFreshLogin = '@(recienLogueado ? "true" : "false")' === 'true';

                var myTabId = sessionStorage.getItem('SOR_MY_TAB_ID');
                if (!myTabId) {
                    myTabId = 'tab_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
                    sessionStorage.setItem('SOR_MY_TAB_ID', myTabId);
                }

                var modalInstance = null;

                function initModal() {
                    var el = document.getElementById('modalPestanaDuplicada');
                    if (el && !modalInstance) {
                        modalInstance = new bootstrap.Modal(el, {
                            backdrop: 'static',
                            keyboard: false
                        });
                    }
                }

                function mostrarBloqueo() {
                    initModal();
                    if (modalInstance) {
                        modalInstance.show();
                    }
                }

                function ocultarBloqueo() {
                    initModal();
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                }

                function reclamarControl() {
                    localStorage.setItem(keyActiveTab, JSON.stringify({
                        tabId: myTabId,
                        time: Date.now()
                    }));
                    ocultarBloqueo();
                }

                function verificarEstadoPestana() {
                    if (sessionStorage.getItem('SOR_TAB_LOGGED_OUT') === 'true') {
                        window.location.href = '@Url.Action("Login", "Acceso")';
                        return;
                    }

                    if (isFreshLogin) {
                        reclamarControl();
                        return;
                    }

                    var rawActive = localStorage.getItem(keyActiveTab);
                    if (!rawActive) {
                        reclamarControl();
                    } else {
                        try {
                            var activeData = JSON.parse(rawActive);
                            if (activeData.tabId === myTabId) {
                                ocultarBloqueo();
                            } else {
                                mostrarBloqueo();
                            }
                        } catch (err) {
                            reclamarControl();
                        }
                    }
                }

                window.addEventListener('storage', function (e) {
                    if (e.key === keyActiveTab && e.newValue) {
                        try {
                            var data = JSON.parse(e.newValue);
                            if (data.tabId !== myTabId) {
                                mostrarBloqueo();
                            }
                        } catch (err) {}
                    }
                });

                $(document).ready(function () {
                    $('#btnTomarControlPestana').on('click', function () {
                        reclamarControl();
                    });
                    $('#btnCerrarSesionPestana').on('click', function () {
                        sessionStorage.setItem('SOR_TAB_LOGGED_OUT', 'true');
                        window.location.href = '@Url.Action("Login", "Acceso")';
                    });
                    verificarEstadoPestana();
                });

                window.addEventListener('beforeunload', function () {
                    var rawActive = localStorage.getItem(keyActiveTab);
                    if (rawActive) {
                        try {
                            var activeData = JSON.parse(rawActive);
                            if (activeData.tabId === myTabId) {
                                localStorage.removeItem(keyActiveTab);
                            }
                        } catch (err) {}
                    }
                });
            })();
        </script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>
