                    <span class="fw-bold tracking-tight text-dark">SOR <span class="text-secondary fw-normal fs-6">| OCC Rep Dom</span></span>
                </a>
            }
            else
            {
                <a class="navbar-brand font-bold d-flex align-items-center" href="@Url.Action("Landing", "Home")">
