<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <!-- Desactivar modo depuración en compilación de producción -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    
    <!-- Asegurar que las cookies de sesión requieran SSL en producción -->
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" xdt:Transform="Replace" />
    
    <!-- Manejo seguro de errores sin exponer trazas de servidor -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Home/Landing" xdt:Transform="Replace">
      <error statusCode="404" redirect="~/Home/Landing" />
      <error statusCode="500" redirect="~/Home/Landing" />
    </customErrors>
  </system.web>
</configuration>
