<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="ConexionSOR" 
         connectionString="Server=tcp:svrsor.database.windows.net,1433;Initial Catalog=DB_SOR;Persist Security Info=False;User ID=CloudSA94a05d65;Password=OCC_Sor2026!*;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;ConnectRetryCount=3;ConnectRetryInterval=10;Application Name=SOR_Azure;" 
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
  </connectionStrings>

  <system.web>
    <!-- Desactivar modo depuración en compilación de producción -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    
    <!-- Asegurar que las cookies de sesión requieran SSL en producción -->
    <httpCookies httpOnlyCookies="true" requireSSL="true" sameSite="Lax" xdt:Transform="Replace" />
    
    <!-- Manejo seguro de errores sin exponer trazas de servidor -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Shared/Error" xdt:Transform="Replace">
      <error statusCode="404" redirect="~/Home/NotFound" />
    </customErrors>
  </system.web>
</configuration>
