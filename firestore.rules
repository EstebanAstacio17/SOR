rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Regla base: Solo usuarios autenticados pueden leer y escribir documentos
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Colección pública (por ejemplo: formulario de voluntariado o contacto público)
    match /solicitudes_voluntarios/{idSolicitud} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
